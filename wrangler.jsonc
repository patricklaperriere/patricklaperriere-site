{
  // Cloudflare config for deploying the static Astro build as a
  // Workers Static Assets project (`npx wrangler deploy`).
  "name": "patricklaperriere-site",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    // Serve /foo from /foo/index.html WITHOUT a trailing slash, to match the
    // site's canonical URLs (astro trailingSlash: 'never').
    "html_handling": "drop-trailing-slash",
    // Serve the built 404 page for unmatched routes.
    "not_found_handling": "404-page"
  }
}
