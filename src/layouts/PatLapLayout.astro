---
// « La technologie pour tous », programme de Patrick Laperrière.
//
// Décision de marque (Patrick, 7 nov.) : un seul nom partout, « Patrick
// Laperrière. ». Le programme n'a plus de marque à part : ses pages prennent
// l'en-tête, le pied de page et le design du site (Layout.astro, thème
// refonte), avec une barre du programme (son nom, ses sections, l'inscription).
// Les adresses ne changent pas. Le nom du fichier est gardé pour ne rien
// casser dans les pages qui l'importent.
import Layout from './Layout.astro';
import type { Locale } from '../i18n/routes';
import { BROUILLON, PATLAP_ROUTES, textes } from '../data/patlap';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  alternates: { fr: string; en: string };
  path: string;
  /** Pages de parcours (jours, Soirée) : jamais indexées, jamais dans le nav. */
  cachee?: boolean;
}

const { title, description, locale, alternates, path, cachee = false } = Astro.props;
const tx = textes(locale);
const r = PATLAP_ROUTES[locale];
---

<Layout title={title} description={description} locale={locale} alternates={alternates} path={path} noindex={BROUILLON || cachee}>
  <div class="patlap">
    <div class="pl-barre">
      <div class="pl-cadre pl-barre-in">
        <a class="pl-programme" href={r.page}>
          <span class="pl-programme-nom">{tx.titrePage}</span>
          <span class="pl-programme-sous">{tx.nav.sousTitre}</span>
        </a>
        {!cachee && (
          <nav aria-label={locale === 'fr' ? 'Le programme' : 'The program'} class="pl-liens">
            <a href="#jours">{tx.nav.jours}</a>
            <a href="#soiree">{tx.nav.soiree}</a>
            <a href="#pat">{tx.nav.quiPat}</a>
          </nav>
        )}
        {!cachee && <a class="pl-bouton pl-bouton-petit" href="#inscription">{tx.nav.inscription}</a>}
      </div>
    </div>
    <div id="contenu">
      <slot />
    </div>
    <div class="pl-cadre pl-notes">
      <p class="pl-marques">{tx.pied.marques}</p>
    </div>
  </div>
</Layout>

<style is:global>
  /* Le programme dans le design du site : graphite chaud, sable, une seule
     police (Atkinson Hyperlegible Next), le prune de l'ancien Pat Lap comme
     accent chaud. Les composants du programme lisent ces variables. */
  .patlap {
    --pl-vert: #A33E9A;        /* prune (accent chaud) : boutons, numéros */
    --pl-vert-fonce: #8E3386;
    --pl-nuit: #100E11;        /* bloc Soirée */
    --pl-sable: #221E24;       /* surfaces (cartes, panneaux) */
    --pl-texte: #F4EFE6;
    --pl-gris: #BDB3B6;
    --pl-titres: var(--font-sans);
    color: var(--pl-texte);
    font-size: 1.0625rem;
    line-height: 1.55;
  }
  .patlap img { max-width: 100%; height: auto; display: block; }
  .patlap a:not(.pl-bouton) { color: var(--mauve-clair, #E7A3DE); }
  .pl-cadre { width: 100%; max-width: 72rem; margin: 0 auto; padding: 0 1rem; }
  @media (min-width: 768px) { .pl-cadre { padding: 0 2rem; } }

  /* La barre du programme, sous l'en-tête du site. */
  .pl-barre { border-bottom: 1px solid var(--filet, #342E36); background: var(--salle, #100E11); }
  .pl-barre-in { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1.5rem; min-height: 4rem; padding-block: .5rem; }
  .pl-programme { display: flex; flex-direction: column; line-height: 1.15; text-decoration: none !important; margin-right: auto; }
  .pl-programme-nom { font-weight: 800; font-size: 1.25rem; letter-spacing: -.01em; color: var(--pl-texte); }
  .pl-programme-sous { font-size: .875rem; color: var(--pl-gris); }
  .pl-liens { display: none; gap: 1.5rem; }
  .pl-liens a { text-decoration: none !important; color: var(--pl-texte) !important; font-weight: 700; font-size: .95rem; }
  .pl-liens a:hover { color: var(--mauve-clair, #E7A3DE) !important; }
  @media (min-width: 900px) { .pl-liens { display: flex; } }

  .pl-bouton { display: inline-flex; align-items: center; justify-content: center; min-height: 3rem; padding: .75rem 1.5rem; border: 0; border-radius: var(--r, 2px); background: var(--pl-vert); color: #fff !important; font: inherit; font-weight: 800; text-decoration: none !important; cursor: pointer; }
  .pl-bouton:hover { background: var(--pl-vert-fonce); }
  .pl-bouton-petit { min-height: 2.75rem; padding: .5rem 1rem; font-size: .95rem; }
  .pl-bouton[aria-disabled="true"] { opacity: .75; cursor: not-allowed; }

  /* Un texte absent se voit comme tel, à l'écran : jamais confondu avec le vrai. */
  .pl-tbc { display: inline-block; background: #FFF4CC; color: #6B4E00; border: 1px dashed #B88A00; border-radius: 2px; padding: .1rem .4rem; font-weight: 600; font-size: .95em; }

  .pl-notes { padding-block: 2rem 1rem; }
  .pl-marques { margin: 0; font-size: .875rem; color: var(--pl-gris); max-width: 70ch; }

  /* Les composants du programme gardaient des cartes blanches arrondies avec
     ombre : surfaces sombres, rayon 2 px, aucune ombre. */
  .patlap :is(.pl-form, .pl-trois li, .pl-panneau, .pl-photo, .pl-photo-cadre, .pl-video) {
    background: var(--pl-sable) !important;
    border-radius: 2px !important;
    box-shadow: none !important;
    border: 1px solid var(--filet, #342E36);
  }
  .patlap .pl-champ input { background: #100E11 !important; color: var(--pl-texte) !important; border: 1px solid #5A5058 !important; border-radius: 2px !important; }
  .patlap .pl-badge { border-radius: 2px !important; }
  .patlap .pl-soiree { background: var(--pl-nuit); }

  /* Plus de cascade d'apparition (au plus un effet par page, règles de
     design) : tout est visible tout de suite. L'empilement des 5 jours au
     défilement reste (c'est la mise en page, pas une apparition). */
  html.pl-anim [data-pl-revele] { opacity: 1 !important; transform: none !important; transition: none !important; }
  html.pl-anim .pl-trois [data-pl-revele]::after { display: none !important; }
</style>
