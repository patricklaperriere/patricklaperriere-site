---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import LofiPlayer from '../components/LofiPlayer.astro';
import { useTranslations, otherLocale } from '../i18n';
import type { Locale } from '../i18n/routes';
import { PHOTO, hasPhoto } from '../lib/photo';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  alternates: { fr: string; en: string };
  path?: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
  schema?: object | null;
  noindex?: boolean;
  /** Visual theme. `report` ("le rapport d'inspection") is the new direction,
   *  applied to the home page first (styles in src/styles/report.css,
   *  imported by the page itself). */
  theme?: 'report';
}

const {
  title,
  description,
  locale,
  alternates,
  path,
  ogImage,
  ogType,
  schema = null,
  noindex = false,
  theme,
} = Astro.props;

const tr = useTranslations(locale);
const htmlLang = tr.htmlLang;
const altPath = alternates[otherLocale(locale)];

// Monogram favicon, used only when no portrait is available.
const favicon =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' fill='%230a0a0c'/%3E%3Ctext x='32' y='43' text-anchor='middle' font-family='Georgia,serif' font-size='32' font-weight='700' fill='%23d4543a' letter-spacing='-2'%3EPL%3C/text%3E%3C/svg%3E";
---

<!doctype html>
<html lang={htmlLang} class:list={[theme && `theme-${theme}`]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0a0a0c" />

    {/* Marks the document as scripted BEFORE first paint. Scroll-reveal start
        states are scoped to `.js`, so without this one line the page would
        paint every revealed element, then hide it, then animate it back in.
        Inline and synchronous on purpose: it must win the race against CSS. */}
    <script is:inline>document.documentElement.classList.add('js');</script>

    {hasPhoto ? (
      <>
        {/* Photo favicon. Deliberately NO svg <link> alongside it: browsers
            prefer an SVG icon over a PNG whenever both are offered, so keeping
            the monogram here would silently win and the photo would never
            appear. icon-512 is generated but not linked — without a web app
            manifest it has no consumer and would only risk a 130 kB fetch. */}
        <link rel="icon" type="image/png" sizes="32x32" href={PHOTO.icon32} />
        <link rel="apple-touch-icon" sizes="180x180" href={PHOTO.icon180} />
      </>
    ) : (
      <link rel="icon" type="image/svg+xml" href={favicon} />
    )}

    {/* Preload the faces the first screen paints with. */}
    {theme === 'report' ? (
      <>
        <link rel="preload" href="/fonts/big-shoulders-display.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/red-hat-text.woff2" as="font" type="font/woff2" crossorigin />
      </>
    ) : (
      <link rel="preload" href="/fonts/bricolage-grotesque.woff2" as="font" type="font/woff2" crossorigin />
    )}

    <SEO
      title={title}
      description={description}
      locale={locale}
      alternates={alternates}
      path={path}
      ogImage={ogImage}
      ogType={ogType}
      schema={schema}
      noindex={noindex}
    />
  </head>
  <body>
    <a href="#main" class="skip-link">{tr.skipToContent}</a>
    <div class="grain" aria-hidden="true"></div>
    <Nav locale={locale} alt={altPath} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <LofiPlayer locale={locale} />

    <script>
      import '../scripts/ux.ts';
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        background: var(--vermilion);
        color: #fff;
        padding: 0.85rem 1.35rem;
        font-family: var(--font-mono);
        font-size: var(--fs-meta);
        letter-spacing: 0.04em;
        font-weight: 500;
      }
      .skip-link:focus {
        left: 0;
      }
    </style>
  </body>
</html>
