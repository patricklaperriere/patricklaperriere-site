---
// Phase-1 shell for the new home direction, at /_proto/scan (dev only).
// It carries the provisional tokens, fonts and grain; the page itself is
// src/components/home/HomePage.astro, which the real Layout will host next.
import HomePage from '../../components/home/HomePage.astro';
import { routes } from '../../i18n/routes';
import { SITE } from '../../config';

const nav = [
  { href: routes.work.fr, label: 'Réalisations' },
  { href: routes.services.fr, label: 'Services' },
  { href: routes.about.fr, label: 'À propos' },
  { href: routes.blog.fr, label: 'Blogue' },
  { href: routes.contact.fr, label: 'Contact' },
];
---

<!doctype html>
<html lang="fr-CA">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Prototype | Patrick Laperrière</title>
  <meta name="description" content="Patrick Laperrière, développeur web au Québec : des sites rapides, des outils sur mesure et Habita, le logiciel de rapports d’inspection en bâtiment." />
  <link rel="icon" type="image/png" sizes="32x32" href="/photo/icon-32.png" />
  <link rel="preload" href="/fonts/young-serif.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/atkinson-next.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
  <a class="skip" href="#contenu">Aller au contenu</a>
  <header class="top">
    <a class="brand" href="/">Patrick Laperrière</a>
    <nav aria-label="Navigation principale">
      <ul class="nav-wide">
        {nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a href={routes.home.en} lang="en" hreflang="en">English</a></li>
      </ul>
      <details class="menu">
        <summary>Menu</summary>
        <ul>
          {nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          <li><a href={routes.home.en} lang="en" hreflang="en">English</a></li>
        </ul>
      </details>
    </nav>
  </header>
  <main id="contenu">
    <HomePage locale="fr" />
  </main>
  <footer class="foot">
    <p>Patrick Laperrière, {SITE.company.name}</p>
  </footer>
  <script>
    import '../../scripts/home-motion.ts';
  </script>
</body>
</html>

<style is:global>
  @font-face { font-family: 'Young Serif'; src: url('/fonts/young-serif.woff2') format('woff2'); font-display: swap; }
  @font-face { font-family: 'Atkinson Hyperlegible Next'; src: url('/fonts/atkinson-next.woff2') format('woff2'); font-weight: 200 800; font-display: swap; }
  @font-face { font-family: 'Atkinson Hyperlegible Next'; src: url('/fonts/atkinson-next-italic.woff2') format('woff2'); font-weight: 200 800; font-style: italic; font-display: swap; }
  @font-face { font-family: 'Architects Daughter'; src: url('/fonts/architects-daughter.woff2') format('woff2'); font-display: swap; }
  :root, [data-surface='ink'] {
    --bg: #121110;
    --fg: #ece6da;
    --fg-dim: #b7b0a3;
    --fg-mute: #8d877c;
    --line: rgba(236, 230, 218, 0.14);
    --line-strong: rgba(236, 230, 218, 0.3);
    --pencil: #8fb0ff;
    --note: #c9a8ff;
    --font-display: 'Young Serif', Georgia, serif;
    --font-sans: 'Atkinson Hyperlegible Next', system-ui, sans-serif;
    --font-hand: 'Architects Daughter', 'Comic Sans MS', cursive;
    --gutter: clamp(1.1rem, 4.5vw, 3.5rem);
    --w-wide: 1440px;
  }
  [data-surface='paper'] {
    --bg: #e9e3d6;
    --fg: #1b1915;
    --fg-dim: #4b463e;
    --fg-mute: #6b655a;
    --line: rgba(27, 25, 21, 0.16);
    --line-strong: rgba(27, 25, 21, 0.32);
    --pencil: #2f5bd6;
    --note: #6534c4;
    background: var(--bg);
    color: var(--fg);
  }
  * { box-sizing: border-box; }
  html { background: var(--bg); }
  html.lenis, html.lenis body { height: auto; }
  .lenis.lenis-smooth { scroll-behavior: auto !important; }
  body { margin: 0; background: var(--bg); color: var(--fg); font: 400 1.0625rem/1.65 var(--font-sans); overflow-x: clip; }
  /* Film grain over everything: one static tile, no live filter. */
  body::after { content: ''; position: fixed; inset: 0; z-index: 60; pointer-events: none; background: url('/textures/grain.png'); opacity: 0.9; }
  img { max-width: 100%; }
  a { color: inherit; }
  a:focus-visible, summary:focus-visible, .btn:focus-visible { outline: 2px solid var(--note); outline-offset: 4px; }
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 1rem; top: 1rem; background: var(--fg); color: var(--bg); padding: 0.5rem 1rem; z-index: 80; }
  .btn { display: inline-block; background: var(--fg); color: var(--bg); padding: 0.9rem 1.4rem; font-weight: 600; text-decoration: none; border: 1px solid var(--fg); }
  .btn:hover { background: transparent; color: var(--fg); }
  .top { position: absolute; inset: 0 0 auto 0; z-index: 30; display: flex; justify-content: space-between; align-items: center; padding: 1.1rem var(--gutter); }
  .brand { font-family: var(--font-display); font-size: 1.2rem; text-decoration: none; }
  .nav-wide { display: none; list-style: none; margin: 0; padding: 0; gap: 1.75rem; }
  .nav-wide a { text-decoration: none; color: var(--fg-dim); }
  .nav-wide a:hover { color: var(--fg); text-decoration: underline; text-decoration-color: var(--note); }
  .menu { position: relative; }
  .menu summary { cursor: pointer; list-style: none; padding: 0.45rem 0.9rem; border: 1px solid var(--line-strong); }
  .menu summary::-webkit-details-marker { display: none; }
  .menu ul { position: absolute; right: 0; top: calc(100% + 0.4rem); margin: 0; padding: 0.5rem 0; list-style: none; min-width: 12rem; background: var(--bg); border: 1px solid var(--line-strong); }
  .menu li a { display: block; padding: 0.55rem 1.1rem; text-decoration: none; }
  @media (min-width: 900px) { .nav-wide { display: flex; } .menu { display: none; } }
  .foot { padding: 2rem var(--gutter) 3rem; color: var(--fg-mute); border-top: 1px solid var(--line); }
</style>
