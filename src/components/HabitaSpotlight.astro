---
// Home-page spotlight for Habita — the SaaS I build and operate.
// It sits between the tech ticker and the work index because it is the
// positioning argument, not a portfolio entry. Habita deliberately does NOT
// also appear as a tile in the work grid below: that would be the same link
// twice on one screen and would weaken both.
//
// Treatment: a sunken, near-black band with the product running full width
// inside a chrome frame, so it reads as software rather than a screenshot.
import { useTranslations } from '../i18n';
import type { Locale } from '../i18n/routes';
import { workBase } from '../i18n/routes';
import { projects } from '../data/projets';
import { HABITA_LOOP } from '../lib/habitaLoop';
import ProductFrame from './ProductFrame.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = useTranslations(locale);
const s = tr.habitaSpotlight;

// Pull the live URL from the project data so there is one source of truth.
const habita = projects.find((p) => p.slug === 'habita')!;
const caseHref = `${workBase[locale]}/${habita.slug}`;
const host = new URL(habita.url).host;
---

<section class="section habita" id="habita" data-surface="ink">
  <div class="container-wide">
    <header class="habita__head">
      <p class="label label-rule">{s.kicker}</p>
      <h2 class="habita__title reveal">{s.title}</h2>
    </header>

    <div class="reveal-clip">
      <ProductFrame
        host={host}
        liveLabel={locale === 'fr' ? 'En production' : 'In production'}
        poster={HABITA_LOOP.poster}
        webm={HABITA_LOOP.webm}
        mp4={HABITA_LOOP.mp4}
        width={HABITA_LOOP.width}
        height={HABITA_LOOP.height}
        posterAlt={s.posterAlt}
        playLabel={s.videoPlay}
        pauseLabel={s.videoPause}
        fallbackSrc={`/work/${habita.slug}.webp`}
        fallbackAlt={s.shotAlt}
        fallbackHref={caseHref}
        fit={habita.fit ?? 'cover'}
      />
    </div>

    <div class="habita__body">
      <div class="habita__copy">
        <p class="habita__lead reveal">{s.lead}</p>
        <div class="prose reveal" data-delay="80ms">
          <p>{s.body}</p>
        </div>
        <div class="habita__ctas reveal" data-delay="140ms">
          <a href={caseHref} class="btn btn-primary">
            {s.ctaCase}
            <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
          <a href={habita.url} class="btn btn-ghost" target="_blank" rel="noopener">
            {s.ctaLive}
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="habita__caps">
        <p class="label habita__caps-label">{s.pointsLabel}</p>
        <ul class="habita__points">
          {s.points.map((p, i) => (
            <li class="habita__point reveal" data-delay={`${i * 60}ms`}>
              <span class="index-num habita__point-num">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="habita__point-title">{p.t}</h3>
                <p class="habita__point-text">{p.d}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  /* Sunken band: a shade below the page, which is what gives the product its
     cinematic separation without any glow or gradient. */
  .habita {
    --bg: var(--ink-sunken);
    border-block: 1px solid var(--line-soft);
  }

  .habita__head {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .habita__title {
    font-size: clamp(1.9rem, 4.6vw, 3.4rem);
    font-weight: var(--fw-thin);
    letter-spacing: -0.032em;
    line-height: 1.05;
    max-width: 24ch;
    margin: 1.25rem 0 0;
  }

  .habita__body {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .habita__lead {
    font-size: clamp(1.15rem, 1.9vw, 1.4rem);
    font-weight: var(--fw-light);
    line-height: 1.45;
    letter-spacing: -0.015em;
    color: var(--fg);
    margin: 0 0 1.5rem;
  }
  .habita__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .habita__caps-label {
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 0;
  }
  .habita__points {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .habita__point {
    display: flex;
    gap: 0.9rem;
    padding: 1.15rem clamp(1rem, 2vw, 1.5rem) 1.15rem 0;
    border-bottom: 1px solid var(--line-soft);
  }
  .habita__point:nth-child(odd) { border-right: 1px solid var(--line-soft); }
  .habita__point:nth-child(even) {
    padding-left: clamp(1rem, 2vw, 1.5rem);
    padding-right: 0;
  }
  .habita__point-num { flex: none; line-height: 1.5; }
  .habita__point-title {
    font-size: 1rem;
    font-weight: var(--fw-medium);
    letter-spacing: -0.01em;
    margin: 0 0 0.3rem;
  }
  .habita__point-text {
    color: var(--fg-dim);
    font-size: var(--fs-meta);
    line-height: 1.55;
    margin: 0;
  }

  @media (max-width: 1000px) {
    .habita__body { grid-template-columns: 1fr; }
  }
  @media (max-width: 620px) {
    .habita__points { grid-template-columns: 1fr; }
    .habita__point,
    .habita__point:nth-child(odd),
    .habita__point:nth-child(even) {
      border-right: 0;
      padding-inline: 0;
    }
  }
</style>
