---
// Real Google reviews, verbatim. Nothing here is written or extended by me —
// see the note in data/temoignages.ts.
//
// Treatment: the longest review is pulled out as an oversized serif quote and
// the remainder sit underneath as a quiet pair, so the section reads as an
// editorial pull-quote instead of three identical review cards.
import { useTranslations } from '../i18n';
import type { Locale } from '../i18n/routes';
import { workBase } from '../i18n/routes';
import { temoignages, reviewAggregate } from '../data/temoignages';
import { sortedProjects, loc } from '../data/projets';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = useTranslations(locale);

// Pick the lead by length rather than by index, so reordering the data file
// cannot accidentally promote the one-line review into the hero slot.
const ordered = [...temoignages].sort((a, b) => b.text.length - a.text.length);
const [lead, ...rest] = ordered;

const projects = await sortedProjects();
const projectOf = (slug?: string) => {
  if (!slug) return null;
  const p = projects.find((x) => x.slug === slug);
  return p ? { name: loc(p.title, locale), href: `${workBase[locale]}/${p.slug}` } : null;
};
const leadProject = projectOf(lead.project);
---

<section class="section tm" id="testimonials" data-surface="paper">
  <div class="container-wide">
    <header class="tm__head">
      <div>
        <p class="label label-rule">{tr.testimonials.kicker}</p>
        <h2 class="section-head__title tm__title">{tr.testimonials.title}</h2>
      </div>

      <p class="tm__rating">
        <span class="tm__stars" aria-hidden="true">★★★★★</span>
        <span class="tm__rating-text">
          {reviewAggregate.ratingValue} · {tr.testimonials.rating}
        </span>
      </p>
    </header>

    <figure class="tm__lead reveal">
      <blockquote class="tm__quote">{lead.text}</blockquote>
      <figcaption class="tm__by">
        <span class="tm__author">{lead.author}</span>
        {leadProject && (
          <>
            <span class="tm__sep" aria-hidden="true">·</span>
            <a href={leadProject.href} class="link tm__project">{leadProject.name}</a>
          </>
        )}
      </figcaption>
    </figure>

    <ul class="tm__rest">
      {rest.map((t, i) => {
        const proj = projectOf(t.project);
        return (
          <li class="tm__item reveal" data-delay={`${i * 80}ms`}>
            <figure>
              <blockquote class="tm__item-quote">{t.text}</blockquote>
              <figcaption class="tm__by">
                <span class="tm__author">{t.author}</span>
                {proj && (
                  <>
                    <span class="tm__sep" aria-hidden="true">·</span>
                    <a href={proj.href} class="link tm__project">{proj.name}</a>
                  </>
                )}
              </figcaption>
            </figure>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .tm__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    flex-wrap: wrap;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .tm__title { margin-top: 1rem; }

  .tm__rating {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    color: var(--fg-dim);
  }
  .tm__stars {
    color: var(--vermilion-deep);
    letter-spacing: 0.1em;
    font-size: 0.8rem;
  }

  /* ---- Lead quote --------------------------------------------------------- */
  .tm__lead {
    margin: 0;
    padding-bottom: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--line);
  }
  .tm__quote {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 4vw, 3rem);
    font-weight: 400;
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin: 0 0 1.5rem;
    max-width: 24ch;
    text-wrap: balance;
  }
  /* Typographic quote marks, drawn rather than typed, so the review text in
     the data file stays verbatim and unpunctuated by us. */
  .tm__quote::before { content: "“"; }
  .tm__quote::after { content: "”"; }

  .tm__by {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    color: var(--fg-dim);
  }
  .tm__author { color: var(--fg); }
  .tm__sep { opacity: 0.5; }
  .tm__project { font-family: inherit; font-size: inherit; color: var(--accent-fg); }

  /* ---- Secondary quotes --------------------------------------------------- */
  .tm__rest {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
  }
  .tm__item {
    padding: clamp(1.5rem, 3vw, 2.25rem) clamp(1.25rem, 3vw, 2.5rem)
             clamp(1.5rem, 3vw, 2.25rem) 0;
    border-right: 1px solid var(--line-soft);
  }
  .tm__item:last-child {
    border-right: 0;
    padding-left: clamp(1.25rem, 3vw, 2.5rem);
    padding-right: 0;
  }
  .tm__item figure { margin: 0; }
  .tm__item-quote {
    font-size: var(--fs-md);
    font-weight: var(--fw-light);
    line-height: 1.45;
    letter-spacing: -0.015em;
    color: var(--fg);
    margin: 0 0 1rem;
  }
  .tm__item-quote::before { content: "“"; }
  .tm__item-quote::after { content: "”"; }

  @media (max-width: 720px) {
    .tm__rest { grid-template-columns: 1fr; }
    .tm__item,
    .tm__item:last-child {
      border-right: 0;
      border-bottom: 1px solid var(--line-soft);
      padding-inline: 0;
    }
    .tm__item:last-child { border-bottom: 0; }
  }
</style>
