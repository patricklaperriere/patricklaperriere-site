---
import { useTranslations } from '../i18n';
import type { Locale } from '../i18n/routes';
import { temoignages, reviewAggregate } from '../data/temoignages';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = useTranslations(locale);
const stars = (n: number) => '★★★★★'.slice(0, n);
---

<section class="section testimonials" id="testimonials">
  <div class="container-pl">
    <header class="section-head reveal">
      <p class="kicker">{tr.testimonials.kicker}</p>
      <h2 class="section-head__title">{tr.testimonials.title}</h2>
      <p class="testimonials__rating">
        <span class="testimonials__stars" aria-hidden="true">★★★★★</span>
        <span>{reviewAggregate.ratingValue} · {tr.testimonials.rating}</span>
      </p>
    </header>

    <ul class="testimonials__grid">
      {temoignages.map((t, i) => (
        <li class="card testimonial reveal" data-delay={`${i * 80}ms`}>
          <span class="testimonial__stars" aria-label={`${t.rating} / 5`}>{stars(t.rating)}</span>
          <blockquote class="testimonial__quote">{t.text}</blockquote>
          <footer class="testimonial__meta">
            <span class="testimonial__author">{t.author}</span>
            <span class="testimonial__source">{tr.testimonials.source}</span>
          </footer>
        </li>
      ))}
    </ul>
  </div>

  <style>
    .testimonials__rating {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      color: var(--color-fog);
      font-size: 0.95rem;
      margin-top: 0.6rem;
    }
    .testimonials__stars { color: var(--color-gold); letter-spacing: 2px; }
    .testimonials__grid {
      list-style: none;
      padding: 0;
      margin: 2.5rem 0 0;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
    .testimonial {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      padding: 1.9rem;
    }
    .testimonial__stars { color: var(--color-gold); letter-spacing: 2px; font-size: 1rem; }
    .testimonial__quote {
      margin: 0;
      color: var(--color-bone);
      font-size: 1.02rem;
      line-height: 1.6;
      flex: 1;
    }
    .testimonial__meta {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      border-top: 1px solid var(--line);
      padding-top: 1rem;
    }
    .testimonial__author { font-weight: 500; color: var(--color-bone); }
    .testimonial__source {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--color-gold);
    }
    @media (max-width: 900px) {
      .testimonials__grid { grid-template-columns: 1fr; }
    }
  </style>
</section>
