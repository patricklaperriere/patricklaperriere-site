---
// Technology index. It used to be a scrolling ticker, which needed the list
// twice in the markup for a seamless loop: crawlers and text-only readers saw
// every technology two times, mixed with outcomes ("SEO", "Performance").
// It is now one static, wrapped list of tools, read from SITE.stack so the
// home page, the about page and the Person schema can never disagree.
import { useTranslations } from '../i18n';
import type { Locale } from '../i18n/routes';
import { SITE } from '../config';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = useTranslations(locale);
---

<section class="ticker" aria-label={tr.marquee.label}>
  <ul class="ticker__set container-wide">
    {SITE.stack.map((it) => <li class="ticker__item">{it}</li>)}
  </ul>
</section>

<style>
  .ticker {
    border-block: 1px solid var(--line);
    padding-block: 1.1rem;
  }
  .ticker__set {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem clamp(0.75rem, 2vw, 1.5rem);
    list-style: none;
    margin-block: 0;
  }
  .ticker__item {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: var(--fg-mute);
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
  }
  /* Separator drawn as a dot rather than a glyph, so it never reads as a
     bullet to a screen reader and never inherits the accent colour. */
  .ticker__item + .ticker__item::before {
    content: "";
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.45;
    margin-right: clamp(0.75rem, 2vw, 1.5rem);
  }
</style>
