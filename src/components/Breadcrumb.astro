---
interface Crumb {
  name: string;
  url: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav class="breadcrumb container-wide" aria-label="Breadcrumb">
  <ol>
    {items.map((it, i) => (
      <li>
        {i < items.length - 1 ? (
          <a href={it.url}>{it.name}</a>
        ) : (
          <span aria-current="page">{it.name}</span>
        )}
        {i < items.length - 1 && <span class="breadcrumb__sep" aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>

  <style>
    /* Mono trail on a hairline. Sits above the page masthead and stays quiet:
       it is orientation, not navigation the eye should land on first. */
    .breadcrumb {
      padding-top: clamp(1rem, 2.5vw, 1.5rem);
    }
    .breadcrumb ol {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      margin: 0;
      padding: 0;
      font-family: var(--font-mono);
      font-size: var(--fs-micro);
      letter-spacing: 0.08em;
      color: var(--fg-mute);
    }
    .breadcrumb li {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .breadcrumb a {
      display: inline-flex;
      align-items: center;
      min-height: 28px;
      color: var(--fg-mute);
      transition: color var(--t-fast) var(--ease);
    }
    .breadcrumb a:hover { color: var(--fg); }
    .breadcrumb [aria-current="page"] { color: var(--fg); }
    .breadcrumb__sep { opacity: 0.4; }
  </style>
</nav>
