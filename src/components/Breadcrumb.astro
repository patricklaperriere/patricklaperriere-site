---
interface Crumb {
  name: string;
  url: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav class="breadcrumb container-pl" aria-label="Breadcrumb">
  <ol>
    {items.map((it, i) => (
      <li>
        {i < items.length - 1 ? (
          <a href={it.url}>{it.name}</a>
        ) : (
          <span aria-current="page">{it.name}</span>
        )}
        {i < items.length - 1 && <span class="breadcrumb__sep" aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>

  <style>
    .breadcrumb { padding-top: 1.5rem; }
    .breadcrumb ol {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      padding: 0;
      margin: 0;
      font-family: var(--font-mono);
      font-size: 0.78rem;
      color: var(--color-fog);
    }
    .breadcrumb li { display: inline-flex; align-items: center; gap: 0.5rem; }
    .breadcrumb a { color: var(--color-fog); transition: color 0.2s; }
    .breadcrumb a:hover { color: var(--color-gold-bright); }
    .breadcrumb [aria-current='page'] { color: var(--color-bone); }
    .breadcrumb__sep { opacity: 0.4; }
  </style>
</nav>
