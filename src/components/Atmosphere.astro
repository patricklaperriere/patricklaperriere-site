---
// Fixed ambient background: aurora blobs + grain + vignette + gold spotlight.
// Pure CSS animation; the spotlight position is updated by the UX script.
// pointer-events:none and low z-index keep it purely decorative.
---

<div class="atmosphere" aria-hidden="true">
  <div class="photo"></div>
  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>
  <div class="blob blob-3"></div>
  <div class="grain"></div>
  <div class="spotlight" id="spotlight"></div>
  <div class="vignette"></div>
</div>
