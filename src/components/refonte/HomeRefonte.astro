---
// La home WOW (refonte/2026-11-wow, 7 nov. 2026) : une salle de projection.
// Règle permanente : NEXUS-Bridge/REGLES-DESIGN-SANS-IA.md. Plan de design
// dans le rendu SITEPERSO-2026-11-07-HOME-WOW.
//
// 1. Hero : Patrick, détouré, éclairé comme par l'écran ; le titre est un
//    bloc visuel qui chevauche la photo. Une entrée courte au chargement :
//    le titre est balayé comme par un projecteur.
// 2. La scène 3D : ses vrais projets en profondeur (Scene.astro, scene.ts).
// 3. BeauRegard, Avant / Après (glisseur et balayage lié au défilement).
// 4. Ce que je fais : quatre services, en quinconce.
// 5. Un site rapide, ça se vérifie (mesures lues dans site-metrics.json).
// 6. Pat Lap (interrupteur, local seulement).
// 7. Contact.
// L'audace est dépensée dans la scène ; le reste est calme. Aucune image de
// banque : la seule photo est celle de Patrick.
import '../../styles/refonte.css';
import { Picture } from 'astro:assets';
import { SITE } from '../../config';
import type { Locale } from '../../i18n/routes';
import { routes, workBase } from '../../i18n/routes';
import { homeCopy } from '../../i18n/home';
import { refonteCopy } from '../../i18n/refonte';
import Mesures from './Mesures.astro';
import AvantApres from './AvantApres.astro';
import Scene from './Scene.astro';
import { HOME_LIEN_PATLAP, HOME_PATLAP, textes as textesPatlap } from '../../data/patlap';
import patrick from '../../assets/refonte/patrick-detoure.png';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const h = homeCopy[locale];
const c = refonteCopy[locale];
const patlap = HOME_PATLAP[locale];
const pl = textesPatlap(locale);
// Le bloc Pat Lap : en ligne seulement avec l'interrupteur ; en local, aussi
// avec PUBLIC_PREVIEW_PATLAP=true (.env.local), en dev seulement.
const voirPatlap = HOME_LIEN_PATLAP || (import.meta.env.DEV && import.meta.env.PUBLIC_PREVIEW_PATLAP === 'true');

const etude = (slug: string) => `${workBase[locale]}/${slug}`;
const services = [
  { href: routes.svcWeb[locale], s: c.services.lignes.web },
  { href: routes.svcSeo[locale], s: c.services.lignes.seo },
  { href: routes.svcShopify[locale], s: c.services.lignes.shopify },
  { href: routes.svcTools[locale], s: c.services.lignes.tools },
];
const beau = h.work.items.find((w) => w.slug === 'inspection-beauregard');
const avant = beau?.media.find((m) => m.file.includes('avant'));
const apres = beau?.media.find((m) => m.file.includes('apres'));
const altPhoto = locale === 'fr' ? 'Patrick Laperrière, souriant, en veston bleu' : 'Patrick Laperrière, smiling, in a blue jacket';
---

<div class="r-home">
  {/* ---- 1. Hero ---------------------------------------------------------------- */}
  <section class="r-hero" aria-labelledby="hero-title">
    <div class="r-hero__photo">
      <Picture
        src={patrick}
        formats={['avif', 'webp']}
        widths={[420, 640, 860, 1080]}
        fallbackFormat="webp"
        sizes="(min-width: 900px) min(46vw, 640px), 92vw"
        alt={altPhoto}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <div class="r-wrap r-hero__in">
      <h1 id="hero-title" class="r-h r-hero__titre">{c.hero.titre}</h1>
      <div class="r-hero__bas">
        <p class="r-hero__lead">{c.hero.texte}</p>
        <p class="r-hero__actions">
          <a class="r-btn r-btn--blanc" href="#travaux">{c.hero.entreprise}</a>
          {voirPatlap && <a class="r-btn r-btn--trait" href={patlap.lien}>{c.hero.apprendre}</a>}
        </p>
      </div>
    </div>
  </section>

  {/* Choisi AVANT l'affichage de la scène : la version 3D (piste haute) ou la
      composition fixe (mouvement réduit, économie de données, sans JS). Ainsi
      la mise en page ne change jamais après coup. */}
  <script is:inline>(function(){try{var m=matchMedia('(prefers-reduced-motion: reduce)').matches,c=navigator.connection,s=c&&c.saveData;if(!m&&!s)document.documentElement.classList.add('scene-3d')}catch(e){}})();</script>

  {/* ---- 2. La scène : mes vrais projets autour de toi -------------------------- */}
  <Scene locale={locale} />

  {/* ---- 3. BeauRegard, Avant / Après ---------------------------------------------- */}
  <section class="r-beau" aria-labelledby="beau-titre">
    <div class="r-wrap">
      <div class="r-beau__texte">
        <h2 id="beau-titre" class="r-h r-h--2">{c.travaux.beauregard.titre}</h2>
        <p class="r-p r-gris">{c.travaux.beauregard.texte}</p>
        <p class="r-liens">
          <a href={etude('inspection-beauregard')}>{c.travaux.beauregard.etude}</a>
          <a href="https://www.inspectionbeauregard.com" rel="noopener">{c.travaux.beauregard.site}</a>
        </p>
      </div>
      {avant && apres && (
        <AvantApres
          avant={{ file: avant.file, alt: c.travaux.slider.avantAlt, label: c.travaux.slider.avant }}
          apres={{ file: apres.file, alt: c.travaux.slider.apresAlt, label: c.travaux.slider.apres }}
          label={c.travaux.slider.label}
          consigne={c.travaux.slider.consigne}
        />
      )}
    </div>
  </section>

  {/* ---- 4. Ce que je fais : quatre services, en quinconce -------------------------- */}
  <section class="r-services" aria-labelledby="services-titre">
    <div class="r-wrap r-services__grille">
      <div class="r-services__tete">
        <h2 id="services-titre" class="r-h r-h--2">{c.services.titre}</h2>
        <p class="r-p r-gris">{c.services.intro}</p>
      </div>
      <ul class="r-coches" data-coches>
        {services.map(({ href, s }) => (
          <li>
            <span class="r-coche" aria-hidden="true"></span>
            <div>
              <a class="r-coches__titre" href={href}>{s.titre}</a>
              <p>{s.texte}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ---- 5. Un site rapide, ça se vérifie --------------------------------------------- */}
  <Mesures locale={locale} />

  {/* ---- 6. La technologie pour tous (Pat Lap), interrupteur HOME_LIEN_PATLAP ---- */}
  {voirPatlap && (
    <section class="r-patlap" aria-labelledby="patlap-titre">
      <div class="r-wrap r-patlap__grille">
        <h2 id="patlap-titre" class="r-h r-h--2">{patlap.titre}</h2>
        <div class="r-patlap__texte">
          <p class="r-patlap__accroche">{pl.hero.accroche}</p>
          <p class="r-p r-gris">{pl.hero.texte}</p>
          <p class="r-p r-gris">{c.patlap.soiree(pl.soiree.titre, pl.soiree.format)}</p>
          <p class="r-liens"><a href={patlap.lien}>{c.patlap.lien}</a></p>
        </div>
      </div>
    </section>
  )}

  {/* ---- 7. Contact --------------------------------------------------------------------- */}
  <section class="r-contact" aria-labelledby="contact-titre">
    <div class="r-wrap">
      <h2 id="contact-titre" class="r-h r-h--1">{c.contact.titre}</h2>
      <div class="r-contact__bas">
        <p class="r-p r-gris">{c.contact.texte}</p>
        <dl class="r-contact__moyens">
          <div><dt>{c.contact.courriel}</dt><dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd></div>
          <div><dt>{c.contact.telephone}</dt><dd><a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a></dd></div>
        </dl>
        <p><a class="r-btn r-btn--plein" href={routes.contact[locale]}>{c.contact.bouton}</a></p>
      </div>
    </div>
  </section>
</div>

<script>
  import '../../scripts/refonte.ts';
</script>

<style>
  .r-liens { display: flex; flex-wrap: wrap; gap: 4px 28px; margin: 24px 0 0; }
  .r-liens a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 700; }

  /* ---- 1. Hero : Patrick à droite, le titre devant ---------------------------- */
  .r-hero { position: relative; background: var(--nuit); overflow: hidden; display: grid; }
  .r-hero__photo { grid-area: 1 / 1; justify-self: end; align-self: end; width: min(92vw, 520px); margin-right: -6vw; }
  .r-hero__photo :global(img) { display: block; width: 100%; height: auto; }
  .r-hero__in { grid-area: 1 / 1; position: relative; z-index: 1; display: flex; flex-direction: column; justify-content: flex-end; padding-top: min(68vw, 360px); padding-bottom: 40px; }
  .r-hero__titre { font-size: clamp(2.75rem, 11.5vw, 8.25rem); line-height: .9; letter-spacing: -.045em; max-width: 11ch; text-wrap: balance; }
  .r-hero__bas { display: grid; gap: 28px; margin-top: 28px; }
  .r-hero__lead { color: var(--gris-txt); font-size: clamp(1.125rem, 1.5vw, 1.3125rem); line-height: 1.55; max-width: 44ch; margin: 0; }
  .r-hero__actions { display: flex; flex-wrap: wrap; gap: 14px; margin: 0; }
  .r-hero__actions .r-btn { min-height: 60px; padding: 14px 26px; font-size: 1.125rem; }
  @media (max-width: 899px) {
    /* La photo en haut ; le bas du veston, sombre, porte le titre. */
    .r-hero__photo { justify-self: center; align-self: start; margin-right: 0; width: min(100vw, 560px); -webkit-mask-image: linear-gradient(180deg, #000 62%, transparent 96%); mask-image: linear-gradient(180deg, #000 62%, transparent 96%); }
  }
  @media (min-width: 900px) {
    .r-hero { min-height: min(calc(100svh - 72px), 960px); }
    .r-hero__photo { width: min(48vw, 92svh, 760px); margin-right: max(0px, calc((100vw - 1360px) / 2)); }
    .r-hero__in { justify-content: center; padding-top: clamp(32px, 6vh, 88px); padding-bottom: clamp(32px, 6vh, 88px); }
    .r-hero__titre { max-width: 9.5ch; font-size: clamp(2.75rem, min(7.2vw, 12.5vh), 7.25rem); }
    .r-hero__bas { grid-template-columns: minmax(0, 46ch); }
  }
  /* L'entrée : le titre est balayé de gauche à droite, comme par le
     faisceau d'un projecteur. Une seule fois, moins d'une seconde.
     (Miroir du 7 nov. : l'allumage de la photo, un effet de trop, retiré.) */
  @media (prefers-reduced-motion: no-preference) {
    .r-hero__titre { animation: r-faisceau .7s .1s cubic-bezier(.2, .7, .1, 1) both; }
  }
  @keyframes r-faisceau { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }

  /* ---- 3. BeauRegard ------------------------------------------------------------ */
  .r-beau { padding: clamp(80px, 11vw, 160px) 0; }
  .r-beau__texte { max-width: 62ch; margin-bottom: clamp(32px, 5vw, 56px); }
  .r-beau__texte .r-p { margin-top: 20px; }
  @media (min-width: 1024px) { .r-beau__texte { margin-left: 33%; } }

  /* ---- 4. Ce que je fais -------------------------------------------------------- */
  .r-services { padding: clamp(80px, 11vw, 160px) 0; border-top: 1px solid var(--filet); }
  .r-services__grille { display: grid; gap: 40px; }
  .r-services__tete .r-p { margin-top: 18px; max-width: 34ch; }
  .r-coches { list-style: none; margin: 0; padding: 0; }
  .r-coches li { display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: 18px; padding: 24px 0; border-top: 1px solid var(--filet); }
  .r-coches li:last-child { border-bottom: 1px solid var(--filet); }
  .r-coche { width: 22px; height: 22px; margin-top: 5px; border: 2px solid var(--bleu-clair); border-radius: var(--r); position: relative; }
  .r-coche::after { content: ""; position: absolute; left: 6px; top: 1px; width: 6px; height: 12px; border: solid var(--bleu-clair); border-width: 0 2.5px 2.5px 0; transform: rotate(45deg); transition: transform .25s cubic-bezier(.2, .7, .1, 1), opacity .15s; }
  :global(.r-coches--anim) li:not(.est-coche) .r-coche::after { opacity: 0; transform: rotate(45deg) scale(.2); }
  .theme-refonte .r-coches__titre, .r-coches .r-coches__titre { font-weight: 800; font-size: clamp(1.25rem, 2vw, 1.625rem); letter-spacing: -.02em; color: var(--lumiere); text-decoration: none; }
  .r-coches .r-coches__titre:hover { text-decoration: underline; text-decoration-thickness: 2px; }
  .r-coches p { margin: 8px 0 0; color: var(--gris-txt); line-height: 1.55; max-width: 56ch; }
  @media (min-width: 1024px) {
    .r-services__grille { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 72px; align-items: start; }
    /* Quinconce : la deuxième et la quatrième ligne rentrent vers la droite. */
    .r-coches li:nth-child(even) { margin-left: 10%; }
  }

  /* ---- 6. Pat Lap ----------------------------------------------------------------- */
  .r-patlap { background: var(--salle); padding: clamp(72px, 10vw, 140px) 0; }
  .r-patlap__grille { display: grid; gap: 32px; }
  .r-patlap__accroche { font-size: clamp(1.375rem, 2.4vw, 1.875rem); line-height: 1.35; margin: 0 0 20px; max-width: 30ch; }
  .r-patlap .r-p + .r-p { margin-top: 1em; }
  @media (min-width: 1024px) { .r-patlap__grille { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 80px; align-items: start; } }

  /* ---- 7. Contact -------------------------------------------------------------------- */
  .r-contact { padding: clamp(80px, 11vw, 160px) 0; border-top: 1px solid var(--filet); }
  .r-contact .r-h { max-width: 12ch; }
  .r-contact__bas { display: grid; gap: 28px; margin-top: 40px; max-width: 760px; }
  .r-contact__moyens { margin: 0; border-top: 1px solid var(--filet); }
  .r-contact__moyens div { display: grid; grid-template-columns: 8rem minmax(0, 1fr); gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--filet); }
  .r-contact__moyens dt { color: var(--gris-txt); }
  .r-contact__moyens dd { margin: 0; font-size: 1.25rem; font-weight: 700; overflow-wrap: anywhere; }
  .r-contact__bas p { margin: 0; }
  @media (max-width: 420px) { .r-contact__moyens div { grid-template-columns: minmax(0, 1fr); gap: 4px; } }
</style>
