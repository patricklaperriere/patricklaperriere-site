---
// « Un site rapide, ça se vérifie » (REFONTE-1I). Les mesures de ce site, bas
// dans la page, en mots simples : une phrase sur la vitesse, puis une courte
// liste. Aucun sigle, aucune jauge, aucun remplissage animé. Les chiffres
// viennent de src/data/site-metrics.json (npm run measure, trois essais) :
// rien n'est tapé à la main. Une ligne n'apparaît que si elle a été mesurée.
import metrics from '../../data/site-metrics.json';
import type { Locale } from '../../i18n/routes';
import { refonteCopy } from '../../i18n/refonte';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = refonteCopy[locale].mesures;
const lang = locale === 'fr' ? 'fr-CA' : 'en-CA';

type PageMetrics = { performance: number; accessibility?: number; bestPractices?: number; seo?: number; lcpMs: number; cls: number };
const page = (metrics.pages as Record<string, PageMetrics>)[locale === 'fr' ? '/' : '/en'];
const date = metrics.measuredAt
  ? new Intl.DateTimeFormat(lang, { year: 'numeric', month: 'long', day: 'numeric' }).format(new Date(metrics.measuredAt))
  : '';
const secondes = page ? new Intl.NumberFormat(lang, { minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(page.lcpMs / 1000) : '';

// « Réussi » à 90 et plus : le seuil « bon » de l'outil de Google.
const lignes = page
  ? ([
      [t.performance, page.performance],
      [t.accessibility, page.accessibility],
      [t.seo, page.seo],
      [t.bestPractices, page.bestPractices],
    ] as [string, number | undefined][]).filter((r): r is [string, number] => typeof r[1] === 'number')
  : [];
---

<section class="mesures" aria-labelledby="mesures-titre">
  <div class="r-wrap">
    <h2 id="mesures-titre" class="mesures__titre">{t.titre}</h2>
    {page ? (
      <>
        <p class="mesures__phrase">{t.vitesse(secondes)}</p>
        <ul class="mesures__liste">
          {lignes.map(([k, v]) => (
            <li>
              <span class="mesures__nom">{k}</span>
              <span class="mesures__val">{v} {t.sur}</span>
              <span class:list={['mesures__etat', v < 90 && 'mesures__etat--non']}>{v >= 90 ? t.reussi : t.aCorriger}</span>
            </li>
          ))}
        </ul>
        <p class="mesures__meta">{t.mesure(date, (metrics as { source?: string }).source === 'production')}</p>
      </>
    ) : (
      <p class="mesures__meta">{t.pasMesure}</p>
    )}
  </div>
</section>

<style>
  .mesures { padding: clamp(56px, 7vw, 96px) 0; border-top: 1px solid var(--gris-plan); }
  .mesures__titre { font-family: var(--font-sans); font-weight: 700; font-size: 1.375rem; margin: 0; color: var(--graphite); }
  .mesures__phrase { margin: 14px 0 0; font-size: 1.125rem; line-height: 1.55; max-width: 52ch; }
  .mesures__liste { list-style: none; margin: 24px 0 0; padding: 0; max-width: 640px; border-top: 1px solid var(--gris-plan); }
  .mesures__liste li { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; gap: 8px 20px; align-items: baseline; padding: 12px 0; border-bottom: 1px solid var(--gris-plan); }
  .mesures__val { font-variant-numeric: tabular-nums; white-space: nowrap; color: var(--gris-txt); }
  .mesures__etat { font-weight: 700; color: var(--conforme); white-space: nowrap; }
  .mesures__etat--non { color: #FF9E94; }
  .mesures__meta { margin: 16px 0 0; color: var(--gris-txt); font-size: .9375rem; line-height: 1.5; max-width: 64ch; }
  @media (max-width: 420px) {
    .mesures__liste li { grid-template-columns: minmax(0, 1fr) auto; }
    .mesures__nom { grid-column: 1 / -1; }
  }
</style>
