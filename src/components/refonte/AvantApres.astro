---
// Curseur Avant/Après : deux captures réelles superposées, l'Après découpé
// par clip-path selon --pos. Le contrôle est un vrai <input type="range"> :
// clavier (flèches), lecteur d'écran et tactile marchent sans code de plus ;
// refonte.ts recopie sa valeur dans --pos. Sans JS : moitié, moitié.
import { Picture } from 'astro:assets';
import { capture } from '../../lib/work-media';

interface Props {
  avant: { file: string; alt: string; label: string };
  apres: { file: string; alt: string; label: string };
  label: string;
  consigne: string;
}
const { avant, apres, label, consigne } = Astro.props;
const a = capture(avant.file);
const b = capture(apres.file);
const sizes = '(min-width: 1024px) 1200px, 100vw';
---

{a && b && (
  <figure class="aa" style="--pos: 50%">
    <div class="aa__cadre">
      <Picture src={a} formats={['avif', 'webp']} widths={[640, 960, 1280]} sizes={sizes} alt={avant.alt} loading="lazy" decoding="async" fetchpriority="low" />
      <div class="aa__apres">
        <Picture src={b} formats={['avif', 'webp']} widths={[640, 960, 1280, 1920]} sizes={sizes} alt={apres.alt} loading="lazy" decoding="async" fetchpriority="low" />
      </div>
      <span class="aa__poignee" aria-hidden="true"></span>
      <input class="aa__range" type="range" min="0" max="100" value="50" step="1" aria-label={label} data-aa />
    </div>
    <figcaption class="aa__legende">
      <span>{apres.label}</span>
      <span>{consigne}</span>
      <span>{avant.label}</span>
    </figcaption>
  </figure>
)}

<style>
  .aa { margin: 0; }
  /* 3. Le balayage de Wix vers Astro suit le défilement : --pos va de 0 à
     100 % pendant que la comparaison traverse l'écran. Dès que l'on touche le
     glisseur (doigt, souris ou clavier), refonte.ts pose .aa--main : le
     défilement rend la main. Sans support ou en mouvement réduit : 50 %. */
  @property --pos { syntax: '<percentage>'; inherits: true; initial-value: 50%; }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .aa:not(.aa--main) { animation: aa-balaye linear both; animation-timeline: view(); animation-range: cover 15% cover 70%; }
    }
  }
  @keyframes aa-balaye { from { --pos: 0%; } to { --pos: 100%; } }
  .aa__cadre { position: relative; border: 1px solid var(--gris-plan); border-radius: var(--r); overflow: hidden; aspect-ratio: 16 / 10; background: var(--gris-plan); touch-action: pan-y; }
  .aa__cadre :global(picture), .aa__cadre :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  /* L'Après (Astro) se découvre depuis la gauche : --pos = part d'Astro visible. */
  .aa__apres { position: absolute; inset: 0; clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  /* La poignée : un trait bleu plan et une prise carrée. */
  .aa__poignee { position: absolute; top: 0; bottom: 0; left: var(--pos); width: 2px; margin-left: -1px; background: var(--bleu); pointer-events: none; }
  .aa__poignee::after { content: ""; position: absolute; top: 50%; left: 50%; width: 20px; height: 48px; margin: -24px 0 0 -10px; background: var(--bleu); border: 2px solid #fff; border-radius: var(--r); }
  .aa__range { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; }
  .aa:has(.aa__range:focus-visible) .aa__cadre { outline: 3px solid var(--bleu); outline-offset: 3px; }
  .aa__legende { display: flex; justify-content: space-between; gap: 16px; margin-top: 12px; font-size: .9375rem; color: var(--gris-txt); }
  .aa__legende span:first-child, .aa__legende span:last-child { color: var(--graphite); font-weight: 700; white-space: nowrap; }
  @media (max-width: 640px) {
    .aa__legende { flex-wrap: wrap; }
    .aa__legende span:nth-child(2) { order: 3; flex-basis: 100%; }
  }
</style>
