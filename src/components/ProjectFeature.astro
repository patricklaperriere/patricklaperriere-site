---
// Editorial project entry. Replaces the equal-weight card grid: imagery is the
// hero, metadata is mono, and the whole row is one link.
//
// `variant` drives the composition, not a separate component:
//   lead — full-width media, oversized title underneath
//   half — one of a two-up pair
import type { Project } from '../data/projets';
import { loc } from '../data/projets';
import type { Locale } from '../i18n/routes';
import { workBase } from '../i18n/routes';
import { useTranslations } from '../i18n';

interface Props {
  project: Project;
  locale: Locale;
  index: number;
  variant?: 'lead' | 'half';
}
const { project, locale, index, variant = 'half' } = Astro.props;
const tr = useTranslations(locale);

const href = `${workBase[locale]}/${project.slug}`;
const shot = project.image;
const contain = project.fit === 'contain';
const num = String(index).padStart(2, '0');

const shotAlt =
  locale === 'fr'
    ? `Aperçu du site ${loc(project.title, locale)}`
    : `Preview of the ${loc(project.title, locale)} website`;

// Category reads better as a human word than as the raw data key.
const categoryLabel: Record<string, { fr: string; en: string }> = {
  saas: { fr: 'Logiciel SaaS', en: 'SaaS product' },
  web: { fr: 'Site sur mesure', en: 'Custom site' },
  seo: { fr: 'Site + SEO local', en: 'Site + local SEO' },
  shopify: { fr: 'E-commerce Shopify', en: 'Shopify e-commerce' },
};
const category = categoryLabel[project.category]?.[locale] ?? project.category;
---

<article class:list={['pf', `pf--${variant}`]} style={`--accent:${project.accent}`}>
  <a href={href} class="pf__link">
    <div class:list={['pf__media', 'media', 'media--zoom', contain && 'pf__media--contain']}>
      <img
        src={shot}
        alt={shotAlt}
        width={variant === 'lead' ? 1280 : 800}
        height={variant === 'lead' ? 800 : 500}
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="pf__info">
      <div class="pf__meta">
        <span class="index-num pf__num">{num}</span>
        <span class="pf__rule" aria-hidden="true"></span>
        <span class="pf__cat">{category}</span>
        {project.draft && <span class="pf__draft">{locale === 'fr' ? 'Brouillon' : 'Draft'}</span>}
        <span class="pf__year">{project.year}</span>
      </div>

      <h3 class="pf__title">{loc(project.title, locale)}</h3>
      <p class="pf__tagline">{loc(project.tagline, locale)}</p>

      <ul class="pf__stack" aria-hidden="true">
        {project.stack.slice(0, 4).map((s) => <li>{s}</li>)}
      </ul>

      <span class="cta-mono pf__cta">
        {tr.cta.viewProject}
        <span class="pf__arrow" aria-hidden="true">→</span>
      </span>
    </div>
  </a>
</article>

<style>
  .pf__link {
    display: grid;
    gap: clamp(1.1rem, 2.2vw, 1.75rem);
  }

  /* ---- Media -------------------------------------------------------------
     The accent only ever appears as a hairline that draws in on hover, never
     as a glow behind the image. */
  .pf__media {
    position: relative;
    border-radius: var(--r-md);
    background: var(--ink-raised);
    aspect-ratio: 16 / 10;
  }
  .pf__media::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-slow) var(--ease-out);
  }
  .pf__link:hover .pf__media::after,
  .pf__link:focus-visible .pf__media::after {
    transform: scaleX(1);
  }
  .pf__media img {
    object-position: top center;
  }
  /* Device mockups are shown whole rather than cropped. */
  .pf__media--contain {
    padding: clamp(1rem, 3vw, 2.5rem);
  }
  .pf__media--contain img {
    object-fit: contain;
    object-position: center;
  }

  /* ---- Info --------------------------------------------------------------- */
  .pf__meta {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-mute);
    margin-bottom: 0.85rem;
  }
  .pf__rule {
    flex: 1;
    height: 1px;
    background: var(--line);
    max-width: 3rem;
  }
  .pf__year { margin-left: auto; }
  /* Only ever rendered under `astro dev`: drafts never reach a build. */
  .pf__draft {
    padding: 0.1rem 0.45rem;
    border: 1px dashed var(--vermilion);
    color: var(--vermilion-text);
  }

  .pf__title {
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    font-weight: var(--fw-light);
    letter-spacing: -0.03em;
    margin: 0 0 0.6rem;
    transition: color var(--t-fast) var(--ease);
  }
  .pf__link:hover .pf__title { color: var(--accent-fg); }

  .pf__tagline {
    color: var(--fg-dim);
    font-size: var(--fs-sm);
    line-height: 1.55;
    margin: 0 0 1.15rem;
    max-width: 52ch;
  }

  .pf__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    margin: 0 0 1.25rem;
  }
  .pf__stack li {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.06em;
    color: var(--fg-mute);
  }
  .pf__stack li + li::before {
    content: "/";
    margin-right: 0.9rem;
    opacity: 0.45;
  }

  .pf__arrow { transition: transform var(--t-base) var(--ease-out); }
  .pf__link:hover .pf__arrow { transform: translateX(4px); }

  /* ---- Lead variant -------------------------------------------------------
     Media on top at a wider ratio, then a two-column footer so the title can
     run large while the description stays on a readable measure. */
  .pf--lead .pf__media { aspect-ratio: 16 / 9; }
  .pf--lead .pf__title { font-size: clamp(2rem, 4.2vw, 3.25rem); }
  .pf--lead .pf__info {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 3rem);
    align-items: start;
  }
  .pf--lead .pf__meta { grid-column: 1 / -1; }
  .pf--lead .pf__title { grid-column: 1; margin-bottom: 0; }
  .pf--lead .pf__tagline { grid-column: 2; grid-row: 3; margin-bottom: 1rem; }
  .pf--lead .pf__stack { grid-column: 2; grid-row: 4; }
  .pf--lead .pf__cta { grid-column: 2; grid-row: 5; }

  @media (max-width: 860px) {
    .pf--lead .pf__info { grid-template-columns: 1fr; }
    .pf--lead .pf__title,
    .pf--lead .pf__tagline,
    .pf--lead .pf__stack,
    .pf--lead .pf__cta {
      grid-column: 1;
      grid-row: auto;
    }
    .pf--lead .pf__title { margin-bottom: 0.6rem; }
  }
</style>
