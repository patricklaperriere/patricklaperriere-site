---
// Measured Lighthouse scores, presented as an instrument readout rather than
// marketing counters: tabular mono figures, a scale bar per metric, and the
// measurement date stated plainly.
//
// Every value comes from src/data/lighthouse.ts, which is filled from real
// runs — a null renders nothing rather than a zero or a placeholder, so an
// unmeasured site can never look like a bad one.
import { useTranslations } from '../i18n';
import type { Locale } from '../i18n/routes';
import type { LighthouseScore } from '../data/lighthouse';

interface Props {
  locale: Locale;
  score: LighthouseScore;
  /** `full` shows the vitals row; `compact` is the case-study strip. */
  variant?: 'full' | 'compact';
}
const { locale, score, variant = 'compact' } = Astro.props;
const tr = useTranslations(locale);
const l = tr.lighthouse;

// Best Practices is intentionally excluded — see the note in data/lighthouse.ts.
const metrics = [
  { key: 'performance', label: l.labels.performance, value: score.performance },
  { key: 'accessibility', label: l.labels.accessibility, value: score.accessibility },
  { key: 'seo', label: l.labels.seo, value: score.seo },
].filter((m): m is { key: string; label: string; value: number } => m.value !== null);

const dateFmt = new Intl.DateTimeFormat(locale === 'fr' ? 'fr-CA' : 'en-CA', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(new Date(score.measured + 'T12:00:00'));

const band = (v: number) => (v >= 90 ? 'good' : v >= 50 ? 'mid' : 'low');

const vitals = [
  score.lcp !== null ? { k: 'LCP', v: `${score.lcp.toFixed(1)} s` } : null,
  score.cls !== null ? { k: 'CLS', v: score.cls.toFixed(3) } : null,
].filter((x): x is { k: string; v: string } => x !== null);
---

{metrics.length > 0 && (
  <div class:list={['bench', `bench--${variant}`]}>
    <ul class="bench__metrics">
      {metrics.map((m, i) => (
        <li class="bench__metric reveal" data-delay={`${i * 90}ms`} data-band={band(m.value)}>
          <span class="bench__label">{m.label}</span>
          <span class="bench__value">
            {/* The real number is in the markup, so it is present for crawlers
                and for anyone without JS; ux.ts only animates up to it. */}
            <span data-count={m.value} data-suffix="">{m.value}</span>
            <span class="bench__max" aria-hidden="true">/100</span>
          </span>
          <span class="bench__bar" aria-hidden="true" style={`--v:${m.value}`}>
            <span class="bench__bar-fill"></span>
          </span>
        </li>
      ))}
    </ul>

    {variant === 'full' && vitals.length > 0 && (
      <ul class="bench__vitals">
        {vitals.map((v) => (
          <li class="bench__vital">
            <span class="bench__vital-k">{v.k}</span>
            <span class="bench__vital-v">{v.v}</span>
          </li>
        ))}
      </ul>
    )}

    <p class="bench__meta">{`${l.measuredOn} ${dateFmt} · ${l.method}`}</p>
  </div>
)}

<style>
  .bench {
    border-top: 1px solid var(--line-strong);
  }

  .bench__metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .bench__metric {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    padding: clamp(1.4rem, 3vw, 2.25rem) clamp(1rem, 2.5vw, 2rem) clamp(1.4rem, 3vw, 2.25rem) 0;
    border-right: 1px solid var(--line-soft);
  }
  .bench__metric + .bench__metric { padding-left: clamp(1rem, 2.5vw, 2rem); }
  .bench__metric:last-child { border-right: 0; }

  .bench__label {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--fg-mute);
  }
  .bench__value {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: var(--fw-thin);
    letter-spacing: -0.04em;
    line-height: 0.95;
    font-variant-numeric: tabular-nums;
    color: var(--fg);
  }
  .bench__max {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--fg-mute);
  }

  /* Scale bar. Decorative: the figure above already states the value. */
  .bench__bar {
    display: block;
    height: 2px;
    background: var(--line);
    overflow: hidden;
  }
  .bench__bar-fill {
    display: block;
    height: 100%;
    width: calc(var(--v) * 1%);
    background: var(--fg-mute);
    transform-origin: left;
  }
  /* The grow-in is scoped to .js so that without scripting the bar is simply
     drawn at its real width instead of staying collapsed at zero. */
  .js .bench__bar-fill {
    transform: scaleX(0);
    transition: transform 1s var(--ease-out) 120ms;
  }
  .js .bench__metric.is-in .bench__bar-fill { transform: scaleX(1); }
  .bench__metric[data-band="good"] .bench__bar-fill { background: var(--positive); }
  .bench__metric[data-band="mid"]  .bench__bar-fill { background: #e0b341; }
  .bench__metric[data-band="low"]  .bench__bar-fill { background: var(--vermilion); }

  /* ---- Vitals ------------------------------------------------------------- */
  .bench__vitals {
    display: flex;
    flex-wrap: wrap;
    gap: 0 clamp(1.5rem, 4vw, 3rem);
    padding: 1rem 0;
    border-top: 1px solid var(--line-soft);
  }
  .bench__vital {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
  }
  .bench__vital-k {
    letter-spacing: 0.12em;
    color: var(--fg-mute);
  }
  .bench__vital-v {
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }

  .bench__meta {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.06em;
    color: var(--fg-mute);
    padding-top: 0.9rem;
    border-top: 1px solid var(--line-soft);
    margin: 0;
  }

  /* Compact strip (case studies) sits tighter and drops the scale bars. */
  .bench--compact .bench__value { font-size: clamp(1.9rem, 4vw, 2.5rem); }
  .bench--compact .bench__metric { padding-block: 1.1rem; }

  @media (max-width: 640px) {
    .bench__metrics { grid-template-columns: 1fr; }
    .bench__metric,
    .bench__metric + .bench__metric {
      border-right: 0;
      border-bottom: 1px solid var(--line-soft);
      padding: 1.1rem 0;
    }
    .bench__value { font-size: clamp(2.25rem, 12vw, 3rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    .js .bench__bar-fill { transform: scaleX(1); }
  }
</style>
