---
import { SITE } from '../config';
import type { Locale } from '../i18n/routes';
import { graph, siteNodes } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  /** Equivalent page path in each language — drives hreflang. */
  alternates: { fr: string; en: string };
  /** Canonical path (defaults to the current pathname). */
  path?: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
  schema?: object | null;
  noindex?: boolean;
}

const {
  title,
  description,
  locale,
  alternates,
  path,
  ogImage = SITE.ogImage,
  ogType = 'website',
  schema = null,
  noindex = false,
} = Astro.props;

const abs = (p: string) => (p.startsWith('http') ? p : SITE.domain + p);

// Normalize: strip trailing slash except root.
const norm = (p: string) => (p !== '/' && p.endsWith('/') ? p.slice(0, -1) : p);

const canonicalPath = norm(path ?? Astro.url.pathname);
const canonical = abs(canonicalPath);
const ogImageAbs = abs(ogImage);

const frUrl = abs(norm(alternates.fr));
const enUrl = abs(norm(alternates.en));
const ogLocale = locale === 'fr' ? 'fr_CA' : 'en_CA';
const altLocale = locale === 'fr' ? 'en_CA' : 'fr_CA';

// JSON-LD: every page carries the site-wide entities (Person, WebSite,
// Technologies Habita inc.) so each `@id` reference resolves on the page that
// makes it. A page's own nodes win when they share an @id (e.g. the richer
// Person on the about page). Noindex pages get no structured data at all.
type Node = { '@id'?: string } & Record<string, unknown>;
const own: Node[] = !schema
  ? []
  : '@graph' in (schema as Record<string, unknown>)
    ? ((schema as { '@graph': Node[] })['@graph'])
    : [schema as Node];
const ownIds = new Set(own.map((n) => n['@id']).filter(Boolean));
const jsonLd = noindex
  ? null
  : graph([...siteNodes(locale).filter((n) => !ownIds.has(n['@id'])), ...own]);
---

<title>{title}</title>
<meta name="description" content={description} />
{!noindex && <link rel="canonical" href={canonical} />}

{noindex
  ? <meta name="robots" content="noindex,nofollow" />
  : <meta name="robots" content="index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1" />}

<meta name="author" content={SITE.name} />
{SITE.gscVerification && <meta name="google-site-verification" content={SITE.gscVerification} />}

{/* hreflang — every indexable page links its FR/EN equivalents + x-default */}
{!noindex && (
  <>
    <link rel="alternate" hreflang="fr-CA" href={frUrl} />
    <link rel="alternate" hreflang="en-CA" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={frUrl} />
  </>
)}

{/* Open Graph */}
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:locale:alternate" content={altLocale} />
<meta property="og:image" content={ogImageAbs} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />

{/* Twitter */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageAbs} />
<meta name="twitter:image:alt" content={title} />

{/* RSS feed for this locale */}
<link
  rel="alternate"
  type="application/rss+xml"
  title={`Patrick Laperrière · ${locale === 'fr' ? 'Blogue' : 'Blog'}`}
  href={locale === 'fr' ? '/rss.xml' : '/en/rss.xml'}
/>

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
