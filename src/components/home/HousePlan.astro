---
// A house in section, drawn like a pencil sketch on a plan: roof, structure,
// foundations. Every line is a pair of slightly-off strokes (lib/sketch.ts),
// generated at build time with a fixed seed. The three layers are grouped so
// the home page can draw them in one at a time as the visitor scrolls; without
// motion they are simply all there.
//
// Hand-lettered notes name each layer. They repeat what the HTML beside the
// drawing says, so the SVG is one image with one label for assistive tech.
import { prng, sketchSegment, sketchPolyline, sketchRect, sketchArrow } from '../../lib/sketch';

interface Props {
  label: string;
  notes: { note: string; noteSub: string }[];
  scanning: string;
}
const { label, notes, scanning } = Astro.props;

const rand = prng(1987);
type Pt = [number, number];
const seg = (a: Pt, b: Pt, rough?: number) => sketchSegment(a, b, rand, rough);

// Roof slope helper: y on the outer roof line at a given x.
const roofY = (x: number) => (x <= 220 ? 212 - ((x - 60) / 160) * 128 : 84 + ((x - 220) / 160) * 128);

const roof = [
  ...sketchPolyline([[60, 212], [220, 84], [380, 212]], rand),
  ...sketchPolyline([[84, 212], [220, 103], [356, 212]], rand, { rough: 1 }),
  ...sketchPolyline([[290, roofY(290)], [290, 112], [313, 112], [313, roofY(313)]], rand),
  // Shingle hints along both slopes.
  ...[0, 1, 2, 3].flatMap((i) => {
    const x = 112 + i * 26;
    return seg([x, roofY(x) + 6], [x + 15, roofY(x + 15) + 6], 0.8);
  }),
  ...[0, 1, 2].flatMap((i) => {
    const x = 236 + i * 30;
    return seg([x, roofY(x) + 6], [x + 15, roofY(x + 15) + 6], 0.8);
  }),
];

const studs = (y1: number, y2: number) =>
  [115, 150, 185, 255, 325].flatMap((x) => seg([x, y1], [x, y2], 0.7));

const structure = [
  ...seg([80, 212], [80, 380]),
  ...seg([360, 212], [360, 380]),
  ...seg([80, 296], [360, 296]),
  ...seg([80, 302], [360, 302], 0.8),
  ...studs(214, 294),
  ...studs(304, 378),
  ...sketchRect(100, 230, 50, 42, rand),
  ...sketchRect(290, 230, 50, 42, rand),
  ...sketchRect(290, 318, 50, 40, rand),
  ...sketchPolyline([[194, 380], [194, 318], [236, 318], [236, 380]], rand),
  ...seg([110, 251], [140, 251], 0.6),
  ...seg([300, 251], [330, 251], 0.6),
];

const hatch = Array.from({ length: 13 }, (_, i) => 92 + i * 21).flatMap((x) => seg([x, 438], [x + 16, 388], 0.9));
const grass = Array.from({ length: 10 }, (_, i) => (i < 5 ? 24 + i * 10 : 376 + (i - 5) * 9)).flatMap((x) =>
  seg([x, 380], [x + 4, 371], 0.5),
);
const foundations = [
  ...seg([18, 380], [404, 380]),
  ...grass,
  ...sketchPolyline([[80, 380], [80, 440], [360, 440], [360, 380]], rand),
  ...sketchRect(64, 440, 312, 20, rand),
  ...hatch,
];

// Dimension line (cote) down the left side, with end ticks.
const cote = [
  ...seg([34, 84], [34, 460], 0.6),
  ...seg([26, 84], [42, 84], 0.4),
  ...seg([26, 460], [42, 460], 0.4),
];

// Notes: an arrow from the lettering to the layer it names.
const anchors: { at: Pt; from: Pt; text: Pt }[] = [
  { at: [318, 150], from: [440, 118], text: [446, 104] },
  { at: [364, 262], from: [440, 262], text: [446, 250] },
  { at: [364, 424], from: [440, 420], text: [446, 408] },
];
const arrows = anchors.map((a) => sketchArrow(a.from, a.at, rand, 0.18));

const layers = [
  { id: 'toiture', paths: roof },
  { id: 'structure', paths: structure },
  { id: 'fondations', paths: foundations },
];
---

<svg class="plan" viewBox="0 0 640 500" role="img" aria-label={label} data-plan>
  <g class="plan__cote" aria-hidden="true">
    {cote.map((d) => <path d={d} />)}
  </g>

  {layers.map((l, i) => (
    <g class="plan__layer" data-layer={l.id}>
      <g class="plan__lines">
        {l.paths.map((d, k) => <path class:list={[k % 2 && 'plan__ghost']} d={d} />)}
      </g>
      <g class="plan__note" data-note>
        {arrows[i].map((d) => <path class="plan__arrow" d={d} />)}
        <text class="plan__note-main" x={anchors[i].text[0]} y={anchors[i].text[1]}>{notes[i].note}</text>
        <text class="plan__note-sub" x={anchors[i].text[0]} y={anchors[i].text[1] + 22}>{notes[i].noteSub}</text>
      </g>
    </g>
  ))}

  {/* Scanning rule: a pencil line with its label, moved down the drawing by
      the home-page timeline. Hidden unless motion is on. */}
  <g class="plan__scan" data-scan aria-hidden="true">
    <path d="M10 0 H410" />
    <text x="414" y="5">{scanning}</text>
  </g>

  {/* Title block, as on any plan. */}
  <g class="plan__cartouche" aria-hidden="true">
    {sketchRect(452, 446, 176, 44, rand, 0.6).map((d) => <path d={d} />)}
    <text x="462" y="466">Coupe A</text>
    <text x="462" y="484">P. Laperrière</text>
  </g>
</svg>

<style>
  .plan {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .plan path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .plan__lines path {
    stroke: var(--pencil, #9fb6ff);
    stroke-width: 1.5;
  }
  .plan__lines .plan__ghost {
    stroke-width: 1;
    opacity: 0.55;
  }
  .plan__cote path {
    stroke: var(--fg-mute);
    stroke-width: 1;
  }
  .plan__arrow {
    stroke: var(--note, #c9a8ff);
    stroke-width: 1.6;
  }
  .plan text {
    font-family: var(--font-hand);
    fill: var(--note, #c9a8ff);
  }
  .plan__note-main { font-size: 26px; }
  .plan__note-sub { font-size: 18px; fill: var(--fg-dim); }
  .plan__scan { display: none; }
  .plan__scan path {
    stroke: var(--note, #c9a8ff);
    stroke-width: 1.4;
    stroke-dasharray: 6 5;
  }
  .plan__scan text { font-size: 15px; }
  .plan__cartouche path { stroke: var(--fg-mute); stroke-width: 1; }
  .plan__cartouche text { fill: var(--fg-dim); font-size: 15px; }

  /* Narrow screens: the drawing shrinks to about half size, so the secondary
     lettering would be under 10px. The HTML beside it says the same thing. */
  @media (max-width: 560px) {
    .plan__note-sub, .plan__cartouche { display: none; }
    .plan__note-main { font-size: 30px; }
  }
</style>
