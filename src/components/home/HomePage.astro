---
// The home page, both languages: "le rapport d'inspection".
//
// One grid (4 / 8 / 12 columns, report.css), one 8px rhythm. Column 1 carries
// the main content and column 9 the secondary column; the portrait closes on
// the last column. Every word and image is in the HTML: without JavaScript or
// with reduced motion, this is the page. home-motion.ts adds soft fade-ins
// below the fold and one pinned moment: the plan, exploded and inspected
// layer by layer.
import '../../styles/report.css';
import { Picture } from 'astro:assets';
import { SITE } from '../../config';
import type { Locale } from '../../i18n/routes';
import { routes, workBase } from '../../i18n/routes';
import { homeCopy } from '../../i18n/home';
import { sortedProjects } from '../../data/projets';
import { PORTRAIT_WIDTHS } from '../../lib/photo';
import portrait from '../../assets/photo/patrick-portrait-mauve.jpg';
import InspectionPlan from './InspectionPlan.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = homeCopy[locale];

// Habita is presented once, as the foundations; the list shows client work.
const work = (await sortedProjects()).filter((p) => !p.draft && p.slug !== 'habita');

const hrefs = {
  svcWeb: routes.svcWeb[locale],
  svcSeo: routes.svcSeo[locale],
  svcShopify: routes.svcShopify[locale],
  work: routes.work[locale],
  habitaCase: `${workBase[locale]}/habita`,
  habitaSite: SITE.company.url,
};
const num = (i: number) => String(i + 1).padStart(2, '0');
---

<div class="home">
  {/* ---- Hero ------------------------------------------------------------ */}
  <section class="hero st-frame" aria-labelledby="hero-title">
    <div class="st-grid hero__grid">
      <p class="hero__name">{t.hero.name}</p>
      <div class="hero__text">
        <h1 id="hero-title" class="hero__title">{t.hero.title}</h1>
        <p class="hero__lead">{t.hero.lead}</p>
        <p class="hero__actions">
          <a class="btn btn-primary" href={routes.contact[locale]}>{t.hero.cta}</a>
          <a class="hero__link" href="#travaux">{t.hero.secondary}</a>
        </p>
      </div>
      <figure class="hero__photo">
        <Picture
          src={portrait}
          formats={['avif', 'webp']}
          widths={PORTRAIT_WIDTHS}
          sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1023px) 34vw, 540px"
          alt={t.hero.portraitAlt}
          width={720}
          height={900}
          loading="eager"
        />
      </figure>
      <a class="hero__hint" href="#inspection">
        <span class="hero__hint-line" aria-hidden="true"></span>
        {t.hero.scroll}
      </a>
    </div>
  </section>

  {/* ---- Inspection: the one pinned moment -------------------------------- */}
  <section class="insp st-frame" id="inspection" aria-labelledby="insp-title">
    <header class="st-grid insp__head" data-reveal>
      <h2 id="insp-title" class="h2">{t.inspection.title}</h2>
      <p class="insp__intro">{t.inspection.intro}</p>
    </header>
    <div class="st-grid insp__stage" data-insp-stage>
      {/* While pinned: which layer is being inspected. The full text of each
          layer follows the plan, so this stays out of the accessibility tree. */}
      <ol class="insp__caption" aria-hidden="true">
        {t.inspection.layers.map((l, i) => (
          <li data-caption><span class="layer__num">{num(i)}</span>{l.name}</li>
        ))}
      </ol>
      <div class="insp__plan">
        <InspectionPlan label={t.inspection.planLabel} />
      </div>
    </div>
    <div class="st-grid">
      <ol class="insp__layers">
        {t.inspection.layers.map((l, i) => (
          <li class="layer" data-reveal>
            <p class="layer__name"><span class="layer__num">{num(i)}</span>{l.name}</p>
            <h3 class="layer__title">{l.title}</h3>
            <p class="layer__body">{l.body}</p>
            <p class="layer__links">
              {l.links.map((k) => (
                <a href={hrefs[k.key]} rel={k.key === 'habitaSite' ? 'noopener' : undefined}>{k.label}</a>
              ))}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ---- Work ------------------------------------------------------------------- */}
  <section class="work st-frame" id="travaux" aria-labelledby="work-title">
    <header class="st-grid work__head" data-reveal>
      <h2 id="work-title" class="h2">{t.work.title}</h2>
      <a class="work__all" href={routes.work[locale]}>{t.work.all}</a>
    </header>
    <ul class="st-grid work__list">
      {work.map((p) => (
        <li class="card" data-reveal>
          <a href={`${workBase[locale]}/${p.slug}`}>
            <span class="card__media">
              <img src={p.image} alt={t.work.shot(p.title[locale])} width="1280" height="800" loading="lazy" decoding="async" />
            </span>
            <span class="card__title">{p.title[locale]}</span>
            <span class="card__meta">{t.work.kinds[p.category]}, {p.year}</span>
            <span class="card__tagline">{p.tagline[locale]}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {/* ---- About -------------------------------------------------------------------- */}
  <section class="about st-frame" aria-labelledby="about-title">
    <div class="st-grid">
      <h2 id="about-title" class="h2 about__title" data-reveal>{t.about.title}</h2>
      <div class="about__text" data-reveal>
        {t.about.body.map((p) => <p>{p}</p>)}
        <p><a href={routes.about[locale]}>{t.about.more}</a></p>
      </div>
    </div>
  </section>

  {/* ---- Contact ------------------------------------------------------------------- */}
  <section class="contact st-frame" aria-labelledby="contact-title">
    <div class="st-grid">
      <div class="contact__intro" data-reveal>
        <h2 id="contact-title" class="contact__title">{t.contact.title}</h2>
        <p class="contact__lead">{t.contact.lead}</p>
      </div>
      <div class="contact__reach" data-reveal>
        <dl>
          <div>
            <dt>{t.contact.email}</dt>
            <dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
          </div>
          <div>
            <dt>{t.contact.phone}</dt>
            <dd><a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a></dd>
          </div>
        </dl>
        <a class="btn btn-primary" href={routes.contact[locale]}>{t.contact.cta}</a>
      </div>
    </div>
  </section>
</div>

<script>
  import '../../scripts/home-motion.ts';
</script>

<style>
  /* ---- Shared ---------------------------------------------------------------- */
  .home section { padding-block: var(--section); }
  .home section + section { border-top: 1px solid var(--line); }
  /* Titles take whole columns; their measure comes from the span. */
  .h2 {
    grid-column: 1 / -1;
    font-size: clamp(2.25rem, 4.4vw, 3.75rem);
    line-height: 1;
  }
  @media (min-width: 768px) {
    .h2 { grid-column: 1 / span 6; }
  }
  .home a:not(.btn) {
    color: var(--bone);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    transition: text-decoration-color 0.2s ease, color 0.2s ease;
  }
  .home a:not(.btn):hover { text-decoration-color: var(--signal); color: var(--signal); }
  .home .btn { min-height: 48px; padding-inline: var(--s3); font-size: 1rem; }

  /* ---- Hero ---------------------------------------------------------------- */
  .home .hero { padding-block: var(--s5) var(--s6); }
  .hero__grid { row-gap: var(--s5); align-items: start; }
  .hero__name, .hero__text, .hero__photo, .hero__hint { grid-column: 1 / -1; }
  .hero__name { color: var(--signal); font-family: var(--font-mono); font-size: 0.8125rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 calc(var(--s3) - var(--s5)); }
  .hero__title {
    font-size: clamp(3rem, 6vw, 5.75rem);
    font-weight: 900;
    line-height: 0.95;
    margin: 0;
  }
  .hero__lead {
    color: var(--slate);
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.6;
    max-width: 46ch;
    margin: var(--s4) 0 var(--s5);
  }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s2) var(--s4); margin: 0; }
  .hero__photo { margin: 0; overflow: hidden; }
  .hero__photo :global(picture) { display: block; }
  /* Phones: a tighter, square crop on the face. */
  .hero__photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: 50% 28%;
    transform: scale(1.18);
    transform-origin: 52% 34%;
  }
  .hero__hint { display: none; }

  @media (min-width: 768px) {
    .hero__text { grid-column: 1 / span 5; }
    .hero__photo { grid-column: 6 / span 3; }
    .hero__photo :global(img) { aspect-ratio: 4 / 5; transform: none; object-position: 50% 50%; }
    .hero__hint {
      display: inline-flex;
      align-items: center;
      gap: var(--s2);
      justify-self: start;
      min-height: 44px;
      color: var(--slate-mute) !important;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      text-decoration: none !important;
    }
    .hero__hint-line { width: var(--s5); height: 1px; background: var(--line-strong); }
    .hero__hint:hover .hero__hint-line { background: var(--signal); }
  }
  @media (min-width: 1024px) {
    .home .hero { padding-block: var(--s6) var(--s5); }
    .hero__text { grid-column: 1 / span 7; }
    /* Larger, and its top edge on the title's top edge. */
    .hero__photo { grid-column: 8 / span 5; }
  }

  /* ---- Inspection ---------------------------------------------------------- */
  .home .insp { padding-top: var(--s6); }
  .insp__head { row-gap: var(--s2); margin-bottom: var(--s5); }
  .insp__intro { grid-column: 1 / -1; color: var(--slate); font-size: 1.125rem; margin: 0; }
  @media (min-width: 768px) {
    .insp__intro { grid-column: 1 / span 6; }
  }
  .insp__stage { align-items: center; }
  /* The plan is a full-bleed figure: it leaves the 1320px frame to reach the
     page margins (on phones, the screen edges), centred on the grid. Its
     width is --plan-w; the house is 91% of it. */
  .insp__plan {
    --plan-w: 100vw;
    grid-column: 1 / -1;
    width: var(--plan-w);
    margin-left: calc((100% - var(--plan-w)) / 2);
  }
  @media (min-width: 768px) {
    .insp__plan { --plan-w: calc(100vw - 2 * var(--margin)); }
  }
  .insp__caption { display: none; }

  .insp__layers {
    grid-column: 1 / -1;
    list-style: none;
    margin: var(--s6) 0 0;
    padding: 0;
    display: grid;
    gap: var(--s6) var(--gap);
  }
  .layer__name {
    display: flex;
    align-items: baseline;
    gap: var(--s2);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--slate);
    margin: 0 0 var(--s2);
  }
  .layer__num { color: var(--signal); font-weight: 500; }
  .layer__title { font-size: clamp(1.875rem, 2.6vw, 2.375rem); line-height: 1.02; margin: 0; }
  .layer__body { color: var(--slate); margin: var(--s2) 0 var(--s3); max-width: 44ch; }
  .layer__links { display: flex; flex-wrap: wrap; gap: var(--s1) var(--s3); margin: 0; }
  @media (min-width: 1024px) {
    .home .insp { padding-top: var(--s8); }
    .insp__layers { grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: var(--s8); }
  }

  /* Pinned (class set by the motion script): the stage is one screen, under
     the 72px bar: the caption line, then the plan, capped so the exploded
     drawing (viewBox 440 tall plus 120 of travel) fits the remaining height. */
  .insp__stage:global(.is-pinned) {
    height: 100svh;
    align-content: center;
    row-gap: var(--s2);
    padding-block: calc(72px + var(--s2)) var(--s2);
  }
  .insp__stage:global(.is-pinned) .insp__plan {
    --plan-w: min(100vw, calc((100svh - 72px - var(--s12)) * 1160 / 560));
    padding-block: var(--s5);
  }
  @media (min-width: 768px) {
    .insp__stage:global(.is-pinned) .insp__plan {
      --plan-w: min(calc(100vw - 2 * var(--margin)), calc((100svh - 72px - var(--s12)) * 1160 / 560));
      padding-block: 0;
    }
  }
  .insp__stage:global(.is-pinned) .insp__caption {
    display: block;
    grid-column: 1 / -1;
    position: relative;
    height: var(--s4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .insp__stage:global(.is-pinned) .insp__caption li {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: baseline;
    gap: var(--s2);
    font-family: var(--font-mono);
    font-size: 1rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--bone);
  }

  /* ---- Work ------------------------------------------------------------------ */
  .work__head { row-gap: var(--s2); align-items: end; margin-bottom: var(--s6); }
  .work__all { grid-column: 1 / -1; justify-self: start; }
  .work__list { list-style: none; margin: 0; padding: 0; row-gap: var(--s6); }
  .card { grid-column: 1 / -1; }
  .card a { display: grid; gap: var(--s1); text-decoration: none !important; color: var(--bone) !important; }
  .card__media { display: block; margin-bottom: var(--s2); border: 1px solid var(--line); overflow: hidden; }
  .card__media img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1); }
  .card a:hover .card__media img { transform: scale(1.02); }
  .card__title { font-family: var(--font-display); font-weight: 800; font-size: 1.875rem; line-height: 1; }
  .card a:hover .card__title { color: var(--signal); }
  .card__meta { color: var(--signal); font-family: var(--font-mono); font-size: 0.8125rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .card__tagline { color: var(--slate); }
  @media (min-width: 768px) {
    .card { grid-column: span 4; }
  }
  @media (min-width: 1024px) {
    .work__head .h2 { grid-column: 1 / span 6; }
    .work__all { grid-column: 7 / span 6; justify-self: end; }
    .card { grid-column: span 4; }
  }

  /* ---- About ------------------------------------------------------------------- */
  .about__text { grid-column: 1 / -1; margin-top: var(--s3); }
  .about__text p { color: var(--slate); font-size: 1.125rem; max-width: 52ch; margin: 0 0 var(--s3); }
  .about__text p:last-child { margin-bottom: 0; }
  @media (min-width: 1024px) {
    .about__title { grid-column: 1 / span 4; }
    .about__text { grid-column: 7 / span 6; margin-top: 0; }
  }

  /* ---- Contact ------------------------------------------------------------------- */
  .contact__intro, .contact__reach { grid-column: 1 / -1; }
  .contact__title { font-size: clamp(2.75rem, 6vw, 5.5rem); font-weight: 900; line-height: 0.95; margin: 0; }
  .contact__lead { color: var(--slate); font-size: 1.125rem; max-width: 42ch; margin: var(--s3) 0 0; }
  .contact__reach { margin-top: var(--s5); }
  .contact__reach dl { margin: 0 0 var(--s4); border-top: 1px solid var(--line); }
  .contact__reach dl div { display: grid; grid-template-columns: 7rem 1fr; gap: var(--s2); padding-block: var(--s2); border-bottom: 1px solid var(--line); }
  .contact__reach dt { color: var(--slate-mute); font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; padding-top: 0.3em; }
  .contact__reach dd { margin: 0; overflow-wrap: anywhere; }
  @media (min-width: 1024px) {
    .contact .st-grid { align-items: end; }
    .contact__intro { grid-column: 1 / span 6; }
    .contact__reach { grid-column: 7 / span 6; margin-top: 0; }
  }
</style>
