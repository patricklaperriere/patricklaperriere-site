---
// The home page, both languages, in the studio direction.
//
// Everything is placed on one grid (4 / 8 / 12 columns, see studio.css) and
// one 8px rhythm. Two vertical alignments carry the page: column 1 for the
// main content and column 7 for secondary content; the portrait closes on the
// last column. All words and images are in the HTML: without JavaScript, or
// with reduced motion, this is the page. home-motion.ts adds soft fades on
// content below the fold and one pinned moment, the inspection.
import '../../styles/studio.css';
import { Picture } from 'astro:assets';
import { SITE } from '../../config';
import type { Locale } from '../../i18n/routes';
import { routes, workBase } from '../../i18n/routes';
import { homeCopy } from '../../i18n/home';
import { sortedProjects } from '../../data/projets';
import { PHOTO, PORTRAIT_WIDTHS } from '../../lib/photo';
import InspectionPlan from './InspectionPlan.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = homeCopy[locale];

// Habita is presented once, in the inspection; the list shows client work.
const work = (await sortedProjects()).filter((p) => !p.draft && p.slug !== 'habita');

const hrefs = {
  svcWeb: routes.svcWeb[locale],
  svcSeo: routes.svcSeo[locale],
  svcShopify: routes.svcShopify[locale],
  work: routes.work[locale],
  habitaCase: `${workBase[locale]}/habita`,
  habitaSite: SITE.company.url,
};
---

<div class="home">
  {/* ---- Hero ------------------------------------------------------------ */}
  <section class="hero st-frame" aria-labelledby="hero-title">
    <div class="st-grid hero__grid">
      <div class="hero__text">
        <p class="hero__name">{t.hero.name}</p>
        <h1 id="hero-title" class="hero__title">{t.hero.title}</h1>
        <p class="hero__lead">{t.hero.lead}</p>
        <p class="hero__actions">
          <a class="btn btn-primary" href={routes.contact[locale]}>{t.hero.cta}</a>
          <a class="hero__link" href="#travaux">{t.hero.secondary}</a>
        </p>
      </div>
      <figure class="hero__photo">
        <Picture
          src={PHOTO.portrait}
          formats={['avif', 'webp']}
          widths={PORTRAIT_WIDTHS}
          sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1023px) 34vw, 400px"
          alt={t.hero.portraitAlt}
          width={720}
          height={900}
          loading="eager"
        />
      </figure>
      <a class="hero__hint" href="#inspection">
        <span class="hero__hint-line" aria-hidden="true"></span>
        {t.hero.scroll}
      </a>
    </div>
  </section>

  {/* ---- Inspection: the one pinned moment -------------------------------- */}
  <section class="insp st-frame" id="inspection" aria-labelledby="insp-title">
    <header class="st-grid insp__head" data-reveal>
      <h2 id="insp-title" class="h2">{t.inspection.title}</h2>
      <p class="insp__intro">{t.inspection.intro}</p>
    </header>
    <div class="st-grid insp__stage" data-insp-stage>
      <div class="insp__plan">
        <InspectionPlan label={t.inspection.planLabel} />
      </div>
      <ol class="insp__layers">
        {t.inspection.layers.map((l, i) => (
          <li class="layer" data-layer-text>
            <p class="layer__name"><span class="layer__num">{i + 1}</span>{l.name}</p>
            <h3 class="layer__title">{l.title}</h3>
            <p class="layer__body">{l.body}</p>
            <p class="layer__links">
              {l.links.map((k) => (
                <a href={hrefs[k.key]} rel={k.key === 'habitaSite' ? 'noopener' : undefined}>{k.label}</a>
              ))}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ---- Work ------------------------------------------------------------------- */}
  <section class="work st-frame" id="travaux" aria-labelledby="work-title">
    <header class="st-grid work__head" data-reveal>
      <h2 id="work-title" class="h2">{t.work.title}</h2>
      <a class="work__all" href={routes.work[locale]}>{t.work.all}</a>
    </header>
    <ul class="st-grid work__list">
      {work.map((p) => (
        <li class="card" data-reveal>
          <a href={`${workBase[locale]}/${p.slug}`}>
            <span class="card__media">
              <img src={p.image} alt={t.work.shot(p.title[locale])} width="1280" height="800" loading="lazy" decoding="async" />
            </span>
            <span class="card__title">{p.title[locale]}</span>
            <span class="card__meta">{t.work.kinds[p.category]}, {p.year}</span>
            <span class="card__tagline">{p.tagline[locale]}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {/* ---- About -------------------------------------------------------------------- */}
  <section class="about st-frame" aria-labelledby="about-title">
    <div class="st-grid">
      <h2 id="about-title" class="h2 about__title" data-reveal>{t.about.title}</h2>
      <div class="about__text" data-reveal>
        {t.about.body.map((p) => <p>{p}</p>)}
        <p><a class="text-link" href={routes.about[locale]}>{t.about.more}</a></p>
      </div>
    </div>
  </section>

  {/* ---- Contact ------------------------------------------------------------------- */}
  <section class="contact st-frame" aria-labelledby="contact-title">
    <div class="st-grid">
      <div class="contact__intro" data-reveal>
        <h2 id="contact-title" class="contact__title">{t.contact.title}</h2>
        <p class="contact__lead">{t.contact.lead}</p>
      </div>
      <div class="contact__reach" data-reveal>
        <dl>
          <div>
            <dt>{t.contact.email}</dt>
            <dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
          </div>
          <div>
            <dt>{t.contact.phone}</dt>
            <dd><a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a></dd>
          </div>
        </dl>
        <a class="btn btn-primary" href={routes.contact[locale]}>{t.contact.cta}</a>
      </div>
    </div>
  </section>
</div>

<script>
  import '../../scripts/home-motion.ts';
</script>

<style>
  /* ---- Shared ---------------------------------------------------------------- */
  .home section { padding-block: var(--section); }
  .home section + section { border-top: 1px solid var(--line); }
  /* Titles take whole columns; their measure comes from the span, so both
     edges sit on column lines. */
  .h2 {
    grid-column: 1 / -1;
    font-size: clamp(2rem, 3.4vw, 3rem);
    line-height: 1.1;
  }
  @media (min-width: 768px) {
    .h2 { grid-column: 1 / span 6; }
  }
  .home a:not(.btn) {
    color: var(--bone);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    transition: text-decoration-color 0.2s ease;
  }
  .home a:not(.btn):hover { text-decoration-color: var(--signal); }

  /* ---- Hero ---------------------------------------------------------------- */
  .home .hero { padding-block: var(--s6) var(--s4); }
  .hero__grid { row-gap: var(--s6); align-items: center; }
  .hero__text, .hero__photo, .hero__hint { grid-column: 1 / -1; }
  .hero__name { color: var(--slate); font-size: 1rem; margin: 0 0 var(--s3); }
  .hero__title {
    font-size: clamp(2.25rem, 4.6vw, 4rem);
    line-height: 1.08;
    max-width: 17ch;
    margin: 0;
  }
  .hero__lead {
    color: var(--slate);
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.6;
    max-width: 44ch;
    margin: var(--s4) 0 var(--s5);
  }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s2) var(--s4); margin: 0; }
  .hero__photo { margin: 0; }
  .hero__photo :global(picture) { display: block; }
  .hero__photo :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; }
  .hero__hint {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    justify-self: start;
    min-height: 44px;
    color: var(--slate-mute) !important;
    font-size: 0.875rem;
    text-decoration: none !important;
  }
  .hero__hint-line { width: var(--s5); height: 1px; background: var(--line-strong); }
  .hero__hint:hover .hero__hint-line { background: var(--signal); }

  @media (min-width: 768px) {
    .hero__text { grid-column: 1 / span 5; }
    .hero__photo { grid-column: 6 / span 3; }
  }
  @media (min-width: 1024px) {
    .home .hero {
      /* Fills the first screen under the 72px bar, without a void: content
         centred, the scroll hint on the last line. */
      min-height: min(calc(100svh - 72px), 820px);
      display: grid;
      align-content: center;
      padding-block: var(--s8) var(--s4);
    }
    .hero__text { grid-column: 1 / span 7; }
    .hero__photo { grid-column: 9 / span 4; }
  }

  /* ---- Inspection ---------------------------------------------------------- */
  .insp__head { row-gap: var(--s3); margin-bottom: var(--s8); }
  .insp__intro { grid-column: 1 / -1; color: var(--slate); font-size: 1.125rem; margin: 0; }
  @media (min-width: 768px) {
    .insp__intro { grid-column: 1 / span 6; }
  }
  .insp__stage { row-gap: var(--s6); align-items: center; }
  .insp__plan, .insp__layers { grid-column: 1 / -1; }
  .insp__layers { list-style: none; margin: 0; padding: 0; display: grid; row-gap: var(--s6); }
  .layer__name {
    display: flex;
    align-items: center;
    gap: var(--s2);
    color: var(--slate);
    font-size: 0.9375rem;
    margin: 0 0 var(--s2);
  }
  .layer__num {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border: 1px solid var(--slate-mute);
    border-radius: 50%;
    font-size: 0.8125rem;
    color: var(--slate);
  }
  .layer__title { font-size: clamp(1.5rem, 2.2vw, 1.875rem); line-height: 1.15; margin: 0; max-width: 20ch; }
  .layer__body { color: var(--slate); margin: var(--s2) 0 var(--s3); max-width: 44ch; }
  .layer__links { display: flex; flex-wrap: wrap; gap: var(--s1) var(--s3); margin: 0; }
  @media (min-width: 1024px) {
    .insp__head .h2 { grid-column: 1 / span 6; }
    .insp__intro { grid-column: 1 / span 5; }
    .insp__plan { grid-column: 1 / span 6; }
    .insp__layers { grid-column: 8 / span 5; }
  }

  /* Pinned (class set by the motion script): the layers stack in place and
     take turns, the drawing beside them. */
  .insp__stage:global(.is-pinned) {
    height: 100svh;
    align-content: center;
    padding-block: var(--s10) var(--s4);
  }
  .insp__stage:global(.is-pinned) .insp__plan { max-width: min(100%, 44svh * 1.08); }
  .insp__stage:global(.is-pinned) .insp__layers { display: block; position: relative; min-height: 15rem; }
  .insp__stage:global(.is-pinned) .layer { position: absolute; inset: 0 0 auto 0; }
  @media (min-width: 1024px) {
    .insp__stage:global(.is-pinned) { padding-block: var(--s8); }
    .insp__stage:global(.is-pinned) .insp__plan { max-width: none; }
    .insp__stage:global(.is-pinned) .insp__layers { min-height: 20rem; }
  }

  /* ---- Work ------------------------------------------------------------------ */
  .work__head { row-gap: var(--s2); align-items: end; margin-bottom: var(--s8); }
  .work__all { grid-column: 1 / -1; justify-self: start; }
  .work__list { list-style: none; margin: 0; padding: 0; row-gap: var(--s8); }
  .card { grid-column: 1 / -1; }
  .card a { display: grid; gap: var(--s1); text-decoration: none !important; color: var(--bone); }
  .card__media { display: block; margin-bottom: var(--s2); border: 1px solid var(--line); overflow: hidden; }
  .card__media img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1); }
  .card a:hover .card__media img { transform: scale(1.02); }
  .card__title { font-family: var(--font-display); font-size: 1.5rem; line-height: 1.2; }
  .card a:hover .card__title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; text-decoration-color: var(--signal); }
  .card__meta { color: var(--slate-mute); font-size: 0.9375rem; }
  .card__tagline { color: var(--slate); }
  @media (min-width: 768px) {
    .card { grid-column: span 4; }
  }
  @media (min-width: 1024px) {
    .work__head .h2 { grid-column: 1 / span 6; }
    .work__all { grid-column: 7 / span 6; justify-self: end; }
    .card { grid-column: span 4; }
  }

  /* ---- About ------------------------------------------------------------------- */
  .about__text { grid-column: 1 / -1; margin-top: var(--s4); }
  .about__text p { color: var(--slate); font-size: 1.125rem; max-width: 52ch; margin: 0 0 var(--s3); }
  .about__text p:last-child { margin-bottom: 0; }
  @media (min-width: 1024px) {
    .about__title { grid-column: 1 / span 4; }
    .about__text { grid-column: 7 / span 6; margin-top: 0; }
  }

  /* ---- Contact ------------------------------------------------------------------- */
  .contact__intro, .contact__reach { grid-column: 1 / -1; }
  .contact__title { font-size: clamp(2.25rem, 5vw, 4.25rem); line-height: 1.05; max-width: 14ch; margin: 0; }
  .contact__lead { color: var(--slate); font-size: 1.125rem; max-width: 42ch; margin: var(--s3) 0 0; }
  .contact__reach { margin-top: var(--s6); }
  .contact__reach dl { margin: 0 0 var(--s5); border-top: 1px solid var(--line); }
  .contact__reach dl div { display: grid; grid-template-columns: 7rem 1fr; gap: var(--s2); padding-block: var(--s2); border-bottom: 1px solid var(--line); }
  .contact__reach dt { color: var(--slate-mute); font-size: 0.9375rem; }
  .contact__reach dd { margin: 0; overflow-wrap: anywhere; }
  @media (min-width: 1024px) {
    .contact .st-grid { align-items: end; }
    .contact__intro { grid-column: 1 / span 6; }
    .contact__reach { grid-column: 7 / span 6; margin-top: 0; }
  }
</style>
