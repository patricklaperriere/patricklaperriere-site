---
// The home page, both languages. Plain, readable HTML first: every word and
// image is here without JavaScript, and that is exactly what a visitor with
// reduced motion gets. home-motion.ts adds three scroll moments on top: the
// house plan drawn layer by layer (pinned), the desk photo uncovered, and the
// contact address circled by hand.
import { Picture } from 'astro:assets';
import { SITE } from '../../config';
import type { Locale } from '../../i18n/routes';
import { routes, workBase } from '../../i18n/routes';
import { homeCopy } from '../../i18n/home';
import { sortedProjects } from '../../data/projets';
import { PHOTO, PORTRAIT_WIDTHS } from '../../lib/photo';
import { prng, sketchArrow, sketchCircle } from '../../lib/sketch';
import desk from '../../assets/photo/poste-de-travail.jpg';
import HousePlan from './HousePlan.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = homeCopy[locale];

const work = (await sortedProjects()).filter((p) => !p.draft && p.slug !== 'habita');

const linkFor = (key: string) =>
  ({
    svcWeb: routes.svcWeb[locale],
    work: routes.work[locale],
    habitaCase: `${workBase[locale]}/habita`,
    habitaSite: SITE.company.url,
  })[key] ?? routes.contact[locale];

const rand = prng(42);
const heroArrow = sketchArrow([30, 12], [96, 70], rand, -0.3);
const circle = sketchCircle(200, 40, 196, 34, rand);
const habitaArrows = [sketchArrow([12, 30], [70, 6], rand, 0.2), sketchArrow([12, 10], [64, 44], rand, -0.2)];
---

<div class="home">
  {/* ---- Hero ------------------------------------------------------------ */}
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__text">
      <h1 id="hero-title" class="hero__title">{t.hero.title}</h1>
      <p class="hero__lead">{t.hero.lead}</p>
      <p class="hero__actions">
        <a class="btn" href={routes.contact[locale]}>{t.hero.cta}</a>
        <a class="hero__more" href="#travaux">{t.hero.secondary}</a>
      </p>
    </div>
    <figure class="hero__photo">
      <Picture
        src={PHOTO.portrait}
        formats={['avif', 'webp']}
        widths={PORTRAIT_WIDTHS}
        sizes="(max-width: 860px) 78vw, 30vw"
        alt={t.hero.portraitAlt}
        width={720}
        height={900}
        loading="eager"
        fetchpriority="high"
      />
      <figcaption class="hero__note" aria-hidden="true">
        <span>{t.hero.note}</span>
        <svg viewBox="0 0 110 80">{heroArrow.map((d) => <path d={d} />)}</svg>
      </figcaption>
    </figure>
  </section>

  {/* ---- Inspection (moment 1) -------------------------------------------- */}
  <section class="scan" aria-labelledby="scan-title" data-scan-section>
    <header class="scan__head">
      <h2 id="scan-title" class="section-title">{t.scan.title}</h2>
      <p class="scan__intro">{t.scan.intro}</p>
    </header>
    <div class="scan__stage" data-scan-stage>
      <div class="scan__plan">
        <HousePlan label={t.scan.planLabel} notes={t.scan.layers} scanning={t.scan.scanning} />
      </div>
      <ol class="scan__chapters">
        {t.scan.layers.map((l) => (
          <li class="chapter">
            <h3 class="chapter__title">{l.title}</h3>
            <p class="chapter__body">{l.body}</p>
            <p class="chapter__links">
              {l.links.map((k) => <a href={linkFor(k.key)}>{k.label}</a>)}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ---- Work --------------------------------------------------------------- */}
  <section class="work" id="travaux" aria-labelledby="work-title">
    <h2 id="work-title" class="section-title">{t.work.title}</h2>
    <ul class="work__list">
      {work.map((p) => (
        <li class="work__item">
          <a href={`${workBase[locale]}/${p.slug}`}>
            <img src={p.image} alt={t.work.shot(p.title[locale])} width="1280" height="800" loading="lazy" decoding="async" />
            <span class="work__title">{p.title[locale]}</span>
            <span class="work__meta">{t.work.kinds[p.category]}, {p.year}</span>
            <span class="work__tagline">{p.tagline[locale]}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="work__all"><a href={routes.work[locale]}>{t.work.all}</a></p>
  </section>

  {/* ---- Habita ------------------------------------------------------------- */}
  <section class="habita" aria-labelledby="habita-title" data-surface="paper">
    <div class="habita__text">
      <h2 id="habita-title" class="section-title">{t.habita.title}</h2>
      <p>{t.habita.body}</p>
      <p class="habita__links">
        <a href={`${workBase[locale]}/habita`}>{t.habita.case}</a>
        <a href={SITE.company.url} rel="noopener">{t.habita.site}</a>
      </p>
    </div>
    <figure class="habita__shot">
      <img src="/work/habita.webp" alt={t.habita.shotAlt} width="1300" height="794" loading="lazy" decoding="async" />
      <figcaption aria-hidden="true">
        {t.habita.notes.map((n, i) => (
          <span class:list={['habita__note', `habita__note--${i}`]}>
            {n}
            <svg viewBox="0 0 80 50">{habitaArrows[i].map((d) => <path d={d} />)}</svg>
          </span>
        ))}
      </figcaption>
    </figure>
  </section>

  {/* ---- About, with the desk (moment 2) ----------------------------------------- */}
  <section class="about" aria-labelledby="about-title">
    <figure class="desk" data-desk>
      <div class="desk__frame">
        <Picture
          src={desk}
          formats={['avif', 'webp']}
          widths={[480, 800, 1200, 1600, 2000]}
          sizes="(max-width: 1560px) 100vw, 1560px"
          alt={t.about.deskAlt}
          loading="lazy"
        />
        <span class="desk__curtain desk__curtain--l" aria-hidden="true"></span>
        <span class="desk__curtain desk__curtain--r" aria-hidden="true"></span>
      </div>
      <figcaption class="desk__note">{t.about.deskNote}</figcaption>
    </figure>
    <div class="about__text">
      <h2 id="about-title" class="section-title">{t.about.title}</h2>
      {t.about.body.map((p) => <p>{p}</p>)}
      <p><a href={routes.about[locale]}>{t.about.more}</a></p>
    </div>
  </section>

  {/* ---- Contact (moment 3) ----------------------------------------------------- */}
  <section class="contact" aria-labelledby="contact-title" data-contact>
    <h2 id="contact-title" class="contact__title">{t.contact.title}</h2>
    <p class="contact__lead">{t.contact.lead}</p>
    <p class="contact__mail">
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <svg class="contact__circle" viewBox="0 0 400 80" preserveAspectRatio="none" aria-hidden="true">
        <path d={circle} data-circle />
      </svg>
    </p>
    <p class="contact__phone">{t.contact.or} <a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a></p>
    <a class="btn" href={routes.contact[locale]}>{t.contact.cta}</a>
  </section>
</div>

<style>
  .home {
    --pad: var(--gutter);
  }
  .home > section {
    padding: clamp(4rem, 9vw, 8rem) var(--pad);
    max-width: var(--w-wide);
    margin-inline: auto;
  }
  .section-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 4.6vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    max-width: 20ch;
    margin: 0;
  }
  .home a:not(.btn) {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--note);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.22em;
  }
  .home a:not(.btn):hover { text-decoration-color: currentColor; }

  /* ---- Hero ---- */
  .hero {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
    padding-top: clamp(6.5rem, 12vw, 9rem) !important;
  }
  .hero__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.4rem, 6.2vw, 5.4rem);
    line-height: 1.02;
    letter-spacing: -0.015em;
    max-width: 14ch;
    margin: 0;
  }
  .hero__lead {
    font-size: clamp(1.1rem, 1.6vw, 1.35rem);
    line-height: 1.6;
    color: var(--fg-dim);
    max-width: 44ch;
    margin: 1.75rem 0 2.25rem;
  }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; margin: 0; }
  .hero__photo { position: relative; margin: 0; justify-self: center; width: min(100%, 26rem); }
  .hero__photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line-strong);
    transform: rotate(-1.2deg);
    filter: contrast(1.06) saturate(0.92);
  }
  .hero__note {
    position: absolute;
    left: -1.5rem;
    top: -2.6rem;
    display: flex;
    align-items: flex-start;
    gap: 0.25rem;
    font-family: var(--font-hand);
    font-size: 1.35rem;
    color: var(--note);
    transform: rotate(-4deg);
  }
  .hero__note svg { width: 4.6rem; height: auto; margin-top: 0.6rem; overflow: visible; }
  .hero__note path, .habita__note path { fill: none; stroke: var(--note); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  @media (min-width: 860px) {
    .hero { grid-template-columns: 7fr 5fr; }
    .hero__note { left: -5.5rem; top: 2rem; flex-direction: column; align-items: flex-end; }
    .hero__note svg { transform: scaleX(-1) rotate(-30deg); margin: 0.25rem 1.5rem 0 0; }
  }
  @media (max-width: 859px) {
    .hero__photo { width: min(78vw, 22rem); margin-top: 2.5rem; }
  }
  /* The one load moment, CSS only: the arrow is drawn once. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__note path { stroke-dasharray: 200; stroke-dashoffset: 200; animation: draw 1.1s 0.6s ease-out forwards; }
    @keyframes draw { to { stroke-dashoffset: 0; } }
  }

  /* ---- Inspection ---- */
  .scan__head { margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .scan__intro { color: var(--fg-dim); font-size: 1.15rem; margin: 1rem 0 0; max-width: 46ch; }
  .scan__stage { display: grid; gap: clamp(2.5rem, 5vw, 4rem); align-items: center; }
  .scan__plan { width: 100%; max-width: 44rem; }
  .scan__chapters { list-style: none; margin: 0; padding: 0; display: grid; gap: 2.75rem; }
  .chapter__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.12;
    max-width: 20ch;
    margin: 0;
  }
  .chapter__body { color: var(--fg-dim); margin: 1rem 0; max-width: 44ch; }
  .chapter__links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin: 0; }
  @media (min-width: 960px) { .scan__stage { grid-template-columns: 7fr 5fr; } }

  /* Pinned (set by home-motion.ts): chapters stack and swap in place. */
  .scan__stage:global(.is-pinned) {
    height: 100svh;
    padding-block: 4.5rem 1.5rem;
    grid-template-rows: auto 1fr;
    gap: 1.25rem;
    align-items: start;
  }
  .scan__stage:global(.is-pinned) .scan__plan { max-width: min(44rem, 52svh * 1.28); justify-self: center; }
  .scan__stage:global(.is-pinned) .scan__chapters { display: block; position: relative; }
  .scan__stage:global(.is-pinned) .chapter { position: absolute; inset: 0 0 auto 0; }
  .scan__stage:global(.is-pinned) :global(.plan__scan) { display: inline; }
  @media (min-width: 960px) {
    .scan__stage:global(.is-pinned) { grid-template-rows: 1fr; align-items: center; padding-block: 0; }
    .scan__stage:global(.is-pinned) .scan__plan { max-width: min(44rem, 72svh * 1.28); }
    .scan__stage:global(.is-pinned) .scan__chapters { min-height: 20rem; }
  }

  /* ---- Work ---- */
  .work__list {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    display: grid;
    gap: clamp(3rem, 6vw, 4.5rem) clamp(2rem, 4vw, 3.5rem);
  }
  .work__item a { display: grid; gap: 0.35rem; text-decoration: none !important; }
  .work__item img {
    width: 100%;
    height: auto;
    border: 1px solid var(--line-strong);
    margin-bottom: 0.9rem;
    filter: contrast(1.05) saturate(0.9);
  }
  .work__title { font-family: var(--font-display); font-size: clamp(1.5rem, 2.6vw, 2.1rem); line-height: 1.1; }
  .work__item a:hover .work__title { text-decoration: underline; text-decoration-color: var(--note); text-underline-offset: 0.18em; }
  .work__meta { color: var(--note); font-family: var(--font-hand); font-size: 1.1rem; }
  .work__tagline { color: var(--fg-dim); max-width: 46ch; }
  .work__all { margin-top: 3rem; }
  @media (min-width: 860px) {
    .work__list { grid-template-columns: 1fr 1fr; }
    .work__item:first-child { grid-column: 1 / -1; }
    .work__item:first-child img { max-height: 38rem; object-fit: cover; object-position: top; }
  }

  /* ---- Habita (on paper) ---- */
  .home > .habita { max-width: none; display: grid; gap: clamp(2.5rem, 5vw, 4rem); align-items: center; }
  .habita__text p { max-width: 46ch; color: var(--fg-dim); }
  .habita__text .section-title + p { margin-top: 1.25rem; color: var(--fg); font-size: 1.15rem; }
  .habita__links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.75rem; }
  .habita__shot { position: relative; margin: 0; }
  .habita__shot img { width: 100%; height: auto; }
  .habita__note {
    position: absolute;
    display: flex;
    align-items: flex-end;
    gap: 0.2rem;
    font-family: var(--font-hand);
    font-size: 1.15rem;
    color: var(--note);
    white-space: nowrap;
  }
  .habita__note svg { width: 3.5rem; height: auto; overflow: visible; }
  .habita__note--0 { left: 2%; top: -1.6rem; }
  .habita__note--1 { right: 2%; bottom: -1.2rem; flex-direction: row-reverse; }
  .habita__note--1 svg { transform: scaleX(-1); }
  @media (min-width: 960px) {
    .home > .habita { grid-template-columns: 5fr 7fr; padding-inline: max(var(--pad), calc((100vw - var(--w-wide)) / 2 + var(--pad))); }
  }

  /* ---- About + desk ---- */
  .about { display: grid; gap: clamp(2rem, 4vw, 3rem); }
  .desk { margin: 0; }
  .desk__frame { position: relative; overflow: hidden; border: 1px solid var(--line-strong); }
  .desk__frame :global(img) { display: block; width: 100%; height: auto; filter: contrast(1.08) saturate(0.9); }
  .desk__curtain { display: none; position: absolute; top: 0; bottom: 0; width: 50.5%; background: var(--bg); will-change: transform; }
  .desk__curtain--l { left: 0; }
  .desk__curtain--r { right: 0; }
  .desk__note { font-family: var(--font-hand); color: var(--note); font-size: 1.2rem; margin-top: 0.75rem; transform: rotate(-1deg); }
  .about__text p { max-width: 52ch; color: var(--fg-dim); }
  .about__text .section-title + p { margin-top: 1.5rem; }
  @media (min-width: 960px) {
    .about__text { display: grid; grid-template-columns: 5fr 7fr; column-gap: 4rem; align-items: start; }
    .about__text .section-title { grid-row: span 3; }
    .about__text .section-title + p { margin-top: 0; }
  }

  /* ---- Contact ---- */
  .contact { border-top: 1px solid var(--line); }
  .contact__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.8rem, 9vw, 7.5rem);
    line-height: 1;
    margin: 0;
  }
  .contact__lead { color: var(--fg-dim); max-width: 44ch; font-size: 1.15rem; margin: 1.5rem 0 2.5rem; }
  .contact__mail { position: relative; display: inline-block; margin: 0 0 1rem; font-size: clamp(1.25rem, 4vw, 2.6rem); font-family: var(--font-display); overflow-wrap: anywhere; }
  .contact__mail a { text-decoration: none !important; }
  .contact__circle { position: absolute; inset: -32% -7%; width: 114%; height: 164%; overflow: visible; pointer-events: none; }
  @media (max-width: 480px) { .contact__circle { inset: -32% -1.5%; width: 103%; } }
  .contact__circle path { fill: none; stroke: var(--note); stroke-width: 2; vector-effect: non-scaling-stroke; stroke-linecap: round; }
  .contact__phone { color: var(--fg-dim); margin: 0 0 2.5rem; }
</style>
