---
// A house in section, drawn as a fine-line plan: roof, structure, foundations.
//
// Each layer is drawn twice: a quiet base line that is always there, and a
// trace that the home page draws in, in the accent colour, while that layer
// is being "inspected". Without motion the trace is simply complete. Numbered
// markers (1, 2, 3) tie each layer to its text, which is in the HTML beside
// the drawing, so the SVG is one image with one label.
interface Props {
  label: string;
}
const { label } = Astro.props;

// Roof slopes: outer line from (40,220) to the ridge (280,60) and back.
const k = 160 / 240;
const right = (x: number) => 60 + (x - 280) * k;
const r = (n: number) => Math.round(n * 10) / 10;

const hatch = Array.from({ length: 10 }, (_, i) => 92 + i * 40).map((x) => `M${x} 476 L${x + 24} 444`);

const layers = [
  {
    id: 'toiture',
    marker: [536, 124],
    lead: `M440 ${r(right(440))} L524 124`,
    paths: [
      'M40 220 L280 60 L520 220',
      'M72 220 L280 81.3 L488 220',
      `M380 ${r(right(380))} V92 H410 V${r(right(410))}`,
      'M40 220 H520',
    ],
  },
  {
    id: 'structure',
    marker: [536, 300],
    lead: 'M488 300 H524',
    paths: [
      'M72 220 V420',
      'M488 220 V420',
      'M72 320 H488',
      'M110 252 H180 V300 H110 Z',
      'M380 252 H450 V300 H380 Z',
      'M380 352 H450 V400 H380 Z',
      'M250 420 V350 H310 V420',
    ],
  },
  {
    id: 'fondations',
    marker: [536, 462],
    lead: 'M488 462 H524',
    paths: [
      'M16 420 H544',
      'M72 420 V480 H488 V420',
      'M56 480 H504 V500 H56 Z',
      ...hatch,
    ],
  },
];
---

<svg class="iplan" viewBox="0 0 560 520" role="img" aria-label={label} data-plan>
  {layers.map((l, i) => (
    <g class="iplan__layer" data-layer={l.id}>
      <g class="iplan__base">{l.paths.map((d) => <path d={d} />)}</g>
      <g class="iplan__trace" data-trace>{l.paths.map((d) => <path d={d} />)}</g>
      <g class="iplan__marker" data-marker aria-hidden="true">
        <path class="iplan__lead" d={l.lead} />
        <circle cx={l.marker[0]} cy={l.marker[1]} r="12" />
        <text x={l.marker[0]} y={l.marker[1]}>{i + 1}</text>
      </g>
    </g>
  ))}
</svg>

<style>
  .iplan { display: block; width: 100%; height: auto; overflow: visible; }
  .iplan path,
  .iplan circle {
    fill: none;
    stroke-linecap: square;
    vector-effect: non-scaling-stroke;
  }
  .iplan__base path { stroke: var(--line-strong); stroke-width: 1px; }
  .iplan__trace path { stroke: var(--bone); stroke-width: 1.25px; }
  .iplan__lead { stroke: var(--line-strong); stroke-width: 1px; }
  .iplan circle { stroke: var(--slate-mute); stroke-width: 1px; }
  .iplan text {
    font-family: var(--font-sans);
    font-size: 13px;
    fill: var(--slate);
    text-anchor: middle;
    dominant-baseline: central;
  }
</style>
