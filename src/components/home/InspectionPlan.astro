---
// A house in section, drawn as a plan: roof, structure, foundations.
//
// Each layer is its own group so the home page can pull the drawing apart
// into an exploded view while it inspects one layer at a time. A layer has:
//   · a flat mauve wash (foundations: a dot screen) that lights up when active;
//   · a quiet base line, always there;
//   · a trace over it that gets drawn in the accent while inspected;
//   · a dimension line on the left and a mono annotation on the right.
// Without motion, everything is simply in place and complete.
interface Props {
  label: string;
  names: string[];
}
const { label, names } = Astro.props;

// Roof slope on the right side, outer line from the ridge (340,80) to (580,240).
const right = (x: number) => 80 + (x - 340) * (160 / 240);
const r = (n: number) => Math.round(n * 10) / 10;

type Layer = {
  id: string;
  fill: string;
  dots?: boolean;
  paths: string[];
  cote: [number, number];
  lead: string;
  labelY: number;
};

const layers: Layer[] = [
  {
    id: 'toiture',
    fill: 'M100 240 L340 80 L580 240 Z',
    paths: [
      'M100 240 L340 80 L580 240',
      'M132 240 L340 101.3 L548 240',
      `M440 ${r(right(440))} V112 H470 V${r(right(470))}`,
      'M100 240 H580',
    ],
    cote: [80, 240],
    lead: `M520 ${r(right(520))} H600`,
    labelY: 200,
  },
  {
    id: 'structure',
    fill: 'M132 240 H548 V440 H132 Z',
    paths: [
      'M132 240 V440',
      'M548 240 V440',
      'M132 340 H548',
      'M170 272 H240 V320 H170 Z',
      'M440 272 H510 V320 H440 Z',
      'M440 372 H510 V420 H440 Z',
      'M310 440 V370 H370 V440',
    ],
    cote: [240, 440],
    lead: 'M548 340 H600',
    labelY: 340,
  },
  {
    id: 'fondations',
    fill: 'M132 440 H548 V500 H564 V520 H116 V500 H132 Z',
    dots: true,
    paths: [
      'M60 440 H620',
      'M132 440 V500 H548 V440',
      'M116 500 H564 V520 H116 Z',
    ],
    cote: [440, 520],
    lead: 'M548 480 H600',
    labelY: 480,
  },
];
---

<svg class="iplan" viewBox="0 0 720 548" role="img" aria-label={label} data-plan>
  <defs>
    <pattern id="iplan-dots" width="10" height="10" patternUnits="userSpaceOnUse">
      <circle cx="5" cy="5" r="1.4" />
    </pattern>
  </defs>
  <g class="iplan__body" data-plan-body>
    {layers.map((l, i) => (
      <g class="iplan__layer" data-layer={l.id}>
        <path class:list={['iplan__fill', l.dots && 'iplan__fill--dots']} d={l.fill} data-fill />
        <g class="iplan__base">{l.paths.map((d) => <path d={d} />)}</g>
        <g class="iplan__trace" data-trace>{l.paths.map((d) => <path d={d} />)}</g>
        <g class="iplan__cote" aria-hidden="true">
          <path d={`M44 ${l.cote[0] + 4} V${l.cote[1] - 4}`} />
          <path d={`M36 ${l.cote[0]} H52 M36 ${l.cote[1]} H52`} />
        </g>
        <g class="iplan__note" data-note aria-hidden="true">
          <path class="iplan__lead" d={l.lead} />
          <text class="iplan__num" x="612" y={l.labelY - 4}>{String(i + 1).padStart(2, '0')}</text>
          <text class="iplan__name" x="612" y={l.labelY + 22}>{names[i]}</text>
        </g>
      </g>
    ))}
  </g>
</svg>

<style>
  .iplan { display: block; width: 100%; height: auto; overflow: visible; }
  .iplan path { fill: none; stroke-linecap: square; vector-effect: non-scaling-stroke; }

  .iplan__fill { fill: var(--mauve-wash) !important; stroke: none; opacity: 1; }
  .iplan__fill--dots { fill: url(#iplan-dots) !important; }
  .iplan pattern circle { fill: var(--mauve-light); opacity: 0.45; }

  .iplan__base path { stroke: rgba(243, 236, 240, 0.5); stroke-width: 1.25px; }
  .iplan__trace path { stroke: var(--bone); stroke-width: 2px; }
  .iplan__cote path, .iplan__lead { stroke: var(--slate-mute); stroke-width: 1px; }

  .iplan text { font-family: var(--font-mono); fill: var(--slate); }
  .iplan__num { font-size: 30px; font-weight: 500; fill: var(--bone); }
  .iplan__name { font-size: 17px; letter-spacing: 0.08em; text-transform: uppercase; }

  @media (min-width: 1024px) {
    .iplan__base path { stroke: rgba(243, 236, 240, 0.34); }
  }
  /* Narrow screens: the names would fall under 9px; the numbers stay, and the
     text beside the plan carries the names. */
  @media (max-width: 559px) {
    .iplan__name { display: none; }
  }
</style>
