---
// A house in section, drawn as a plan: roof, structure, foundations.
//
// Drawn wide and low (a long bungalow section, about 2.6:1) so that, even
// pulled apart into an exploded view, it can span nearly the whole screen
// width and still fit one pinned viewport. Each layer is its own group:
//   · a flat mauve wash (foundations: a dot screen) that lights up when active;
//   · a quiet base line, always there;
//   · a trace over it, drawn in the accent while inspected;
//   · its stretch of the dimension line on the left, with its number.
// The layer names are in the HTML (a caption above the plan while pinned, and
// the texts after it). Without motion, everything is in place and complete.
interface Props {
  label: string;
}
const { label } = Astro.props;

// Roof: outer line from (60,230) up to the ridge (590,80), down to (1120,230).
const k = 150 / 530;
const right = (x: number) => 80 + (x - 590) * k;
const r = (n: number) => Math.round(n * 10) / 10;

type Layer = { id: string; fill: string; dots?: boolean; paths: string[]; cote: [number, number] };

const windows = [160, 330, 690, 860].flatMap((x) =>
  [252, 340].map((y) => `M${x} ${y} H${x + 120} V${y + 46} H${x} Z`),
);

const layers: Layer[] = [
  {
    id: 'toiture',
    fill: 'M60 230 L590 80 L1120 230 Z',
    paths: [
      'M60 230 L590 80 L1120 230',
      'M100 230 L590 102 L1080 230',
      `M820 ${r(right(820))} V100 H860 V${r(right(860))}`,
      'M60 230 H1120',
    ],
    cote: [80, 230],
  },
  {
    id: 'structure',
    fill: 'M100 230 H1080 V410 H100 Z',
    paths: ['M100 230 V410', 'M1080 230 V410', 'M100 320 H1080', ...windows, 'M560 410 V340 H620 V410'],
    cote: [230, 410],
  },
  {
    id: 'fondations',
    fill: 'M100 410 H1080 V465 H1100 V485 H80 V465 H100 Z',
    dots: true,
    paths: ['M40 410 H1150', 'M100 410 V465 H1080 V410', 'M80 465 H1100 V485 H80 Z'],
    cote: [410, 485],
  },
];
---

<svg class="iplan" viewBox="0 60 1160 440" role="img" aria-label={label} data-plan>
  <defs>
    <pattern id="iplan-dots" width="11" height="11" patternUnits="userSpaceOnUse">
      <circle cx="5.5" cy="5.5" r="1.5" />
    </pattern>
  </defs>
  <g class="iplan__body" data-plan-body>
    {layers.map((l, i) => (
      <g class="iplan__layer" data-layer={l.id}>
        <path class:list={['iplan__fill', l.dots && 'iplan__fill--dots']} d={l.fill} data-fill />
        <g class="iplan__base">{l.paths.map((d) => <path d={d} />)}</g>
        <g class="iplan__trace" data-trace>{l.paths.map((d) => <path d={d} />)}</g>
        <g class="iplan__cote" data-note aria-hidden="true">
          <path d={`M44 ${l.cote[0] + 4} V${l.cote[1] - 4}`} />
          <path d={`M36 ${l.cote[0]} H52 M36 ${l.cote[1]} H52`} />
          <text x="30" y={(l.cote[0] + l.cote[1]) / 2}>{String(i + 1).padStart(2, '0')}</text>
        </g>
      </g>
    ))}
  </g>
</svg>

<style>
  .iplan { display: block; width: 100%; height: auto; overflow: visible; }
  .iplan path { fill: none; stroke-linecap: square; vector-effect: non-scaling-stroke; }

  .iplan__fill { fill: var(--mauve-wash) !important; stroke: none; opacity: 1; }
  .iplan__fill--dots { fill: url(#iplan-dots) !important; }
  .iplan pattern circle { fill: var(--mauve-light); opacity: 0.45; }

  .iplan__base path { stroke: rgba(243, 236, 240, 0.5); stroke-width: 1.25px; }
  .iplan__trace path { stroke: var(--bone); stroke-width: 2px; }
  .iplan__cote path { stroke: var(--slate-mute); stroke-width: 1px; }
  .iplan__cote text {
    font-family: var(--font-mono);
    font-size: 24px;
    font-weight: 500;
    fill: var(--mauve-light);
    text-anchor: end;
    dominant-baseline: central;
  }

  @media (min-width: 1024px) {
    .iplan__base path { stroke: rgba(243, 236, 240, 0.36); }
  }
</style>
