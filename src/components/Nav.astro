---
import { useTranslations, path } from '../i18n';
import type { Locale } from '../i18n/routes';
import { SITE } from '../config';

interface Props {
  locale: Locale;
  /** Equivalent path in the other language (for the language switcher). */
  alt: string;
}

const { locale, alt } = Astro.props;
const tr = useTranslations(locale);

const links = [
  { href: path('services', locale), label: tr.nav.services },
  { href: path('work', locale), label: tr.nav.work },
  { href: path('about', locale), label: tr.nav.about },
  { href: path('blog', locale), label: tr.nav.blog },
];

const home = path('home', locale);
const contact = path('contact', locale);
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href.replace(/\/$/, '') || '/') === current;
---

<header class="nav">
  <div class="container-pl nav__inner">
    <a href={home} class="nav__logo magnetic" data-magnetic="0.25">
      <span class="nav__mono">PL</span>
      <span class="sr-only">{tr.brand}</span>
    </a>

    <nav class="nav__links" aria-label={tr.ariaPrimaryNav}>
      {links.map((l) => (
        <a href={l.href} class:list={['nav__link', isActive(l.href) && 'is-active']}>
          {l.label}
        </a>
      ))}
    </nav>

    <div class="nav__actions">
      <a href={`tel:${SITE.phone}`} class="nav__phone" aria-label={`${locale === 'fr' ? 'Appeler' : 'Call'} ${SITE.phoneDisplay}`}>
        <svg class="nav__phone-ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        <span>{SITE.phoneDisplay}</span>
      </a>
      <a href={alt} class="nav__lang" hreflang={locale === 'fr' ? 'en-CA' : 'fr-CA'} aria-label={tr.switchToLabel}>
        {tr.switchTo}
      </a>
      <a href={contact} class="btn btn-primary nav__cta magnetic" data-magnetic="0.2">
        {tr.cta.primary}
      </a>
      <button class="nav__burger" id="nav-burger" aria-label="Menu" aria-expanded="false" aria-controls="nav-mobile">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="nav__mobile" id="nav-mobile" hidden>
    {links.map((l) => <a href={l.href} class="nav__mobile-link">{l.label}</a>)}
    <a href={`tel:${SITE.phone}`} class="nav__mobile-link nav__mobile-phone">📞 {SITE.phoneDisplay}</a>
    <a href={contact} class="btn btn-primary nav__mobile-cta">{tr.cta.primary}</a>
    <a href={alt} class="nav__mobile-lang" hreflang={locale === 'fr' ? 'en-CA' : 'fr-CA'}>{tr.langName === 'Français' ? 'English' : 'Français'}</a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(12px);
    background: color-mix(in srgb, var(--color-ink) 72%, transparent);
    border-bottom: 1px solid var(--line);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
    gap: 1.5rem;
  }
  .nav__logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    border: 1px solid var(--line-strong);
    background: linear-gradient(135deg, rgba(232, 199, 154, 0.16), transparent);
  }
  .nav__mono {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.04em;
    color: var(--color-gold-bright);
  }
  .nav__links {
    display: flex;
    gap: 1.75rem;
    margin-inline: auto;
  }
  .nav__link {
    font-size: 0.92rem;
    color: var(--color-fog);
    position: relative;
    transition: color 0.2s ease;
  }
  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -6px;
    width: 0;
    height: 1px;
    background: var(--color-gold);
    transition: width 0.25s ease;
  }
  .nav__link:hover,
  .nav__link.is-active {
    color: var(--color-bone);
  }
  .nav__link:hover::after,
  .nav__link.is-active::after {
    width: 100%;
  }
  .nav__actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .nav__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    color: var(--color-bone);
    transition: color 0.2s ease;
    white-space: nowrap;
  }
  .nav__phone-ic { color: var(--color-gold); flex-shrink: 0; }
  .nav__phone:hover { color: var(--color-gold-bright); }
  .nav__phone:hover .nav__phone-ic { color: var(--color-gold-bright); }
  .nav__mobile-phone { color: var(--color-gold-bright); font-family: var(--font-mono); }
  .nav__lang {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    color: var(--color-fog);
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .nav__lang:hover {
    color: var(--color-gold-bright);
    border-color: var(--color-gold);
  }
  .nav__cta {
    padding: 0.6rem 1.1rem;
    font-size: 0.88rem;
  }
  .nav__burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    cursor: pointer;
  }
  .nav__burger span {
    width: 18px;
    height: 2px;
    background: var(--color-bone);
    transition: transform 0.25s ease, opacity 0.25s ease;
  }
  .nav__burger[aria-expanded='true'] span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .nav__burger[aria-expanded='true'] span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }
  .nav__mobile {
    display: none;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem clamp(1.25rem, 4vw, 2.5rem) 1.5rem;
    border-top: 1px solid var(--line);
    background: var(--color-ink2);
  }
  .nav__mobile-link {
    padding: 0.85rem 0;
    font-size: 1.05rem;
    border-bottom: 1px solid var(--line);
    color: var(--color-bone);
  }
  .nav__mobile-cta {
    margin-top: 1rem;
    justify-content: center;
  }
  .nav__mobile-lang {
    margin-top: 0.75rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-fog);
  }

  @media (max-width: 980px) {
    .nav__phone span { display: none; }
  }
  @media (max-width: 860px) {
    .nav__links { display: none; }
    .nav__cta { display: none; }
    .nav__phone { display: none; }
    .nav__burger { display: flex; }
    .nav__mobile[data-open='true'] { display: flex; }
  }
</style>

<script>
  const burger = document.getElementById('nav-burger');
  const menu = document.getElementById('nav-mobile');
  if (burger && menu) {
    burger.addEventListener('click', () => {
      const open = burger.getAttribute('aria-expanded') === 'true';
      burger.setAttribute('aria-expanded', String(!open));
      if (open) {
        menu.removeAttribute('data-open');
        menu.hidden = true;
      } else {
        menu.hidden = false;
        menu.setAttribute('data-open', 'true');
      }
    });
  }
</script>
