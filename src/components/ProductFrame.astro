---
// A running-software frame: chrome bar + looping product video, with a static
// image fallback. Shared by the home-page Habita spotlight and the Habita case
// study so the product is presented identically in both places.
//
// Playback is driven by ux.ts via [data-habita-video]: the loop starts once
// the frame scrolls into view and pauses off screen (see initHabitaVideo for
// why it also plays under prefers-reduced-motion). `autoplay` is deliberately
// absent from the markup so playback cannot start before the frame is in view.
// The MP4 (H.264) source is the fallback for browsers without VP9 WebM.
interface Props {
  /** Shown in the chrome bar, e.g. "habita.expert". */
  host: string;
  /** Short status word beside the live dot. */
  liveLabel: string;
  poster: string | null;
  webm: string | null;
  mp4: string | null;
  width?: number;
  height?: number;
  posterAlt: string;
  playLabel: string;
  pauseLabel: string;
  /** Used when the loop assets are not all present. */
  fallbackSrc: string;
  fallbackAlt: string;
  fallbackHref?: string;
  /** Opens the frame's link in a new tab (used when it points at the live app). */
  external?: boolean;
  /** `contain` shows a device mockup whole instead of cropping it. */
  fit?: 'cover' | 'contain';
}

const {
  host,
  liveLabel,
  poster,
  webm,
  mp4,
  width = 1280,
  height = 800,
  posterAlt,
  playLabel,
  pauseLabel,
  fallbackSrc,
  fallbackAlt,
  fallbackHref,
  external = false,
  fit = 'cover',
} = Astro.props;

const linkRel = external ? 'noopener' : undefined;
const linkTarget = external ? '_blank' : undefined;

const hasLoop = Boolean(webm && mp4 && poster);
---

<div class="frame">
  <div class="frame__chrome">
    <span class="frame__host">{host}</span>
    <span class="frame__live">
      <span class="frame__live-dot" aria-hidden="true"></span>
      <span>{liveLabel}</span>
    </span>
  </div>

  {hasLoop ? (
    <div class="frame__player" data-habita-video>
      <video
        class="frame__video"
        width={width}
        height={height}
        muted
        loop
        playsinline
        preload="metadata"
        aria-label={posterAlt}
      >
        <source src={webm} type="video/webm" />
        <source src={mp4} type="video/mp4" />
      </video>
      <img
        class="frame__poster"
        src={poster}
        alt={posterAlt}
        width={width}
        height={height}
        loading="lazy"
        decoding="async"
      />
      {/* The whole frame is a link, not just the buttons underneath it:
          clicking a product shot and getting nothing back is the obvious
          thing to try and the obvious thing to be let down by. It sits under
          the play button in the stack, so play/pause still wins its own
          hit area — and a <button> can never be nested inside an <a>. */}
      {fallbackHref && (
        <a
          class="frame__overlay"
          href={fallbackHref}
          target={linkTarget}
          rel={linkRel}
          aria-label={fallbackAlt}
        ></a>
      )}
      <button
        type="button"
        class="frame__play"
        data-habita-play
        data-label-play={playLabel}
        data-label-pause={pauseLabel}
        aria-label={playLabel}
      >
        <span class="frame__play-icon" aria-hidden="true"></span>
      </button>
    </div>
  ) : fallbackHref ? (
    <a href={fallbackHref} class="frame__still" target={linkTarget} rel={linkRel} aria-label={fallbackAlt}>
      <img
        src={fallbackSrc}
        alt={fallbackAlt}
        width={width}
        height={height}
        loading="lazy"
        decoding="async"
        style={fit === 'contain' ? 'object-fit:contain' : undefined}
      />
    </a>
  ) : (
    <div class="frame__still">
      <img
        src={fallbackSrc}
        alt={fallbackAlt}
        width={width}
        height={height}
        loading="lazy"
        decoding="async"
        style={fit === 'contain' ? 'object-fit:contain' : undefined}
      />
    </div>
  )}
</div>

<style>
  .frame {
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
    background: #07070a;
  }

  .frame__chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem clamp(0.85rem, 2vw, 1.25rem);
    border-bottom: 1px solid var(--line-soft);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.08em;
  }
  .frame__host { color: var(--fg-dim); }
  .frame__live {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--fg-mute);
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }
  .frame__live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--positive);
    animation: framePulse 2.6s ease-in-out infinite;
  }
  @keyframes framePulse {
    0%, 100% { opacity: 1; }
    55%      { opacity: 0.35; }
  }

  .frame__player { position: relative; }
  .frame__video,
  .frame__poster,
  .frame__still img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  /* Poster sits on top until the video actually starts, so no blank frame. */
  .frame__poster {
    position: absolute;
    inset: 0;
    height: 100%;
    transition: opacity var(--t-base) var(--ease);
  }
  .frame__player.is-playing .frame__poster {
    opacity: 0;
    pointer-events: none;
  }

  /* Covers the media, sits below the play button. */
  .frame__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .frame__overlay:focus-visible {
    outline: 2px solid var(--vermilion-text);
    outline-offset: -4px;
  }

  .frame__play {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    transform: translate(-50%, -50%);
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: color-mix(in srgb, #0a0a0c 55%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    display: grid;
    place-items: center;
    transition: opacity var(--t-base) var(--ease),
                border-color var(--t-fast) var(--ease),
                background-color var(--t-fast) var(--ease);
  }
  .frame__play:hover {
    border-color: var(--vermilion);
    background: color-mix(in srgb, var(--vermilion) 22%, transparent);
  }
  .frame__play-icon {
    width: 0;
    height: 0;
    margin-left: 4px;
    border-left: 15px solid #f4f2ee;
    border-top: 10px solid transparent;
    border-bottom: 10px solid transparent;
  }
  /* While it loops, the button shrinks to a pause control in the corner. It
     never disappears: moving content needs a way to stop it (WCAG 2.2.2). */
  .frame__player.is-playing .frame__play {
    left: auto;
    top: auto;
    right: 0.75rem;
    bottom: 0.75rem;
    transform: none;
    width: 44px;
    height: 44px;
    opacity: 0.7;
  }
  .frame__player.is-playing .frame__play:hover,
  .frame__player.is-playing .frame__play:focus-visible {
    opacity: 1;
  }
  .frame__player.is-playing .frame__play-icon {
    width: 12px;
    height: 14px;
    margin-left: 0;
    border: 0;
    border-left: 4px solid #f4f2ee;
    border-right: 4px solid #f4f2ee;
  }

  @media (max-width: 620px) {
    .frame__play { width: 52px; height: 52px; }
    .frame__player.is-playing .frame__play { width: 44px; height: 44px; }
  }
</style>
