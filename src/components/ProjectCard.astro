---
import type { Project } from '../data/projets';
import { loc } from '../data/projets';
import type { Locale } from '../i18n/routes';
import { workBase } from '../i18n/routes';

interface Props {
  project: Project;
  locale: Locale;
  cta: string;
  index?: number;
}
const { project, locale, cta, index = 0 } = Astro.props;
const href = `${workBase[locale]}/${project.slug}`;
const shot = `/work/${project.slug}.webp`;
const contain = project.fit === 'contain';
const shotAlt =
  locale === 'fr'
    ? `Aperçu du site ${loc(project.title, locale)}`
    : `Preview of the ${loc(project.title, locale)} website`;
---

<a
  href={href}
  class="card project-card reveal"
  data-tilt
  data-delay={`${index * 90}ms`}
  style={`--accent:${project.accent}`}
>
  <div class:list={['project-card__shot', contain && 'project-card__shot--contain']}>
    <img src={shot} alt={shotAlt} width="600" height="375" loading="lazy" decoding="async" />
  </div>
  <div class="project-card__top">
    <span class="project-card__index">0{index + 1}</span>
    <span class="project-card__year">{project.year}</span>
  </div>
  <h3 class="project-card__title">{loc(project.title, locale)}</h3>
  <p class="project-card__tagline">{loc(project.tagline, locale)}</p>
  <ul class="project-card__stack" aria-hidden="true">
    {project.stack.slice(0, 3).map((s) => <li>{s}</li>)}
  </ul>
  <span class="project-card__cta">{cta} <span aria-hidden="true">→</span></span>

  <style>
    .project-card {
      display: flex;
      flex-direction: column;
      padding: 1.9rem;
      position: relative;
      overflow: hidden;
      transition: border-color 0.3s, transform 0.2s ease-out;
      transform-style: preserve-3d;
    }
    .project-card::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(120% 80% at 100% 0, color-mix(in srgb, var(--accent) 14%, transparent), transparent 60%);
      opacity: 0;
      transition: opacity 0.35s;
    }
    .project-card:hover {
      border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    }
    .project-card:hover::before { opacity: 1; }
    .project-card__shot {
      margin: -1.9rem -1.9rem 1.5rem;
      border-radius: var(--radius-card) var(--radius-card) 0 0;
      overflow: hidden;
      border-bottom: 1px solid var(--line);
      aspect-ratio: 16 / 10;
      background: var(--color-ink2);
    }
    .project-card__shot img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top center;
      display: block;
      transition: transform 0.5s cubic-bezier(.2,.8,.2,1);
    }
    .project-card:hover .project-card__shot img { transform: scale(1.04); }
    /* Device mockups: show the whole image, smaller, on a dark backdrop. */
    .project-card__shot--contain {
      background: radial-gradient(70% 78% at 50% 48%, rgba(122, 162, 255, 0.30), transparent 72%), #070d16;
      padding: 1rem 1.1rem;
    }
    .project-card__shot--contain img {
      object-fit: contain;
      object-position: center;
      filter: drop-shadow(0 12px 26px rgba(0, 0, 0, 0.4));
    }
    .project-card:hover .project-card__shot--contain img { transform: scale(1.02); }
    .project-card__top {
      display: flex;
      justify-content: space-between;
      font-family: var(--font-mono);
      font-size: 0.78rem;
      color: var(--color-fog);
      margin-bottom: 1.1rem;
    }
    .project-card__index { color: var(--accent); }
    .project-card__title {
      font-size: 1.5rem;
      margin: 0 0 0.6rem;
    }
    .project-card__tagline {
      color: var(--color-fog);
      font-size: 0.96rem;
      line-height: 1.5;
      margin: 0 0 1.4rem;
      flex: 1;
    }
    .project-card__stack {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      padding: 0;
      margin: 0 0 1.4rem;
    }
    .project-card__stack li {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--color-fog);
      padding: 0.3rem 0.6rem;
      border: 1px solid var(--line);
      border-radius: 999px;
    }
    .project-card__cta {
      font-family: var(--font-mono);
      font-size: 0.82rem;
      letter-spacing: 0.04em;
      color: var(--color-gold-bright);
    }
  </style>
</a>
