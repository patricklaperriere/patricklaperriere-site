---
import { useTranslations, path } from '../i18n';
import type { Locale } from '../i18n/routes';
import { SITE, SOCIAL_LIST } from '../config';
import { villesHubPath } from '../data/villes';
import SignaturePL from './SignaturePL.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = useTranslations(locale);
const year = 2026;

const navLinks = [
  { href: path('services', locale), label: tr.nav.services },
  { href: path('work', locale), label: tr.nav.work },
  { href: path('concepts', locale), label: tr.nav.concepts },
  { href: path('about', locale), label: tr.nav.about },
  { href: path('blog', locale), label: tr.nav.blog },
  { href: path('contact', locale), label: tr.nav.contact },
];

const serviceLinks = [
  { href: path('svcWeb', locale), label: tr.services.web.title },
  { href: path('svcSeo', locale), label: tr.services.seo.title },
  { href: path('svcShopify', locale), label: tr.services.shopify.title },
  { href: villesHubPath(locale), label: tr.regions.citiesTitle },
];
---

<footer class="footer">
  <div class="container-wide">
    <!-- Contact block: the two routes that actually convert, given room. -->
    <div class="footer__top">
      <p class="label label-rule">{tr.nav.contact}</p>
      <div class="footer__reach">
        <a href={`mailto:${SITE.email}`} class="footer__mail">{SITE.email}</a>
        <a href={`tel:${SITE.phone}`} class="footer__tel">{SITE.phoneDisplay}</a>
      </div>
      <p class="footer__tagline">{tr.footer.tagline}</p>
    </div>

    <div class="footer__grid">
      <nav class="footer__col" aria-label={tr.footer.navTitle}>
        <h2 class="footer__title">{tr.footer.navTitle}</h2>
        <ul class="footer__list">
          {navLinks.map((l) => (
            <li><a href={l.href} class="footer__link">{l.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="footer__col" aria-label={tr.footer.servicesTitle}>
        <h2 class="footer__title">{tr.footer.servicesTitle}</h2>
        <ul class="footer__list">
          {serviceLinks.map((l) => (
            <li><a href={l.href} class="footer__link">{l.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="footer__col">
        <h2 class="footer__title">{tr.footer.connectTitle}</h2>
        <ul class="footer__list">
          {SOCIAL_LIST.map((s) => (
            <li>
              <a href={s.url} class="footer__link" target="_blank" rel="me noopener">
                {s.label}
                <span class="footer__ext" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
          <li>
            <a href={locale === 'fr' ? '/rss.xml' : '/en/rss.xml'} class="footer__link">RSS</a>
          </li>
        </ul>
      </div>

      <div class="footer__col footer__col--sign">
        <SignaturePL variant="card" />
      </div>
    </div>

    <div class="footer__bottom">
      <p class="footer__legal">
        © {year} Patrick Laperrière. {tr.footer.rights}
        <span class="footer__sep" aria-hidden="true">·</span> {tr.footer.madeIn}
      </p>
      <a href={path('privacy', locale)} class="footer__legal-link">{tr.footer.privacy}</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-block: clamp(3rem, 6vw, 5rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  /* ---- Reach ------------------------------------------------------------- */
  .footer__top {
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .footer__reach {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem clamp(1.5rem, 4vw, 3rem);
    margin: clamp(1.25rem, 3vw, 2rem) 0 1.25rem;
  }
  .footer__mail {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3.6vw, 2.6rem);
    font-weight: var(--fw-thin);
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--fg);
    word-break: break-word;
    transition: color var(--t-fast) var(--ease);
  }
  .footer__mail:hover { color: var(--vermilion-text); }
  .footer__tel {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    letter-spacing: 0.04em;
    color: var(--fg-dim);
    min-height: 32px;
    display: inline-flex;
    align-items: center;
    transition: color var(--t-fast) var(--ease);
  }
  .footer__tel:hover { color: var(--fg); }
  .footer__tagline {
    color: var(--fg-dim);
    font-size: var(--fs-sm);
    max-width: 44ch;
    margin: 0;
  }

  /* ---- Columns ----------------------------------------------------------- */
  .footer__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.75rem, 4vw, 3rem);
    padding-block: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
  }
  .footer__title {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-mute);
    margin: 0 0 1.1rem;
  }
  .footer__list {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .footer__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 32px;
    font-size: var(--fs-sm);
    color: var(--fg-dim);
    transition: color var(--t-fast) var(--ease);
  }
  .footer__link:hover { color: var(--fg); }
  .footer__ext { font-size: 0.7em; opacity: 0.6; }

  .footer__col--sign {
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
  }

  /* ---- Legal ------------------------------------------------------------- */
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-top: clamp(1.25rem, 3vw, 2rem);
    border-top: 1px solid var(--line-soft);
  }
  .footer__legal,
  .footer__legal-link {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.05em;
    color: var(--fg-mute);
    margin: 0;
  }
  .footer__legal-link {
    min-height: 32px;
    display: inline-flex;
    align-items: center;
    transition: color var(--t-fast) var(--ease);
  }
  .footer__legal-link:hover { color: var(--fg); }
  .footer__sep { opacity: 0.5; margin-inline: 0.25rem; }

  @media (max-width: 860px) {
    .footer__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .footer__col--sign {
      grid-column: 1 / -1;
      justify-content: flex-start;
    }
  }
  @media (max-width: 460px) {
    .footer__grid { grid-template-columns: 1fr; }
  }
</style>
