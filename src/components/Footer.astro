---
import { useTranslations, path } from '../i18n';
import type { Locale } from '../i18n/routes';
import { SITE, SOCIAL_LIST } from '../config';
import SignaturePL from './SignaturePL.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = useTranslations(locale);
const year = 2026;

const navLinks = [
  { href: path('services', locale), label: tr.nav.services },
  { href: path('work', locale), label: tr.nav.work },
  { href: path('about', locale), label: tr.nav.about },
  { href: path('blog', locale), label: tr.nav.blog },
  { href: path('contact', locale), label: tr.nav.contact },
];

const serviceLinks = [
  { href: path('svcWeb', locale), label: tr.services.web.title },
  { href: path('svcSeo', locale), label: tr.services.seo.title },
  { href: path('svcShopify', locale), label: tr.services.shopify.title },
];
---

<footer class="footer">
  <div class="container-pl footer__grid">
    <div class="footer__brand">
      <a href={path('home', locale)} class="footer__logo">Patrick Laperrière</a>
      <p class="footer__tagline">{tr.footer.tagline}</p>
      <a href={`mailto:${SITE.email}`} class="footer__email">{SITE.email}</a>
    </div>

    <nav class="footer__col" aria-label={tr.footer.navTitle}>
      <h2 class="footer__title">{tr.footer.navTitle}</h2>
      {navLinks.map((l) => <a href={l.href} class="footer__link">{l.label}</a>)}
    </nav>

    <nav class="footer__col" aria-label={tr.footer.servicesTitle}>
      <h2 class="footer__title">{tr.footer.servicesTitle}</h2>
      {serviceLinks.map((l) => <a href={l.href} class="footer__link">{l.label}</a>)}
    </nav>

    <div class="footer__col">
      <h2 class="footer__title">{tr.footer.connectTitle}</h2>
      {SOCIAL_LIST.map((s) => (
        <a href={s.url} class="footer__link" target="_blank" rel="me noopener">{s.label}</a>
      ))}
    </div>
  </div>

  <div class="container-pl footer__bottom">
    <p class="footer__legal">© {year} Patrick Laperrière. {tr.footer.rights} <span class="footer__sep">·</span> {tr.footer.madeIn}</p>
    <SignaturePL variant="card" />
  </div>
</footer>

<style>
  .footer {
    margin-top: 4rem;
    border-top: 1px solid var(--line);
    background: linear-gradient(180deg, transparent, rgba(6, 11, 20, 0.6));
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 2.5rem;
    padding-block: clamp(3rem, 6vw, 4.5rem) 2.5rem;
  }
  .footer__logo {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-bone);
  }
  .footer__tagline {
    margin: 0.9rem 0 1.2rem;
    color: var(--color-fog);
    font-size: 0.95rem;
    max-width: 32ch;
  }
  .footer__email {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-gold);
  }
  .footer__email:hover { color: var(--color-gold-bright); }
  .footer__title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-fog);
    margin: 0 0 1rem;
  }
  .footer__col { display: flex; flex-direction: column; gap: 0.6rem; }
  .footer__link {
    color: var(--color-bone);
    opacity: 0.78;
    font-size: 0.92rem;
    transition: opacity 0.2s ease, color 0.2s ease;
    width: fit-content;
  }
  .footer__link:hover { opacity: 1; color: var(--color-gold-bright); }
  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-block: 1.5rem 2.5rem;
    border-top: 1px solid var(--line);
  }
  .footer__legal {
    margin: 0;
    color: var(--color-fog);
    font-size: 0.82rem;
  }
  .footer__sep { opacity: 0.5; margin-inline: 0.4rem; }

  @media (max-width: 860px) {
    .footer__grid { grid-template-columns: 1fr 1fr; gap: 2rem; }
    .footer__brand { grid-column: 1 / -1; }
  }
  @media (max-width: 520px) {
    .footer__grid { grid-template-columns: 1fr; }
  }
</style>
