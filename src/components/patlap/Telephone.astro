---
// Le téléphone dessiné d'un panneau « Jour N » : cadre mauve nuit, picto
// maison (trait 2 px, mauve) et le nom de l'app EN TEXTE. Aucun logo de
// marque (OpenAI, Anthropic, Google, Apple) : pas d'affiliation.
// Le cadre est un <symbol> défini une fois dans PageProgramme (#pl-tel).
interface Props { n: number; app: string; }
const { n, app } = Astro.props;
---

<svg class="pl-tel" viewBox="0 0 160 300" aria-hidden="true" focusable="false">
  <use href="#pl-tel" />
  <g class="pl-tel-ecran" transform="translate(48 96)" fill="none" stroke="#A33E9A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke">
    {n === 1 && <><path d="M8 8h48a6 6 0 0 1 6 6v26a6 6 0 0 1-6 6H26L14 56V46H8a6 6 0 0 1-6-6V14a6 6 0 0 1 6-6z" /><path d="M26 22a6 6 0 1 1 8 6c-2 1-2 2-2 4M32 38v1" /></>}
    {n === 2 && <><rect x="4" y="14" width="56" height="38" rx="4" /><path d="M4 18l28 20 28-20" /></>}
    {n === 3 && <><path d="M6 22h12l6-8h16l6 8h12v30H6z" /><circle cx="32" cy="36" r="10" /></>}
    {n === 4 && <><rect x="2" y="6" width="44" height="30" rx="5" /><path d="M14 36l-4 10 12-10M40 58l18-18 6 6-18 18h-6zM52 46l6 6" /></>}
    {n === 5 && <><path d="M18 52a12 12 0 0 1-1-24 16 16 0 0 1 31-3 12 12 0 0 1 1 27z" /><path d="M32 46V32M26 38l6-6 6 6" /></>}
  </g>
  <text x="80" y="214" text-anchor="middle" class="pl-tel-app">{app}</text>
</svg>

<style>
  .pl-tel { width: 100%; height: auto; display: block; }
  .pl-tel-app { font: 700 15px "Figtree", system-ui, sans-serif; fill: #300A24; }
</style>
