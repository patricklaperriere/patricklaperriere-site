---
// Le téléphone dessiné d'un panneau « Jour N » : cadre mauve nuit, picto
// maison (trait 2 px, mauve) et le nom de l'app EN TEXTE. Pas de logo
// officiel : Anthropic et Google exigent une autorisation écrite préalable,
// la page de marque d'OpenAI n'a pas pu être lue (PAT-LAP-8, 6 nov.).
// Le cadre est un <symbol> défini une fois dans PageProgramme (#pl-tel).
interface Props { n: number; noms: string[]; }
const { n, noms } = Astro.props;
// Les noms, un par ligne, même taille, centrés sous le picto.
const pas = 22;
const y0 = noms.length === 1 ? 214 : 200;
---

<svg class="pl-tel" viewBox="0 0 160 300" aria-hidden="true" focusable="false">
  <use href="#pl-tel" />
  <g class="pl-tel-ecran" transform="translate(48 96)" fill="none" stroke="#A33E9A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke">
    {/* Gestes V2 : 1 enveloppe, 2 calendrier, 3 boîte de réception, 4 appareil photo, 5 micro. */}
    {n === 1 && <><rect x="4" y="14" width="56" height="38" rx="4" /><path d="M4 18l28 20 28-20" /></>}
    {n === 2 && <><rect x="6" y="12" width="52" height="44" rx="5" /><path d="M6 24h52M20 6v12M44 6v12M18 34h8M30 34h8M42 34h4M18 44h8M30 44h8" /></>}
    {n === 3 && <><path d="M4 34l10-24h36l10 24v18H4z" /><path d="M4 34h16l4 8h16l4-8h16M32 14v14M26 22l6 6 6-6" /></>}
    {n === 4 && <><path d="M6 22h12l6-8h16l6 8h12v30H6z" /><circle cx="32" cy="36" r="10" /></>}
    {n === 5 && <><rect x="22" y="4" width="20" height="34" rx="10" /><path d="M12 30a20 20 0 0 0 40 0M32 50v8M24 58h16" /></>}
  </g>
  {noms.map((nom, i) => <text x="80" y={y0 + i * pas} text-anchor="middle" class:list={['pl-tel-app', { 'pl-tel-app-liste': noms.length > 1 }]}>{nom}</text>)}
</svg>

<style>
  .pl-tel { width: 100%; height: auto; display: block; }
  .pl-tel-app { font: 700 17px "Figtree", system-ui, sans-serif; fill: #300A24; }
  .pl-tel-app-liste { font-size: 15px; }
</style>
