---
// One service, as an editorial column rather than a card.
// The old version led with a decorative emoji in a rounded box; the number and
// the rule carry the structure now, which keeps three propositions scannable
// without three competing icons.
interface Props {
  title: string;
  blurb: string;
  href: string;
  cta: string;
  index?: number;
  /** Starting price, already formatted. Null renders no price line. */
  price?: string | null;
  priceFrom?: string;
  currency?: string;
  /** Kept for compatibility with the dictionary shape; intentionally unused. */
  icon?: string;
}
const {
  title,
  blurb,
  href,
  cta,
  index = 0,
  price = null,
  priceFrom = '',
  currency = '',
} = Astro.props;

const num = String(index + 1).padStart(2, '0');
---

<a href={href} class="svc reveal" data-delay={`${index * 80}ms`}>
  <span class="svc__num index-num">{num}</span>

  <h3 class="svc__title">{title}</h3>
  <p class="svc__blurb">{blurb}</p>

  {price && (
    <p class="svc__price">
      <span class="svc__price-from">{priceFrom}</span>
      <b>{`${price} ${currency}`}</b>
    </p>
  )}

  <span class="cta-mono svc__cta">
    {cta}
    <span class="svc__arrow" aria-hidden="true">→</span>
  </span>
</a>

<style>
  .svc {
    display: flex;
    flex-direction: column;
    padding-top: 1.35rem;
    border-top: 1px solid var(--line-strong);
    transition: border-color var(--t-base) var(--ease);
  }
  .svc:hover { border-top-color: var(--accent); }

  .svc__num {
    margin-bottom: 1.5rem;
  }
  .svc__title {
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    font-weight: var(--fw-light);
    letter-spacing: -0.028em;
    margin: 0 0 0.75rem;
    transition: color var(--t-fast) var(--ease);
  }
  .svc:hover .svc__title { color: var(--accent-fg); }

  .svc__blurb {
    color: var(--fg-dim);
    font-size: var(--fs-sm);
    line-height: 1.6;
    margin: 0 0 1.5rem;
    flex: 1;
  }

  .svc__price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1.35rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line-soft);
  }
  .svc__price-from {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-mute);
  }
  .svc__price b {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: var(--fw-light);
    letter-spacing: -0.03em;
    color: var(--fg);
  }

  .svc__arrow { transition: transform var(--t-base) var(--ease-out); }
  .svc:hover .svc__arrow { transform: translateX(4px); }
</style>
