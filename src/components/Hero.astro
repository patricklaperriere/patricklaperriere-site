---
import { useTranslations, path } from '../i18n';
import type { Locale } from '../i18n/routes';
import { PHOTO, hasPhoto } from '../lib/photo';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = useTranslations(locale);
const h = tr.hero;

// The role line carries the positioning widening: grotesk for the trade,
// serif italic for the product half. Split on the "&" we author ourselves,
// so it works in both dictionaries without per-locale markup.
const [roleTrade, roleProduct] = h.role.split(' & ');

// Availability copy is stored with a leading bullet for legacy reasons; the
// dot is drawn in CSS here so it can pulse and carry a live colour.
const availability = tr.status.replace('●', '').trim();

const meta = [
  { label: h.meta.availabilityLabel, value: availability, live: true },
  { label: h.meta.locationLabel, value: h.meta.location, live: false },
  { label: h.meta.productLabel, value: h.meta.product, live: false },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container-wide hero__inner">
    <p class="label label-rule hero__eyebrow">{h.kicker}</p>

    <div class="hero__grid">
      <div class="hero__main">
        {/* One H1 carrying both the person and the proposition: the name keeps
            the entity signal, the statement keeps the keyword intent that the
            <title> and description are built on. */}
        <h1 class="hero__h1" id="hero-title">
          <span class="hero__name">
            {h.name}<span class="hero__name-dot" aria-hidden="true">.</span>
          </span>
          <span class="hero__role" aria-hidden="true">
            {roleTrade}{roleProduct && <> <span class="serif-accent">&amp; {roleProduct}</span></>}
          </span>
          <span class="hero__statement">{h.punch}</span>
        </h1>

        <p class="hero__sub">{h.sub}</p>

        <div class="hero__ctas">
          <a href={path('contact', locale)} class="btn btn-accent">
            {tr.cta.primary}
            <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
          <a href={path('work', locale)} class="btn btn-ghost">{tr.cta.secondary}</a>
        </div>
      </div>

      <div class="hero__side">
        {hasPhoto && (
          /* Eager and high priority: this is an above-the-fold LCP candidate,
             so it must not queue behind anything. Intrinsic ratio is locked by
             width/height + aspect-ratio, which keeps CLS at zero. */
          <figure class="hero__portrait">
            <img
              src={PHOTO.portrait}
              srcset={`${PHOTO.avatar2x} 256w, ${PHOTO.portrait} 720w`}
              sizes="(max-width: 900px) 76px, (max-width: 1200px) 26vw, 320px"
              alt={tr.about.portraitAlt}
              width="720"
              height="900"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </figure>
        )}

        <dl class="hero__meta">
          {meta.map((m) => (
            <div class="hero__meta-row">
              <dt class="hero__meta-label">{m.label}</dt>
              <dd class="hero__meta-value">
                {m.live && <span class="hero__live" aria-hidden="true"></span>}
                {m.value}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    <a href="#proof" class="hero__scroll" aria-label={h.scroll}>
      <span aria-hidden="true">{h.scroll}</span>
      <span class="hero__scroll-line" aria-hidden="true"></span>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3rem, 8vh, 6rem) clamp(2.5rem, 6vh, 4.5rem);
  }
  .hero__eyebrow {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  /* ---- Headline block ----------------------------------------------------
     Nothing in here animates on entry. The statement is the LCP element, and
     an opacity fade would delay the paint the whole site is benchmarked on. */
  .hero__h1 {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .hero__name {
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    font-weight: var(--fw-medium);
    letter-spacing: -0.01em;
    color: var(--fg);
  }
  .hero__name-dot { color: var(--vermilion); }

  .hero__role {
    font-size: clamp(1.15rem, 2vw, 1.6rem);
    font-weight: var(--fw-light);
    letter-spacing: -0.02em;
    color: var(--fg-dim);
    margin-bottom: clamp(1rem, 2.5vw, 1.75rem);
  }
  .hero__role .serif-accent { color: var(--fg); }

  .hero__statement {
    font-size: clamp(1.9rem, 4.3vw, 3.55rem);
    font-weight: var(--fw-thin);
    line-height: 1.04;
    letter-spacing: -0.032em;
    color: var(--fg);
    max-width: 19ch;
    text-wrap: balance;
  }

  .hero__sub {
    color: var(--fg-dim);
    font-size: var(--fs-lead);
    line-height: 1.55;
    max-width: 44ch;
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  /* ---- Side column ------------------------------------------------------- */
  .hero__side {
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }
  .hero__portrait {
    margin: 0;
    position: relative;
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--ink-raised);
  }
  .hero__portrait img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 18%;
  }
  /* A single hairline along the bottom edge in the accent — the only ornament
     on the portrait, standing in for the old glow. */
  .hero__portrait::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--vermilion);
  }

  .hero__meta {
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .hero__meta-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line-soft);
  }
  .hero__meta-label {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-mute);
    flex: none;
    padding-top: 0.15rem;
  }
  .hero__meta-value {
    margin: 0;
    font-size: var(--fs-meta);
    line-height: 1.4;
    color: var(--fg);
    text-align: right;
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
  }
  .hero__live {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--positive);
    flex: none;
    transform: translateY(-1px);
    animation: heroPulse 2.6s ease-in-out infinite;
  }
  @keyframes heroPulse {
    0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--positive) 55%, transparent); }
    55%      { box-shadow: 0 0 0 6px color-mix(in srgb, var(--positive) 0%, transparent); }
  }

  /* ---- Scroll cue -------------------------------------------------------- */
  .hero__scroll {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    gap: 0.75rem;
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-mute);
    transition: color var(--t-fast) var(--ease);
  }
  .hero__scroll:hover { color: var(--fg); }
  .hero__scroll-line {
    width: 3.5rem;
    height: 1px;
    background: currentColor;
    transform-origin: left;
    animation: heroLine 2.8s var(--ease) infinite;
  }
  @keyframes heroLine {
    0%, 100% { transform: scaleX(0.35); opacity: 0.5; }
    50%      { transform: scaleX(1); opacity: 1; }
  }

  /* ---- Responsive --------------------------------------------------------
     Below 900px the portrait becomes a byline-scale square sitting next to the
     name, so the person stays present without the hero growing a whole extra
     screen. */
  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: clamp(1.5rem, 4vw, 2.25rem);
    }
    /* Both wrappers dissolve so their children become grid items directly and
       can be interleaved: the portrait belongs right under the name, not
       stranded below the buttons. `order` then drives the single column. */
    .hero__main,
    .hero__side { display: contents; }
    .hero__h1      { order: 1; }
    .hero__portrait{ order: 2; }
    .hero__sub     { order: 3; }
    .hero__ctas    { order: 4; }
    .hero__meta    { order: 5; }

    .hero__portrait {
      width: 76px;
      justify-self: start;
    }
    .hero__portrait img { aspect-ratio: 1 / 1; }
    .hero__statement { max-width: 100%; }
  }

  @media (max-width: 460px) {
    .hero__meta-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.2rem;
    }
    .hero__meta-value { text-align: left; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__live,
    .hero__scroll-line { animation: none; }
  }
</style>
