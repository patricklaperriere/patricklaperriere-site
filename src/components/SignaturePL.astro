---
// "Design by Patrick Laperrière" signature wordmark.
// Dropped in the footer of client sites → dofollow backlink to patricklaperriere.com.
// Also used in this site's own footer.
//
// On client sites the text is a fixed wordmark, "Design by", never translated.
// This site's own footer passes its own label (French: "Conçu par") and keeps
// the link in the same tab, since it points home.
import { SITE } from '../config';

interface Props {
  /** "muted" for subtle footer use, "card" for a bordered pill. */
  variant?: 'muted' | 'card';
  label?: string;
  newTab?: boolean;
}

const { variant = 'muted', label = 'Design by', newTab = true } = Astro.props;
---

<a
  class:list={['pl-signature', variant === 'card' && 'pl-signature--card']}
  href={SITE.domain}
  rel={newTab ? 'dofollow noopener' : undefined}
  target={newTab ? '_blank' : undefined}
>
  <span class="pl-signature__label">{label}</span>{' '}
  <span class="pl-signature__name">Patrick Laperrière</span>
</a>

<style>
  .pl-signature {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: 0.4em;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--fg-dim);
    transition: color 0.25s ease;
  }
  .pl-signature--card {
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(238, 241, 246, 0.02);
  }
  .pl-signature__label {
    opacity: 0.8;
  }
  .pl-signature__name {
    position: relative;
    font-weight: 600;
    background: linear-gradient(110deg, var(--accent) 0%, var(--accent) 40%, var(--accent-fg) 50%, var(--accent) 60%, var(--accent) 100%);
    background-size: 220% 100%;
    background-position: 100% 0;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    transition: background-position 0.6s ease;
  }
  .pl-signature:hover .pl-signature__name {
    background-position: 0 0;
  }
  .pl-signature:hover {
    color: var(--fg);
  }
  @media (prefers-reduced-motion: reduce) {
    .pl-signature__name {
      transition: none;
    }
  }
</style>
