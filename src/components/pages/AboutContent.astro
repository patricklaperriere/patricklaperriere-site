---
// Personal editorial profile.
//
// Was a single prose column with the portrait floated into the middle of it and
// a rounded "why me" card stranded beside a half-empty grid. Now: portrait and
// story share a two-column masthead, the principles become a numbered row on
// paper, and the stack is stated plainly as an index.
import { useTranslations, path } from '../../i18n';
import type { Locale } from '../../i18n/routes';
import Breadcrumb from '../Breadcrumb.astro';
import CtaBand from '../CtaBand.astro';
import { hasPhoto } from '../../lib/photo';
import PortraitSlot from '../PortraitSlot.astro';
import Todo from '../Todo.astro';
import ExternalIcon from '../ExternalIcon.astro';
import { SITE } from '../../config';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = useTranslations(locale);
const a = tr.about;

const crumbs = [
  { name: tr.breadcrumb.home, url: path('home', locale) },
  { name: tr.nav.about, url: path('about', locale) },
];

---

<Breadcrumb items={crumbs} />

<section class="page-head container-wide">
  <p class="label label-rule">{a.kicker}</p>
  <h1>{a.h1}</h1>
  <p class="lead">{a.lead}</p>
</section>

<!-- Portrait + story ------------------------------------------------------ -->
<section class:list={['section-tight container-wide about__top', !(hasPhoto || import.meta.env.DEV) && 'about__top--solo']}>
  {(hasPhoto || import.meta.env.DEV) && (
    <div class="about__portrait reveal">
      <PortraitSlot alt={a.portraitAlt} sizes="(max-width: 880px) 100vw, 420px" />
    </div>
  )}

  <div class="about__story prose reveal" data-delay="80ms">
    {a.body.map((p) => <p>{p}</p>)}
    {import.meta.env.DEV && <p><Todo what={a.bioTodo} /></p>}

    <aside class="about__company" aria-labelledby="about-company">
      <h2 id="about-company" class="label">{a.companyTitle}</h2>
      <p>{a.company}</p>
      <a href={SITE.company.url} target="_blank" rel="noopener">{a.companyLink}<ExternalIcon /></a>
    </aside>
  </div>
</section>

<!-- Principles (paper chapter) -------------------------------------------- -->
<section class="section-tight about__why" data-surface="paper">
  <div class="container-wide">
    <h2 class="label label-rule about__why-label">{a.whyTitle}</h2>
    <ul class="about__why-list">
      {a.why.map((w, i) => (
        <li class="about__why-item reveal" data-delay={`${i * 70}ms`}>
          <span class="index-num">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="about__why-title">{w.t}</h3>
          <p class="about__why-text">{w.d}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- Stack ------------------------------------------------------------------ -->
<section class="section-tight container-wide about__stack-wrap">
  <h2 class="label label-rule">{a.stackTitle}</h2>
  <ul class="about__stack">
    {SITE.stack.map((t) => <li>{t}</li>)}
  </ul>
</section>

<CtaBand locale={locale} email={SITE.emailPersonal} />

<style>
  /* ---- Masthead ----------------------------------------------------------- */
  .about__top {
    display: grid;
    grid-template-columns: minmax(0, 420px) minmax(0, 1fr);
    gap: clamp(1.75rem, 5vw, 4rem);
    align-items: start;
  }
  .about__portrait {
    margin: 0;
    position: relative;
  }
  .about__portrait :global(picture) { display: block; }
  .about__portrait :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 18%;
    border-radius: var(--r-md);
    background: var(--ink-raised);
  }
  .about__caption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-top: 0.9rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.08em;
    color: var(--fg-mute);
  }
  .about__status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--fg);
  }
  .about__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--positive);
    flex: none;
  }

  .about__story p {
    font-size: var(--fs-body);
    line-height: 1.75;
    max-width: 64ch;
  }
  /* First paragraph reads as the standfirst. */
  .about__story p:first-child {
    font-size: var(--fs-lead);
    line-height: 1.6;
    color: var(--fg);
  }

  /* ---- Principles --------------------------------------------------------- */
  .about__why-label { margin-bottom: clamp(1.75rem, 4vw, 2.5rem); }
  .about__why-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid var(--line);
  }
  .about__why-item {
    padding: clamp(1.25rem, 2.5vw, 1.75rem) clamp(1rem, 2vw, 1.75rem)
             clamp(1.25rem, 2.5vw, 1.75rem) 0;
    border-right: 1px solid var(--line-soft);
  }
  .about__why-item + .about__why-item { padding-left: clamp(1rem, 2vw, 1.75rem); }
  .about__why-item:last-child { border-right: 0; }
  .about__why-title {
    font-size: 1.05rem;
    font-weight: var(--fw-medium);
    letter-spacing: -0.015em;
    margin: 0.9rem 0 0.45rem;
  }
  .about__why-text {
    color: var(--fg-dim);
    font-size: var(--fs-meta);
    line-height: 1.6;
    margin: 0;
  }

  /* ---- Stack -------------------------------------------------------------- */
  .about__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--fg-dim);
  }
  .about__stack li + li::before {
    content: "/";
    margin-right: 1.5rem;
    opacity: 0.4;
  }

  /* ---- Responsive --------------------------------------------------------- */
  .about__top--solo { grid-template-columns: minmax(0, 1fr); }
  .about__company {
    margin-top: var(--s5, 40px);
    padding-top: var(--s3, 24px);
    border-top: 1px solid var(--line);
  }
  .about__company p { margin: var(--s1, 8px) 0; }
  .about__company a { display: inline-flex; align-items: center; gap: 0.35em; }
  @media (max-width: 880px) {
    .about__top { grid-template-columns: 1fr; }
    .about__portrait { max-width: 22rem; }
  }
  @media (max-width: 900px) {
    .about__why-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .about__why-item,
    .about__why-item + .about__why-item {
      border-right: 0;
      border-bottom: 1px solid var(--line-soft);
      padding-inline: 0 1rem;
    }
    .about__why-item:nth-child(odd) { border-right: 1px solid var(--line-soft); }
    .about__why-item:nth-child(even) { padding-inline: 1rem 0; }
    .about__why-item:nth-last-child(-n + 2) { border-bottom: 0; }
  }
  @media (max-width: 520px) {
    .about__why-list { grid-template-columns: 1fr; }
    .about__why-item,
    .about__why-item + .about__why-item,
    .about__why-item:nth-child(odd),
    .about__why-item:nth-child(even) {
      border-right: 0;
      border-bottom: 1px solid var(--line-soft);
      padding-inline: 0;
    }
    .about__why-item:last-child { border-bottom: 0; }
  }
</style>
