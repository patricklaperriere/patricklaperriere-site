---
// Services overview.
//
// The old version was three short cards and a row of pills, which gave the page
// almost nothing to say. Each service now gets a full editorial row built from
// copy that already exists in the dictionary (lead + the "what's included"
// list), so the page earns its place without inventing a word.
import { useTranslations, path } from '../../i18n';
import type { Locale } from '../../i18n/routes';
import { villes, villePath, villesHubPath } from '../../data/villes';
import Breadcrumb from '../Breadcrumb.astro';
import CtaBand from '../CtaBand.astro';
import { startingPrice, type PricedService } from '../../data/prix';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = useTranslations(locale);
const services = [tr.services.web, tr.services.seo, tr.services.shopify];
const cities = [...villes].sort((a, b) => a.order - b.order);

const crumbs = [
  { name: tr.breadcrumb.home, url: path('home', locale) },
  { name: tr.nav.services, url: path('services', locale) },
];
---

<Breadcrumb items={crumbs} />

<section class="page-head container-wide">
  <p class="label label-rule">{tr.servicesSection.kicker}</p>
  <h1>{tr.servicesSection.title}</h1>
  <p class="lead">{tr.servicesSection.lead}</p>
</section>

<section class="section-tight container-wide" aria-label={tr.servicesSection.title}>
  <ol class="svcx">
    {services.map((s, i) => {
      const price = startingPrice[s.key as PricedService] ?? null;
      return (
        <li class="svcx__row reveal" data-delay={`${i * 80}ms`}>
          <div class="svcx__aside">
            <span class="index-num">{String(i + 1).padStart(2, '0')}</span>
            {price && (
              <p class="svcx__price">
                <span class="svcx__price-from">{tr.pricing.from}</span>
                <b>{`${price} ${tr.pricing.currency}`}</b>
              </p>
            )}
          </div>

          <div class="svcx__main">
            <h2 class="svcx__title">
              <a href={path(s.key, locale)}>{s.title}</a>
            </h2>
            <p class="svcx__lead">{s.lead}</p>

            <p class="label svcx__inc-label">{s.includedTitle}</p>
            <ul class="svcx__inc">
              {s.included.slice(0, 4).map((item) => <li>{item}</li>)}
            </ul>

            <a href={path(s.key, locale)} class="cta-mono svcx__cta">
              {tr.cta.seeServices}
              <span class="svcx__arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </li>
      );
    })}
  </ol>
</section>

<!-- Local reach ------------------------------------------------------------ -->
<section class="section-tight container-wide svcx__regions">
  <h2 class="label label-rule">{tr.regions.citiesTitle}</h2>
  <ul class="region-links">
    {cities.map((v) => (
      <li><a href={villePath(locale, v.slug)}>{v.name}</a></li>
    ))}
  </ul>
  <a href={villesHubPath(locale)} class="link svcx__regions-all">
    {tr.regions.allCities}
    <span aria-hidden="true">→</span>
  </a>
</section>

<CtaBand locale={locale} />

<style>
  /* ---- Service rows ------------------------------------------------------- */
  .svcx {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .svcx__row {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 9fr);
    gap: clamp(1rem, 4vw, 3.5rem);
    padding-block: clamp(1.75rem, 4vw, 3rem);
    border-bottom: 1px solid var(--line-soft);
  }
  .svcx__aside {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .svcx__price {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .svcx__price-from {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-mute);
  }
  .svcx__price b {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: var(--fw-light);
    letter-spacing: -0.03em;
  }

  .svcx__title {
    font-size: clamp(1.6rem, 3.4vw, 2.5rem);
    font-weight: var(--fw-light);
    letter-spacing: -0.032em;
    margin: 0 0 0.85rem;
  }
  .svcx__title a { transition: color var(--t-fast) var(--ease); }
  .svcx__title a:hover { color: var(--accent-fg); }

  .svcx__lead {
    color: var(--fg-dim);
    font-size: var(--fs-lead);
    line-height: 1.6;
    max-width: 60ch;
    margin: 0 0 1.75rem;
  }

  .svcx__inc-label {
    padding-bottom: 0.65rem;
    border-bottom: 1px solid var(--line-soft);
    margin-bottom: 0.9rem;
  }
  .svcx__inc {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem clamp(1rem, 3vw, 2.5rem);
    margin: 0 0 1.5rem;
    max-width: 62rem;
  }
  .svcx__inc li {
    position: relative;
    padding-left: 1.1rem;
    color: var(--fg-dim);
    font-size: var(--fs-sm);
    line-height: 1.5;
  }
  .svcx__inc li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 1px;
    background: var(--accent);
  }

  .svcx__arrow { transition: transform var(--t-base) var(--ease-out); }
  .svcx__cta:hover .svcx__arrow { transform: translateX(4px); }

  /* ---- Regions ------------------------------------------------------------ */
  .region-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem clamp(1rem, 3vw, 2rem);
    margin: 1.5rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
  }
  .region-links a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    color: var(--fg-dim);
    transition: color var(--t-fast) var(--ease);
  }
  .region-links a:hover { color: var(--accent-fg); }
  .svcx__regions-all { margin-top: 1.5rem; }

  /* ---- Responsive --------------------------------------------------------- */
  @media (max-width: 860px) {
    .svcx__row { grid-template-columns: 1fr; gap: 0.9rem; }
    .svcx__aside { flex-direction: row; align-items: baseline; gap: 1.5rem; }
  }
  @media (max-width: 560px) {
    .svcx__inc { grid-template-columns: 1fr; }
  }
</style>
