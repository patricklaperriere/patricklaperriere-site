---
// Editorial case study.
//
// Structure: masthead (client · year → oversized title → tagline → spec row),
// full-bleed hero media, measured benchmark when the live site was tested, then
// the narrative in a two-column editorial grid — mono label in the margin, prose
// on a readable measure — and a link through to the next project.
//
import { useTranslations, path } from '../../i18n';
import type { Locale } from '../../i18n/routes';
import { workBase } from '../../i18n/routes';
import type { Project } from '../../data/projets';
import { loc, sortedProjects, stackLabel, captureSrcset } from '../../data/projets';
import Breadcrumb from '../Breadcrumb.astro';
import CtaBand from '../CtaBand.astro';
import LighthouseScores from '../LighthouseScores.astro';
import ExternalIcon from '../ExternalIcon.astro';
import { lighthouse } from '../../data/lighthouse';
import { temoignages } from '../../data/temoignages';
import Todo from '../Todo.astro';
import HabitaLoop from '../HabitaLoop.astro';

interface Props {
  locale: Locale;
  project: Project;
}
const { locale, project } = Astro.props;
const tr = useTranslations(locale);
const ws = tr.workSection;

// Measured scores for this project's live site, if it has been measured.
const score = lighthouse[project.slug] ?? null;

// Next case study, wrapping around — a dead end at the bottom of a case study
// is a wasted exit.
const all = await sortedProjects();
const idx = all.findIndex((p) => p.slug === project.slug);
const next = all[(idx + 1) % all.length];
const others = all.filter((p) => p.slug !== project.slug && p.slug !== next.slug);

const shot = project.image;
const contain = project.fit === 'contain';
const isHabita = project.slug === 'habita';
const shotAlt = isHabita ? ws.habitaAlt : ws.shotAlt(loc(project.title, locale));


const crumbs = [
  { name: tr.breadcrumb.home, url: path('home', locale) },
  { name: tr.nav.work, url: path('work', locale) },
  { name: loc(project.title, locale), url: `${workBase[locale]}/${project.slug}` },
];

const blocks = [
  { label: ws.challenge, body: loc(project.challenge, locale) },
  { label: ws.built, body: loc(project.built, locale) },
  ...(project.field ? [{ label: ws.field, body: loc(project.field, locale) }] : []),
  { label: ws.result, body: loc(project.result, locale) },
];
// The client's own words: an approved quote from the project file, or else
// their public Google review, verbatim, when one is tied to this project.
const review = temoignages.find((t) => t.project === project.slug);
const quote = project.testimonial ?? (review
  ? { quote: { fr: review.text, en: review.text }, author: review.author, title: { fr: 'Avis Google', en: 'Google review' }, lang: review.lang }
  : null);

const specs = [
  { k: ws.role, v: loc(project.role, locale) },
  { k: ws.year, v: project.year },
  ...(project.live ? [] : [{ k: ws.status, v: ws.notLive }]),
];
---

<Breadcrumb items={crumbs} />

<article class="case" style={`--accent:${project.accent}`}>
  <header class="case__head container-wide">
    {project.draft && (
      <p class="case__draft" role="note">
        {locale === 'fr'
          ? 'Brouillon : visible seulement en local (npm run dev), jamais publié tant que « publié » vaut false.'
          : 'Draft: local preview only (npm run dev). Never built while “publié” is false.'}
      </p>
    )}
    <p class="label label-rule">{project.client} · {project.year}</p>
    <h1 class="case__title">{loc(project.title, locale)}</h1>
    <p class="case__tagline">{loc(project.tagline, locale)}</p>

    <dl class="case__specs">
      <div class="case__spec">
        <dt>{ws.client}</dt>
        <dd>
          {project.logo && project.live ? (
            <a href={project.url} class="case__client" target="_blank" rel="noopener">
              <img src={project.logo} alt="" class="case__logo" height="40" decoding="async" />
              <span>{project.client}</span>
            </a>
          ) : project.logo ? (
            <span class="case__client">
              <img src={project.logo} alt="" class="case__logo" height="40" decoding="async" />
              <span>{project.client}</span>
            </span>
          ) : project.client}
        </dd>
      </div>
      {specs.map((s) => (
        <div class="case__spec">
          <dt>{s.k}</dt>
          <dd>{s.v}</dd>
        </div>
      ))}
      <div class="case__spec case__spec--stack">
        <dt>{ws.stack}</dt>
        <dd>
          <ul class="case__stack">
            {project.stack.map((s) => <li>{stackLabel(s, locale)}</li>)}
          </ul>
        </dd>
      </div>
    </dl>

    {project.live && (
      <a href={project.url} class="btn btn-accent case__visit" target="_blank" rel="noopener">
        {tr.cta.visitSite}
        <ExternalIcon />
      </a>
    )}
    {import.meta.env.DEV && project.todo.length > 0 && (
      <ul class="case__todo">{project.todo.map((t) => <li><Todo what={t} /></li>)}</ul>
    )}
  </header>

  {shot && (
    <div class="container-wide case__media reveal-clip">
      <figure class:list={['case__shot', contain && 'case__shot--contain']}>
        {isHabita ? (
          <a href={project.url} target="_blank" rel="noopener" aria-label={tr.cta.visitSite}>
            <HabitaLoop poster={shot} srcset={captureSrcset(shot)} sizes="(min-width: 1320px) 1208px, 100vw" alt={shotAlt} />
          </a>
        ) : project.live ? (
          <a href={project.url} target="_blank" rel="noopener" aria-label={tr.cta.visitSite}>
            <img src={shot} srcset={captureSrcset(shot)} sizes="(min-width: 1320px) 1208px, 100vw" alt={shotAlt} width="1280" height="800" loading="lazy" decoding="async" />
          </a>
        ) : (
          <img src={shot} srcset={captureSrcset(shot)} sizes="(min-width: 1320px) 1208px, 100vw" alt={shotAlt} width="1280" height="800" loading="lazy" decoding="async" />
        )}
      </figure>
    </div>
  )}

  {score && (
    <section class="container-wide case__bench">
      <h2 class="label case__bench-label">{tr.lighthouse.caseTitle}</h2>
      <LighthouseScores locale={locale} score={score} variant="compact" />
    </section>
  )}

  <div class="container-wide case__body">
    {blocks.map((b, i) => (
      <section class="case__block reveal" data-delay={`${i * 60}ms`}>
        <h2 class="case__block-label">
          <span class="index-num">{String(i + 1).padStart(2, '0')}</span>
          <span>{b.label}</span>
        </h2>
        <div class="case__block-body prose">
          <p>{b.body}</p>
        </div>
      </section>
    ))}
  </div>

  {quote && (
    <section class="container-wide case__quote reveal" aria-labelledby="case-quote-label">
      <h2 class="label label-rule" id="case-quote-label">{'heading' in quote && quote.heading ? loc(quote.heading, locale) : ws.testimonial}</h2>
      {'intro' in quote && quote.intro && <p class="case__quote-intro">{loc(quote.intro, locale)}</p>}
      <figure>
        <blockquote class="case__quote-text">
          <p lang={'lang' in quote && quote.lang !== locale ? quote.lang : undefined}>{loc(quote.quote, locale)}</p>
        </blockquote>
        <figcaption class="case__quote-by">
          <span>{quote.author}</span>
          <span class="case__quote-title">{loc(quote.title, locale)}</span>
          {'original' in quote && quote.original && quote.original !== locale && (
            <span class="case__quote-note">{ws.translatedFrom[quote.original]}</span>
          )}
        </figcaption>
      </figure>
    </section>
  )}

  <nav class="container-wide case__next" aria-label={tr.nav.work}>
    <div class="case__next-row">
      <a href={`${workBase[locale]}/${next.slug}`} class="case__next-link">
        <span class="label case__next-label">
          {ws.next}
        </span>
        <span class="case__next-title">{loc(next.title, locale)}</span>
        <span class="case__next-arrow" aria-hidden="true">→</span>
      </a>
      <a href={path('work', locale)} class="link case__all">{tr.cta.allWork}</a>
    </div>

    {/* The remaining case studies stay one click away rather than two: the
        "next" link alone would leave every other project reachable only via
        the index. */}
    {others.length > 0 && (
      <ul class="case__others">
        {others.map((o) => (
          <li>
            <a href={`${workBase[locale]}/${o.slug}`}>{loc(o.title, locale)}</a>
          </li>
        ))}
      </ul>
    )}
  </nav>
</article>

<CtaBand locale={locale} />

<style>
  .case__todo { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: 0.4rem; }
  /* ---- Masthead ----------------------------------------------------------- */
  .case__quote {
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }
  .case__quote figure { margin: 1.5rem 0 0; max-width: 60ch; }
  .case__quote-intro { margin: 1.5rem 0 0; max-width: 60ch; color: var(--fg-mute); line-height: 1.6; }
  .case__quote-text {
    margin: 0;
    font-size: var(--fs-lead);
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .case__quote-text p { margin: 0; }
  .case__quote-by {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
  }
  .case__quote-title { color: var(--fg-mute); }
  .case__quote-note { flex-basis: 100%; color: var(--fg-mute); font-style: italic; }
  .case__client { display: inline-flex; flex-direction: column; align-items: flex-start; gap: 0.5rem; color: inherit; }
  a.case__client:hover span, a.case__client:focus-visible span { text-decoration: underline; }
  .case__logo { display: block; height: 40px; width: auto; max-width: 100%; }
  .case__draft {
    margin: 0 0 1.5rem;
    padding: 0.75rem 1rem;
    border: 1px dashed var(--vermilion);
    color: var(--vermilion-text);
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
  }
  .case__head {
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(2rem, 4vw, 3rem);
  }
  .case__title {
    font-size: var(--fs-xxl);
    font-weight: var(--fw-thin);
    letter-spacing: -0.035em;
    margin: 1.25rem 0 0;
    max-width: 18ch;
  }
  .case__tagline {
    color: var(--fg-dim);
    font-size: var(--fs-lead);
    line-height: 1.5;
    max-width: 56ch;
    margin: 1.25rem 0 0;
  }

  .case__specs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    border-top: 1px solid var(--line);
  }
  .case__spec {
    padding: 1.1rem clamp(0.75rem, 2vw, 1.5rem) 1.1rem 0;
    border-right: 1px solid var(--line-soft);
  }
  .case__spec + .case__spec { padding-left: clamp(0.75rem, 2vw, 1.5rem); }
  .case__spec:last-child { border-right: 0; }
  .case__spec dt {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-mute);
    margin-bottom: 0.45rem;
  }
  .case__spec dd {
    margin: 0;
    font-size: var(--fs-meta);
    line-height: 1.5;
    color: var(--fg);
  }
  .case__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    color: var(--fg-dim);
  }
  .case__stack li + li::before {
    content: "/";
    margin-right: 0.75rem;
    opacity: 0.45;
  }

  .case__visit { margin-top: clamp(1.5rem, 3vw, 2rem); }

  /* ---- Hero media --------------------------------------------------------- */
  .case__media { margin-top: clamp(1.5rem, 3vw, 2.5rem); }
  .case__shot {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--ink-raised);
  }
  .case__shot img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
    transition: transform var(--t-slow) var(--ease-out);
  }
  .case__shot:hover img { transform: scale(1.015); }
  .case__shot--contain {
    padding: clamp(1rem, 3vw, 2.5rem);
    background:
      radial-gradient(70% 78% at 50% 48%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 72%),
      var(--ink-raised);
  }
  .case__shot--contain img { object-fit: contain; }

  /* ---- Benchmark ---------------------------------------------------------- */
  .case__bench { margin-top: clamp(2.5rem, 5vw, 4rem); }
  .case__bench-label { margin-bottom: 1rem; }

  /* ---- Narrative ----------------------------------------------------------
     Mono label sits in the margin, prose stays on a readable measure — the
     asymmetry is the point. */
  .case__body {
    margin-top: clamp(3rem, 6vw, 5rem);
  }
  .case__block {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 8fr);
    gap: clamp(1rem, 4vw, 3.5rem);
    padding-block: clamp(1.75rem, 3.5vw, 2.75rem);
    border-top: 1px solid var(--line);
  }
  .case__block-label {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-mute);
    margin: 0;
  }
  .case__block-body {
    max-width: 68ch;
  }
  .case__block-body p {
    font-size: var(--fs-body);
    line-height: 1.75;
  }

  /* ---- Next --------------------------------------------------------------- */
  .case__next {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: clamp(1.5rem, 3vw, 2rem);
    border-top: 1px solid var(--line);
  }
  .case__next-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem 2rem;
  }
  .case__others {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem clamp(1rem, 3vw, 2rem);
    margin-top: clamp(1.25rem, 3vw, 2rem);
    padding-top: 1rem;
    border-top: 1px solid var(--line-soft);
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
  }
  .case__others a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    color: var(--fg-mute);
    transition: color var(--t-fast) var(--ease);
  }
  .case__others a:hover { color: var(--fg); }
  .case__next-link {
    display: grid;
    grid-template-columns: auto auto;
    align-items: baseline;
    gap: 0.4rem 1rem;
  }
  .case__next-label { grid-column: 1 / -1; }
  .case__next-title {
    font-size: clamp(1.5rem, 3.5vw, 2.5rem);
    font-family: var(--font-display);
    font-weight: var(--fw-light);
    letter-spacing: -0.03em;
    transition: color var(--t-fast) var(--ease);
  }
  .case__next-arrow {
    font-size: 1.25rem;
    color: var(--accent-fg);
    transition: transform var(--t-base) var(--ease-out);
  }
  .case__next-link:hover .case__next-title { color: var(--accent-fg); }
  .case__next-link:hover .case__next-arrow { transform: translateX(5px); }

  /* ---- Responsive --------------------------------------------------------- */
  @media (max-width: 900px) {
    .case__specs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .case__spec,
    .case__spec + .case__spec {
      border-right: 0;
      border-bottom: 1px solid var(--line-soft);
      padding-inline: 0 1rem;
    }
    .case__spec:nth-child(odd) { border-right: 1px solid var(--line-soft); }
    .case__spec:nth-child(even) { padding-inline: 1rem 0; }
  }
  @media (max-width: 760px) {
    .case__block { grid-template-columns: 1fr; gap: 0.9rem; }
  }
  @media (max-width: 480px) {
    .case__specs { grid-template-columns: 1fr; }
    .case__spec,
    .case__spec + .case__spec,
    .case__spec:nth-child(odd),
    .case__spec:nth-child(even) {
      border-right: 0;
      padding-inline: 0;
    }
  }
</style>
