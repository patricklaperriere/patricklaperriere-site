---
import { useTranslations, path } from '../../i18n';
import type { Locale } from '../../i18n/routes';
import { concepts, loc } from '../../data/concepts';
import Breadcrumb from '../Breadcrumb.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = useTranslations(locale);
const c = tr.concepts;
const fr = locale === 'fr';

const crumbs = [
  { name: tr.breadcrumb.home, url: path('home', locale) },
  { name: c.crumb, url: '' },
];
---

<Breadcrumb items={crumbs} />

<section class="page-head container-pl">
  <p class="kicker reveal">{c.kicker}</p>
  <h1 class="reveal" data-delay="80ms"><span class="text-gold-grad">{c.h1}</span></h1>
  <p class="lead reveal" data-delay="160ms">{c.lead}</p>
  <p class="cpt-note reveal" data-delay="220ms">{c.note}</p>
</section>

<section class="section-tight container-pl">
  <div class="cpt-grid">
    {concepts.map((cc, i) => (
      <article class="cpt reveal" data-id={cc.id} style={`--c:${cc.accent}`} data-delay={`${(i % 2) * 90}ms`}>
        <div class="cpt-stage" data-tilt>
          {cc.device === 'phone' ? (
            <div class="phone">
              <span class="phone__notch"></span>
              <div class="phone__screen">
                <div class="statusbar"><span>9:41</span><span class="statusbar__dots"><i></i><i></i><i></i></span></div>

                {cc.id === 'barber' && (
                  <div class="ui ui--barber">
                    <header class="ui__top"><span class="ui__brand">FADE</span><span class="ui__hi">{fr ? 'Salut, Marco' : 'Hey, Marco'}</span></header>
                    <div class="card next">
                      <span class="next__label">{fr ? 'Prochain rendez-vous' : 'Next appointment'}</span>
                      <span class="next__time">{fr ? 'Sam. 14 juin · 11 h 30' : 'Sat Jun 14 · 11:30'}</span>
                      <span class="next__who">{fr ? 'avec Dom · Coupe + barbe' : 'with Dom · Cut + beard'}</span>
                    </div>
                    <p class="ui__sec">{fr ? 'Choisis ton barbier' : 'Pick your barber'}</p>
                    <div class="avatars">
                      <span class="av av--on">D</span><span class="av">K</span><span class="av">M</span><span class="av">J</span>
                    </div>
                    <p class="ui__sec">{fr ? 'Disponibilités' : 'Availability'}</p>
                    <div class="slots">
                      <span class="slot">10:00</span><span class="slot slot--on">11:30</span><span class="slot">13:00</span><span class="slot">14:30</span>
                    </div>
                    <button class="cta">{fr ? 'Réserver' : 'Book now'}</button>
                  </div>
                )}

                {cc.id === 'fitness' && (
                  <div class="ui ui--fitness">
                    <header class="ui__top"><span class="ui__brand">PULSE</span><span class="ui__hi">{fr ? 'Aujourd’hui' : 'Today'}</span></header>
                    <div class="ring">
                      <div class="ring__center"><b>780</b><span>kcal</span></div>
                    </div>
                    <div class="stats">
                      <div class="stat"><b>🔥 12</b><span>{fr ? 'jours' : 'day streak'}</span></div>
                      <div class="stat"><b>4/5</b><span>{fr ? 'cours' : 'classes'}</span></div>
                      <div class="stat"><b>68 %</b><span>{fr ? 'objectif' : 'goal'}</span></div>
                    </div>
                    <div class="card classcard">
                      <span class="classcard__t">HIIT · 18:30</span>
                      <span class="classcard__s">{fr ? 'Studio A · 6 places restantes' : 'Studio A · 6 spots left'}</span>
                    </div>
                    <button class="cta">{fr ? 'S’inscrire' : 'Reserve spot'}</button>
                  </div>
                )}

                {cc.id === 'cafe' && (
                  <div class="ui ui--cafe">
                    <header class="ui__top"><span class="ui__brand">Grain</span><span class="ui__hi">☕</span></header>
                    <div class="card loyalty">
                      <span class="loyalty__t">{fr ? 'Carte de fidélité' : 'Loyalty card'}</span>
                      <div class="stamps">
                        {Array.from({ length: 10 }).map((_, s) => (
                          <span class={`stamp ${s < 8 ? 'stamp--on' : ''}`}>{s < 8 ? '★' : ''}</span>
                        ))}
                      </div>
                      <span class="loyalty__s">{fr ? 'Plus que 2 cafés pour un gratuit' : '2 more coffees for a free one'}</span>
                    </div>
                    <div class="card usual">
                      <span class="usual__t">{fr ? 'Ta commande habituelle' : 'Your usual'}</span>
                      <span class="usual__s">{fr ? 'Latte avoine · grand' : 'Oat latte · large'}</span>
                    </div>
                    <button class="cta">{fr ? 'Commander · 5,25 $' : 'Order · $5.25'}</button>
                  </div>
                )}
              </div>
            </div>
          ) : (
            <div class="browser">
              <div class="browser__bar">
                <span class="dots"><i></i><i></i><i></i></span>
                <span class="url">{cc.brand.toLowerCase()}.{fr ? 'ca' : 'co'}</span>
              </div>
              <div class="browser__screen">
                {cc.id === 'resto' && (
                  <div class="site site--resto">
                    <header class="site__nav"><b>Brassé</b><span>Menu · {fr ? 'Réserver' : 'Reserve'} · {fr ? 'Contact' : 'Contact'}</span></header>
                    <div class="resto__hero">
                      <div class="resto__plate"><img src="/concepts/resto.webp" alt="" loading="lazy" decoding="async" width="380" height="380" /></div>
                      <div class="resto__copy">
                        <span class="resto__kick">{fr ? 'Cuisine du marché' : 'Market kitchen'}</span>
                        <h3>{fr ? 'Le goût, sans flafla.' : 'Real food, no fuss.'}</h3>
                        <button class="cta">{fr ? 'Réserver une table' : 'Book a table'}</button>
                      </div>
                    </div>
                    <div class="resto__menu">
                      <div class="mrow"><span>{fr ? 'Tartare de cerf' : 'Venison tartare'}</span><b>21</b></div>
                      <div class="mrow"><span>{fr ? 'Pâtes fraîches, beurre noisette' : 'Fresh pasta, brown butter'}</span><b>26</b></div>
                      <div class="mrow"><span>{fr ? 'Tarte au sucre' : 'Sugar pie'}</span><b>11</b></div>
                    </div>
                  </div>
                )}

                {cc.id === 'immobilier' && (
                  <div class="site site--immo">
                    <header class="site__nav"><b>Domaine</b><span class="immo__search">{fr ? 'Rechercher une ville…' : 'Search a city…'}</span></header>
                    <div class="immo__card">
                      <div class="immo__img">
                        <img src="/concepts/immobilier.webp" alt="" loading="lazy" decoding="async" width="640" height="420" />
                        <span class="immo__tag">{fr ? 'À vendre' : 'For sale'}</span>
                      </div>
                      <div class="immo__body">
                        <b class="immo__price">749 000 $</b>
                        <span class="immo__addr">{fr ? '12 rue des Érables, Laval' : '12 Maple St, Laval'}</span>
                        <span class="immo__specs">4 {fr ? 'ch' : 'bd'} · 2 {fr ? 'sdb' : 'ba'} · 2 100 pi²</span>
                      </div>
                    </div>
                    <div class="immo__thumbs"><span></span><span></span><span></span></div>
                  </div>
                )}

                {cc.id === 'clinique' && (
                  <div class="site site--clinic">
                    <header class="site__nav"><b>Émail</b><span>{fr ? 'Services · Équipe · Rendez-vous' : 'Services · Team · Booking'}</span></header>
                    <div class="clinic__hero">
                      <div class="clinic__copy">
                        <span class="clinic__kick">{fr ? 'Clinique dentaire' : 'Dental clinic'}</span>
                        <h3>{fr ? 'Des sourires en santé.' : 'Healthy, happy smiles.'}</h3>
                        <div class="clinic__badges"><span>✓ {fr ? 'Sans douleur' : 'Pain-free'}</span><span>✓ {fr ? 'Urgences' : 'Emergencies'}</span></div>
                      </div>
                      <div class="card clinic__book">
                        <span class="clinic__bt">{fr ? 'Prendre rendez-vous' : 'Book a visit'}</span>
                        <div class="clinic__days"><span>L 9</span><span class="on">M 10</span><span>M 11</span><span>J 12</span></div>
                        <div class="clinic__times"><span class="on">9:30</span><span>11:00</span><span>14:15</span></div>
                        <button class="cta">{fr ? 'Confirmer' : 'Confirm'}</button>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            </div>
          )}
        </div>

        <div class="cpt-meta">
          <span class="cpt-industry">{loc(cc.industry, locale)}</span>
          <h2 class="cpt-brand">{cc.brand}</h2>
          <p class="cpt-tagline">{loc(cc.tagline, locale)}</p>
          <span class="cpt-live"><span class="cpt-live__dot"></span>{c.live}</span>
        </div>
      </article>
    ))}
  </div>
</section>

{/* Closing CTA */}
<section class="section">
  <div class="container-pl cpt-cta reveal">
    <p class="kicker">{c.ctaTitle}</p>
    <h2 class="cpt-cta__title">{c.ctaLead}</h2>
    <a href={path('contact', locale)} class="btn btn-primary magnetic" data-magnetic="0.25">
      {tr.cta.primary} <span aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  .cpt-note {
    margin: 1rem 0 0;
    color: var(--color-fog);
    font-size: 0.92rem;
    max-width: 60ch;
    font-style: italic;
  }

  .cpt-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 4vw, 3rem);
  }
  .cpt {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .cpt-stage {
    width: 100%;
    display: flex;
    justify-content: center;
    padding: clamp(1.5rem, 4vw, 3rem) 1rem;
    border-radius: 24px;
    background:
      radial-gradient(80% 70% at 50% 30%, color-mix(in srgb, var(--c) 16%, transparent), transparent 70%),
      rgba(238, 241, 246, 0.02);
    border: 1px solid var(--line);
    transition: transform 0.3s cubic-bezier(.2,.8,.2,1), border-color 0.3s;
    transform-style: preserve-3d;
    perspective: 1000px;
  }
  .cpt:hover .cpt-stage { border-color: color-mix(in srgb, var(--c) 45%, transparent); }

  .cpt-meta { margin-top: 1.5rem; }
  .cpt-industry {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--c);
  }
  .cpt-brand { font-size: 1.6rem; margin: 0.5rem 0 0.5rem; }
  .cpt-tagline { color: var(--color-fog); font-size: 0.96rem; line-height: 1.55; margin: 0 auto; max-width: 36ch; }
  .cpt-live {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--color-fog);
  }
  .cpt-live__dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--c) 70%, transparent);
    animation: cptpulse 2s infinite;
  }
  @keyframes cptpulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--c) 55%, transparent); }
    70% { box-shadow: 0 0 0 7px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  /* ---- Phone frame ---- */
  .phone {
    position: relative;
    width: 248px;
    height: 510px;
    border-radius: 40px;
    background: #05080d;
    border: 1px solid rgba(255,255,255,0.12);
    padding: 9px;
    box-shadow: 0 40px 80px -30px rgba(0,0,0,0.8), inset 0 0 0 2px rgba(255,255,255,0.03);
  }
  .phone__notch {
    position: absolute;
    top: 12px; left: 50%; transform: translateX(-50%);
    width: 90px; height: 22px; border-radius: 0 0 14px 14px;
    background: #05080d; z-index: 3;
  }
  .phone__screen {
    width: 100%; height: 100%;
    border-radius: 32px;
    overflow: hidden;
    background: var(--bg);
    color: var(--txt);
    display: flex;
    flex-direction: column;
  }

  /* ---- Browser frame ---- */
  .browser {
    width: 380px;
    max-width: 100%;
    border-radius: 14px;
    overflow: hidden;
    background: var(--bg);
    border: 1px solid rgba(255,255,255,0.10);
    box-shadow: 0 40px 80px -30px rgba(0,0,0,0.8);
  }
  .browser__bar {
    display: flex; align-items: center; gap: 0.8rem;
    padding: 0.6rem 0.9rem;
    background: color-mix(in srgb, var(--bg) 80%, #000);
    border-bottom: 1px solid rgba(0,0,0,0.08);
  }
  .dots { display: inline-flex; gap: 5px; }
  .dots i { width: 9px; height: 9px; border-radius: 50%; background: rgba(150,150,150,0.45); }
  .dots i:first-child { background: #ff5f57; }
  .dots i:nth-child(2) { background: #febc2e; }
  .dots i:last-child { background: #28c840; }
  .url {
    flex: 1;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--txt2);
    background: color-mix(in srgb, var(--bg) 60%, #fff 0%);
    background: rgba(0,0,0,0.06);
    border-radius: 7px;
    padding: 0.25rem 0.6rem;
    text-align: center;
  }
  .browser__screen { padding: 0; }

  /* ---- Status bar (phone) ---- */
  .statusbar {
    display: flex; justify-content: space-between; align-items: center;
    padding: 0.7rem 1.1rem 0.2rem;
    font-size: 0.7rem; font-weight: 600;
    color: var(--txt);
  }
  .statusbar__dots { display: inline-flex; gap: 3px; }
  .statusbar__dots i { width: 5px; height: 5px; border-radius: 50%; background: var(--txt); opacity: 0.55; }

  /* ---- Generic UI bits ---- */
  .ui { padding: 0.6rem 1.1rem 1.1rem; display: flex; flex-direction: column; gap: 0.7rem; height: 100%; }
  .ui__top { display: flex; align-items: baseline; justify-content: space-between; }
  .ui__brand { font-weight: 800; letter-spacing: 0.04em; font-size: 1.05rem; color: var(--c); }
  .ui__hi { font-size: 0.78rem; color: var(--txt2); }
  .ui__sec { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--txt2); margin: 0.2rem 0 0; }
  .card {
    background: var(--surf);
    border: 1px solid color-mix(in srgb, var(--txt) 8%, transparent);
    border-radius: 14px;
    padding: 0.8rem 0.9rem;
    display: flex; flex-direction: column; gap: 0.2rem;
  }
  .cta {
    margin-top: auto;
    border: none;
    border-radius: 12px;
    padding: 0.75rem;
    font-weight: 700;
    font-size: 0.85rem;
    color: #0a0a0a;
    background: var(--c);
    cursor: pointer;
    transition: transform 0.2s ease, filter 0.2s ease;
  }
  .cpt-stage:hover .cta { filter: brightness(1.08); transform: translateY(-1px); }

  /* Barber palette + bits */
  .cpt[data-id='barber'] { --bg: #14100a; --surf: #221a0e; --txt: #f3e9d6; --txt2: #9c8d70; }
  .next__label { font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--c); }
  .next__time { font-weight: 700; font-size: 0.98rem; }
  .next__who { font-size: 0.76rem; color: var(--txt2); }
  .avatars { display: flex; gap: 0.5rem; }
  .av {
    width: 42px; height: 42px; border-radius: 50%;
    display: grid; place-items: center;
    font-weight: 700; font-size: 0.85rem;
    background: var(--surf); color: var(--txt2);
    border: 1px solid color-mix(in srgb, var(--txt) 10%, transparent);
  }
  .av--on { color: #0a0a0a; background: var(--c); border-color: var(--c); box-shadow: 0 0 0 3px color-mix(in srgb, var(--c) 30%, transparent); }
  .slots { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.4rem; }
  .slot { font-size: 0.72rem; text-align: center; padding: 0.5rem 0; border-radius: 9px; background: var(--surf); color: var(--txt2); border: 1px solid color-mix(in srgb, var(--txt) 8%, transparent); }
  .slot--on { background: var(--c); color: #0a0a0a; font-weight: 700; border-color: var(--c); }

  /* Fitness palette + bits */
  .cpt[data-id='fitness'] { --bg: #0b1007; --surf: #15200c; --txt: #eafbe0; --txt2: #8aa07a; }
  .ring {
    width: 140px; height: 140px; border-radius: 50%;
    margin: 0.3rem auto;
    background:
      radial-gradient(closest-side, var(--bg) 70%, transparent 72% 100%),
      conic-gradient(var(--c) 68%, color-mix(in srgb, var(--c) 16%, transparent) 0);
    display: grid; place-items: center;
  }
  .ring__center { text-align: center; line-height: 1; }
  .ring__center b { font-size: 1.7rem; font-weight: 800; }
  .ring__center span { font-size: 0.7rem; color: var(--txt2); }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.4rem; }
  .stat { background: var(--surf); border-radius: 11px; padding: 0.55rem 0.3rem; text-align: center; }
  .stat b { display: block; font-size: 0.86rem; }
  .stat span { font-size: 0.62rem; color: var(--txt2); }
  .classcard__t { font-weight: 700; font-size: 0.9rem; }
  .classcard__s { font-size: 0.74rem; color: var(--txt2); }

  /* Cafe palette + bits */
  .cpt[data-id='cafe'] { --bg: #18120b; --surf: #271c12; --txt: #f3e6d6; --txt2: #b09372; }
  .loyalty__t { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--c); }
  .stamps { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.4rem; margin: 0.5rem 0; }
  .stamp {
    aspect-ratio: 1; border-radius: 50%;
    display: grid; place-items: center;
    font-size: 0.7rem;
    border: 1.5px dashed color-mix(in srgb, var(--txt) 22%, transparent);
    color: transparent;
  }
  .stamp--on { background: var(--c); color: #0a0a0a; border-style: solid; border-color: var(--c); }
  .loyalty__s { font-size: 0.74rem; color: var(--txt2); }
  .usual__t { font-size: 0.74rem; color: var(--txt2); }
  .usual__s { font-weight: 700; font-size: 0.9rem; }

  /* ---- Website sites (light) ---- */
  .site { display: flex; flex-direction: column; }
  .site__nav {
    display: flex; align-items: center; justify-content: space-between;
    padding: 0.7rem 1rem;
    font-size: 0.74rem;
    border-bottom: 1px solid rgba(0,0,0,0.06);
  }
  .site__nav b { font-size: 0.95rem; color: var(--c); letter-spacing: 0.01em; }
  .site__nav span { color: var(--txt2); }
  .site .cta { color: #fff; }

  /* Resto (cream) */
  .cpt[data-id='resto'] { --bg: #fbf4ec; --surf: #ffffff; --txt: #2a211c; --txt2: #8a7a6c; }
  .resto__hero { display: grid; grid-template-columns: 1fr 1.1fr; gap: 0.8rem; padding: 1rem; align-items: center; }
  .resto__plate {
    aspect-ratio: 1; border-radius: 50%;
    background:
      radial-gradient(circle at 38% 34%, #f0c9a0, transparent 42%),
      radial-gradient(circle at 65% 62%, color-mix(in srgb, var(--c) 70%, #000) , transparent 46%),
      conic-gradient(from 200deg, #caa37a, #a9744f, #caa37a);
    box-shadow: inset 0 0 0 8px #fff, inset 0 0 0 9px rgba(0,0,0,0.06);
    position: relative;
  }
  .resto__plate img {
    position: absolute;
    inset: 8px;
    width: calc(100% - 16px);
    height: calc(100% - 16px);
    object-fit: cover;
    border-radius: 50%;
  }
  .resto__kick { font-size: 0.64rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--c); font-weight: 700; }
  .resto__copy h3 { font-size: 1.15rem; margin: 0.3rem 0 0.7rem; color: var(--txt); line-height: 1.15; }
  .resto__menu { padding: 0 1rem 1rem; display: flex; flex-direction: column; gap: 0.45rem; }
  .mrow { display: flex; justify-content: space-between; font-size: 0.78rem; color: var(--txt); padding-bottom: 0.4rem; border-bottom: 1px dotted rgba(0,0,0,0.12); }
  .mrow b { color: var(--c); }

  /* Immobilier (cool white) */
  .cpt[data-id='immobilier'] { --bg: #f5f7fb; --surf: #ffffff; --txt: #1a2230; --txt2: #6b7689; }
  .immo__search { background: rgba(0,0,0,0.05); border-radius: 7px; padding: 0.25rem 0.7rem; font-size: 0.68rem; }
  .immo__card { margin: 1rem; border-radius: 14px; overflow: hidden; background: var(--surf); box-shadow: 0 12px 30px -16px rgba(0,0,0,0.3); }
  .immo__img {
    height: 120px; position: relative; overflow: hidden;
    background: linear-gradient(135deg, #b8c6dd, #8ca3c4 60%, #6f86a8);
  }
  .immo__img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .immo__tag { position: absolute; z-index: 2; top: 10px; left: 10px; background: var(--c); color: #fff; font-size: 0.62rem; font-weight: 700; padding: 0.2rem 0.55rem; border-radius: 6px; }
  .immo__body { padding: 0.8rem 0.9rem; display: flex; flex-direction: column; gap: 0.2rem; }
  .immo__price { font-size: 1.2rem; color: var(--txt); }
  .immo__addr { font-size: 0.78rem; color: var(--txt2); }
  .immo__specs { font-size: 0.72rem; color: var(--c); font-weight: 600; margin-top: 0.15rem; }
  .immo__thumbs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; padding: 0 1rem 1rem; }
  .immo__thumbs span { height: 44px; border-radius: 9px; background: linear-gradient(135deg, #cdd7e6, #9fb1cc); }

  /* Clinique (mint) */
  .cpt[data-id='clinique'] { --bg: #f0fbfa; --surf: #ffffff; --txt: #14302c; --txt2: #5e8a83; }
  .clinic__hero { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; padding: 1rem; }
  .clinic__kick { font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--c); font-weight: 700; }
  .clinic__copy h3 { font-size: 1.1rem; margin: 0.3rem 0 0.7rem; color: var(--txt); line-height: 1.15; }
