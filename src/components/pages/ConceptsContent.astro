---
import { useTranslations, path } from '../../i18n';
import type { Locale } from '../../i18n/routes';
import { phoneConcepts, browserConcepts, saasConcepts, loc } from '../../data/concepts';
import Breadcrumb from '../Breadcrumb.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = useTranslations(locale);
const c = tr.concepts;
const fr = locale === 'fr';

const crumbs = [
  { name: tr.breadcrumb.home, url: path('home', locale) },
  { name: c.crumb, url: '' },
];
---

<Breadcrumb items={crumbs} />

<section class="page-head container-pl">
  <p class="kicker reveal">{c.kicker}</p>
  <h1 class="reveal" data-delay="80ms"><span class="text-gold-grad">{c.h1}</span></h1>
  <p class="lead reveal" data-delay="160ms">{c.lead}</p>
  <p class="cpt-note reveal" data-delay="220ms">{c.note}</p>
</section>

{/* ---------- Mobile apps ---------- */}
<section class="section-tight container-pl">
  <header class="cpt-secthead reveal">
    <span class="cpt-secnum">01</span>
    <div>
      <h2 class="section-head__title">{c.mobileTitle}</h2>
      <p class="cpt-seclead">{c.mobileLead}</p>
    </div>
  </header>

  <div class="cpt-row cpt-row--phones">
    {phoneConcepts.map((cc, i) => (
      <article class="cpt reveal" data-id={cc.id} style={`--c:${cc.accent}`} data-delay={`${i * 70}ms`}>
        <div class="cpt-stage" data-tilt>
          <div class="phone">
            <span class="phone__notch"></span>
            <div class="phone__screen">
              <div class="statusbar"><span>9:41</span><span class="statusbar__dots"><i></i><i></i><i></i></span></div>

              {cc.id === 'barber' && (
                <div class="ui ui--barber">
                  <header class="ui__top"><span class="ui__brand">FADE</span><span class="ui__hi">{fr ? 'Salut, Marco' : 'Hey, Marco'}</span></header>
                  <div class="photo photo--barber"><img src="/concepts/barber.webp" alt="" loading="lazy" decoding="async" width="620" height="360" /><span class="photo__cap">{fr ? 'FADE · Chomedey, Laval' : 'FADE · Chomedey, Laval'}</span></div>
                  <p class="ui__sec">{fr ? 'Choisis ton barbier' : 'Pick your barber'}</p>
                  <div class="avatars"><span class="av av--on">D</span><span class="av">K</span><span class="av">M</span><span class="av">J</span></div>
                  <div class="slots"><span class="slot">10:00</span><span class="slot slot--on">11:30</span><span class="slot">13:00</span><span class="slot">14:30</span></div>
                  <button class="cta">{fr ? 'Réserver' : 'Book now'}</button>
                </div>
              )}

              {cc.id === 'fitness' && (
                <div class="ui ui--fitness">
                  <header class="ui__top"><span class="ui__brand">PULSE</span><span class="ui__hi">{fr ? 'Aujourd’hui' : 'Today'}</span></header>
                  <div class="ring"><div class="ring__center"><b>780</b><span>kcal</span></div></div>
                  <div class="stats">
                    <div class="stat"><b>🔥 12</b><span>{fr ? 'jours' : 'streak'}</span></div>
                    <div class="stat"><b>4/5</b><span>{fr ? 'cours' : 'classes'}</span></div>
                    <div class="stat"><b>68 %</b><span>{fr ? 'objectif' : 'goal'}</span></div>
                  </div>
                  <div class="card classcard"><span class="classcard__t">HIIT · 18:30</span><span class="classcard__s">{fr ? 'Studio A · 6 places' : 'Studio A · 6 spots'}</span></div>
                  <button class="cta">{fr ? 'S’inscrire' : 'Reserve spot'}</button>
                </div>
              )}

              {cc.id === 'cafe' && (
                <div class="ui ui--cafe">
                  <header class="ui__top"><span class="ui__brand">Grain</span><span class="ui__hi">☕</span></header>
                  <div class="photo photo--cafe"><img src="/concepts/latte.webp" alt="" loading="lazy" decoding="async" width="320" height="320" /></div>
                  <div class="card loyalty">
                    <span class="loyalty__t">{fr ? 'Carte de fidélité' : 'Loyalty card'}</span>
                    <div class="stamps">{Array.from({ length: 10 }).map((_, s) => (<span class={`stamp ${s < 8 ? 'stamp--on' : ''}`}>{s < 8 ? '★' : ''}</span>))}</div>
                    <span class="loyalty__s">{fr ? 'Plus que 2 cafés pour un gratuit' : '2 more for a free one'}</span>
                  </div>
                  <button class="cta">{fr ? 'Commander · 5,25 $' : 'Order · $5.25'}</button>
                </div>
              )}

              {cc.id === 'tattoo' && (
                <div class="ui ui--tattoo">
                  <header class="ui__top"><span class="ui__brand">Encre</span><span class="ui__hi">{fr ? 'Studio' : 'Studio'}</span></header>
                  <p class="ui__sec">{fr ? 'Portfolio · Léa' : 'Portfolio · Léa'}</p>
                  <div class="gallery">
                    <img src="/concepts/tattoo1.webp" alt="" loading="lazy" decoding="async" width="300" height="300" />
                    <img src="/concepts/tattoo2.webp" alt="" loading="lazy" decoding="async" width="300" height="300" />
                    <img src="/concepts/tattoo3.webp" alt="" loading="lazy" decoding="async" width="300" height="300" />
                    <img src="/concepts/tattoo4.webp" alt="" loading="lazy" decoding="async" width="300" height="300" />
                  </div>
                  <div class="card tat-book"><span class="tat-book__t">{fr ? 'Consultation gratuite' : 'Free consultation'}</span><span class="tat-book__s">{fr ? '30 min · en studio ou en ligne' : '30 min · in studio or online'}</span></div>
                  <button class="cta">{fr ? 'Demander un devis' : 'Request a quote'}</button>
                </div>
              )}
            </div>
          </div>
          <span class="cpt-toast">{cc.id === 'barber' ? (fr ? 'Rendez-vous confirmé' : 'Appointment booked') : cc.id === 'fitness' ? (fr ? 'Place réservée' : 'Spot reserved') : cc.id === 'cafe' ? (fr ? 'Café ajouté' : 'Coffee added') : (fr ? 'Devis envoyé' : 'Quote sent')} ✓</span>
        </div>
        <div class="cpt-meta">
          <span class="cpt-industry">{loc(cc.industry, locale)}</span>
          <h3 class="cpt-brand">{cc.brand}</h3>
          <p class="cpt-tagline">{loc(cc.tagline, locale)}</p>
          <ul class="cpt-tags">{(fr ? cc.tags.fr : cc.tags.en).map((t) => <li>{t}</li>)}</ul>
          <span class="cpt-live"><span class="cpt-live__dot"></span>{c.live}</span>
        </div>
      </article>
    ))}
  </div>
</section>

{/* ---------- Desktop sites ---------- */}
<section class="section-tight container-pl">
  <header class="cpt-secthead reveal">
    <span class="cpt-secnum">02</span>
    <div>
      <h2 class="section-head__title">{c.desktopTitle}</h2>
      <p class="cpt-seclead">{c.desktopLead}</p>
    </div>
  </header>

  <div class="cpt-row cpt-row--desktop">
    {browserConcepts.map((cc, i) => (
      <article class="cpt reveal" data-id={cc.id} style={`--c:${cc.accent}`} data-delay={`${(i % 2) * 90}ms`}>
        <div class="cpt-stage" data-tilt>
          <div class="browser">
            <div class="browser__bar"><span class="dots"><i></i><i></i><i></i></span><span class="url">{cc.brand.toLowerCase()}.{fr ? 'ca' : 'co'}</span></div>
            <div class="browser__screen">

              {cc.id === 'resto' && (
                <div class="site site--resto">
                  <header class="site__nav"><b>Brassé</b><span>Menu · {fr ? 'Réserver' : 'Reserve'} · {fr ? 'Contact' : 'Contact'}</span></header>
                  <div class="resto__hero">
                    <div class="resto__plate"><img src="/concepts/resto.webp" alt="" loading="lazy" decoding="async" width="380" height="380" /></div>
                    <div class="resto__copy">
                      <span class="resto__kick">{fr ? 'Cuisine du marché · Laval' : 'Market kitchen · Laval'}</span>
                      <h4>{fr ? 'Le goût, sans flafla.' : 'Real food, no fuss.'}</h4>
                      <p class="resto__sub">{fr ? 'Menu qui change chaque semaine selon les arrivages.' : 'A menu that changes weekly with the market.'}</p>
                      <button class="cta">{fr ? 'Réserver une table' : 'Book a table'}</button>
                    </div>
                  </div>
                  <div class="resto__menu">
                    <div class="mrow"><span>{fr ? 'Tartare de cerf, vinaigrette à l’érable' : 'Venison tartare, maple vinaigrette'}</span><b>21</b></div>
                    <div class="mrow"><span>{fr ? 'Pâtes fraîches, beurre noisette et sauge' : 'Fresh pasta, brown butter and sage'}</span><b>26</b></div>
                    <div class="mrow"><span>{fr ? 'Tarte au sucre, crème glacée maison' : 'Sugar pie, house ice cream'}</span><b>11</b></div>
                  </div>
                </div>
              )}

              {cc.id === 'immobilier' && (
                <div class="site site--immo">
                  <header class="site__nav"><b>Domaine</b><span class="immo__search">🔍 {fr ? 'Laval, 3+ chambres…' : 'Laval, 3+ beds…'}</span></header>
                  <div class="immo__card">
                    <div class="immo__img"><img src="/concepts/house.webp" alt="" loading="lazy" decoding="async" width="680" height="420" /><span class="immo__tag">{fr ? 'Nouveau' : 'New'}</span></div>
                    <div class="immo__body">
                      <b class="immo__price">749 000 $</b>
                      <span class="immo__addr">{fr ? '12 rue des Érables, Laval' : '12 Maple St, Laval'}</span>
                      <span class="immo__specs">4 {fr ? 'ch' : 'bd'} · 2 {fr ? 'sdb' : 'ba'} · 2 100 pi² · {fr ? 'garage double' : 'double garage'}</span>
                    </div>
                  </div>
                  <div class="immo__thumbs">
                    <img src="/concepts/room1.webp" alt="" loading="lazy" decoding="async" width="240" height="170" />
                    <img src="/concepts/room3.webp" alt="" loading="lazy" decoding="async" width="240" height="170" />
                    <img src="/concepts/house.webp" alt="" loading="lazy" decoding="async" width="680" height="420" />
                  </div>
                </div>
              )}

              {cc.id === 'clinique' && (
                <div class="site site--clinic">
                  <header class="site__nav"><b>Émail</b><span>{fr ? 'Blanchiment · Avant/après · Réserver' : 'Whitening · Before/after · Book'}</span></header>
                  <div class="clinic__hero">
                    <div class="clinic__photo"><img src="/concepts/smile.webp" alt="" loading="lazy" decoding="async" width="380" height="320" /><span class="clinic__shade">{fr ? 'Teinte A1' : 'Shade A1'}</span></div>
                    <div class="card clinic__book">
                      <span class="clinic__kick">{fr ? 'Blanchiment dentaire · Laval' : 'Teeth whitening · Laval'}</span>
                      <span class="clinic__bt">{fr ? 'Réserver un blanchiment' : 'Book a whitening'}</span>
                      <div class="clinic__days"><span>L 9</span><span class="on">M 10</span><span>M 11</span><span>J 12</span></div>
                      <div class="clinic__times"><span class="on">9:30</span><span>11:00</span><span>14:15</span></div>
                      <button class="cta">{fr ? 'Confirmer' : 'Confirm'}</button>
                    </div>
                  </div>
                  <div class="clinic__badges"><span>✓ {fr ? 'Sans douleur' : 'Pain-free'}</span><span>✓ {fr ? 'Résultats en 1 séance' : 'Results in 1 session'}</span><span>✓ {fr ? 'Émail protégé' : 'Enamel-safe'}</span></div>
                </div>
              )}

              {cc.id === 'ecom' && (
                <div class="site site--ecom">
                  <header class="site__nav"><b>Maille</b><span class="ecom__cart">{fr ? 'Panier' : 'Cart'} · 2</span></header>
                  <div class="ecom__hero">
                    <div class="ecom__photo"><img src="/concepts/fashion.webp" alt="" loading="lazy" decoding="async" width="360" height="420" /></div>
                    <div class="ecom__copy">
                      <span class="ecom__kick">{fr ? 'Tricot fait main' : 'Hand-knit'}</span>
                      <h4>{fr ? 'Pull en laine mérinos' : 'Merino wool sweater'}</h4>
                      <div class="ecom__price"><b>148 $</b><span class="ecom__old">185 $</span></div>
                      <div class="ecom__sizes"><span>S</span><span class="on">M</span><span>L</span><span>XL</span></div>
                      <button class="cta">{fr ? 'Ajouter au panier' : 'Add to cart'}</button>
                    </div>
                  </div>
                  <div class="ecom__strip"><span>★★★★★ 4,9</span><span>{fr ? 'Livraison 2 jours' : '2-day shipping'}</span><span>{fr ? 'Retours gratuits' : 'Free returns'}</span></div>
                </div>
              )}

            </div>
          </div>
          <span class="cpt-toast">{cc.id === 'resto' ? (fr ? 'Table réservée' : 'Table booked') : cc.id === 'immobilier' ? (fr ? 'Visite demandée' : 'Tour requested') : cc.id === 'clinique' ? (fr ? 'Rendez-vous confirmé' : 'Appointment booked') : (fr ? 'Ajouté au panier' : 'Added to cart')} ✓</span>
        </div>
        <div class="cpt-meta">
          <span class="cpt-industry">{loc(cc.industry, locale)}</span>
          <h3 class="cpt-brand">{cc.brand}</h3>
          <p class="cpt-tagline">{loc(cc.tagline, locale)}</p>
          <ul class="cpt-tags">{(fr ? cc.tags.fr : cc.tags.en).map((t) => <li>{t}</li>)}</ul>
          <span class="cpt-live"><span class="cpt-live__dot"></span>{c.live}</span>
        </div>
      </article>
    ))}
  </div>
</section>

{/* ---------- SaaS dashboards ---------- */}
<section class="section-tight container-pl">
  <header class="cpt-secthead reveal">
    <span class="cpt-secnum">03</span>
    <div>
      <h2 class="section-head__title">{c.saasTitle}</h2>
      <p class="cpt-seclead">{c.saasLead}</p>
    </div>
  </header>

  <div class="cpt-row cpt-row--desktop">
    {saasConcepts.map((cc, i) => (
      <article class="cpt reveal" data-id={cc.id} style={`--c:${cc.accent}`} data-delay={`${(i % 2) * 90}ms`}>
        <div class="cpt-stage" data-tilt>
          <div class="browser browser--dark">
            <div class="browser__bar"><span class="dots"><i></i><i></i><i></i></span><span class="url">app.{cc.brand.toLowerCase()}.{fr ? 'ca' : 'co'}</span></div>
            <div class="browser__screen">

              {cc.id === 'analytics' && (
                <div class="dash dash--flux">
                  <header class="dash__bar"><b>Flux</b><span class="dash__nav">{fr ? 'Vue · Rapports · Équipe' : 'Overview · Reports · Team'}</span></header>
                  <div class="dash__body">
                    <div class="kpis">
                      <div class="kpi"><span class="kpi__l">{fr ? 'Utilisateurs' : 'Users'}</span><b>12,4k</b><span class="kpi__d up">▲ 8,2%</span></div>
                      <div class="kpi"><span class="kpi__l">{fr ? 'Revenu (MRR)' : 'Revenue (MRR)'}</span><b>48 200 $</b><span class="kpi__d up">▲ 12%</span></div>
                      <div class="kpi"><span class="kpi__l">{fr ? 'Conversion' : 'Conversion'}</span><b>3,2 %</b><span class="kpi__d up">▲ 0,4</span></div>
                    </div>
                    <div class="chart">
                      <svg viewBox="0 0 300 96" preserveAspectRatio="none" aria-hidden="true">
                        <defs><linearGradient id="fluxg" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="var(--c)" stop-opacity="0.35"/><stop offset="100%" stop-color="var(--c)" stop-opacity="0"/></linearGradient></defs>
                        <path d="M0,78 L30,70 L60,74 L90,52 L120,58 L150,38 L180,44 L210,26 L240,30 L270,14 L300,20 L300,96 L0,96 Z" fill="url(#fluxg)"/>
                        <polyline points="0,78 30,70 60,74 90,52 120,58 150,38 180,44 210,26 240,30 270,14 300,20" fill="none" stroke="var(--c)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                      <div class="chart__bars"><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
                    </div>
                  </div>
                </div>
              )}

              {cc.id === 'crm' && (
                <div class="dash dash--pipe">
                  <header class="dash__bar"><b>Pipe</b><span class="dash__pill">{fr ? 'Pipeline · 142 k$' : 'Pipeline · $142k'}</span></header>
                  <div class="board">
                    <div class="col"><span class="col__h">{fr ? 'Prospects' : 'Leads'} · 4</span><div class="col__cards">
                      <div class="deal"><b>Boréal Construction</b><span>18 k$</span></div>
                      <div class="deal"><b>Café Mortier</b><span>6 k$</span></div>
                      <div class="deal"><b>Garage Néo</b><span>11 k$</span></div>
                    </div></div>
                    <div class="col"><span class="col__h">{fr ? 'Qualifiés' : 'Qualified'} · 3</span><div class="col__cards">
                      <div class="deal deal--warm"><b>Clinique Vista</b><span>24 k$</span></div>
                      <div class="deal deal--warm"><b>Studio Lume</b><span>9 k$</span></div>
                      <div class="deal deal--warm"><b>Au Levain</b><span>7 k$</span></div>
                    </div></div>
                    <div class="col"><span class="col__h">{fr ? 'Gagnés' : 'Won'} · 5</span><div class="col__cards">
                      <div class="deal deal--won"><b>HP Addik</b><span>32 k$ ✓</span></div>
                      <div class="deal deal--won"><b>Envita Wellness</b><span>14 k$ ✓</span></div>
                      <div class="deal deal--won"><b>Inspection Outaouais</b><span>8 k$ ✓</span></div>
                    </div></div>
                  </div>
                </div>
              )}

              {cc.id === 'kanban' && (
                <div class="dash dash--trame">
                  <header class="dash__bar"><b>Trame</b><span class="dash__nav">{fr ? 'Sprint 14' : 'Sprint 14'}</span></header>
                  <div class="board">
                    <div class="col"><span class="col__h">{fr ? 'À faire' : 'To do'}</span><div class="col__cards">
                      <div class="task"><span class="task__lbl" style="--t:#7c83ff"></span>{fr ? 'Maquettes accueil' : 'Home mockups'}<i class="task__av">A</i></div>
                      <div class="task"><span class="task__lbl" style="--t:#34d399"></span>{fr ? 'Schéma BD' : 'DB schema'}<i class="task__av">M</i></div>
                      <div class="task"><span class="task__lbl" style="--t:#cf8aa0"></span>{fr ? 'Page tarifs' : 'Pricing page'}<i class="task__av">J</i></div>
                    </div></div>
                    <div class="col"><span class="col__h">{fr ? 'En cours' : 'In progress'}</span><div class="col__cards">
                      <div class="task"><span class="task__lbl" style="--t:#f5a524"></span>{fr ? 'API paiements' : 'Payments API'}<i class="task__av">P</i></div>
                      <div class="task"><span class="task__lbl" style="--t:#ff4d5e"></span>{fr ? 'Tests E2E' : 'E2E tests'}<i class="task__av">S</i></div>
                      <div class="task"><span class="task__lbl" style="--t:#2bc4b4"></span>{fr ? 'Onboarding' : 'Onboarding'}<i class="task__av">D</i></div>
                    </div></div>
                    <div class="col"><span class="col__h">{fr ? 'Fait' : 'Done'}</span><div class="col__cards">
                      <div class="task task--done"><span class="task__lbl" style="--t:#2dd4bf"></span>{fr ? 'Auth SSO' : 'SSO auth'}<i class="task__av">L</i></div>
                      <div class="task task--done"><span class="task__lbl" style="--t:#7c83ff"></span>{fr ? 'Page d’accueil' : 'Landing page'}<i class="task__av">A</i></div>
                      <div class="task task--done"><span class="task__lbl" style="--t:#34d399"></span>{fr ? 'Migration BD' : 'DB migration'}<i class="task__av">M</i></div>
                    </div></div>
                  </div>
                </div>
              )}

              {cc.id === 'invoicing' && (
                <div class="dash dash--releve">
                  <header class="dash__bar"><b>Relevé</b><span class="dash__pill">{fr ? 'Ce mois · 18 400 $' : 'This month · $18,400'}</span></header>
                  <div class="dash__body">
                    <div class="rbars"><span style="height:42%"></span><span style="height:58%"></span><span style="height:48%"></span><span style="height:72%"></span><span style="height:64%"></span><span style="height:88%"></span></div>
                    <div class="inv"><div class="invrow"><b>Envita Wellness</b><span>2 400 $</span><em class="paid">{fr ? 'Payée' : 'Paid'}</em></div><div class="invrow"><b>Brassé</b><span>1 150 $</span><em class="wait">{fr ? 'En attente' : 'Pending'}</em></div><div class="invrow"><b>Domaine Immo</b><span>3 800 $</span><em class="late">{fr ? 'En retard' : 'Overdue'}</em></div></div>
                  </div>
                </div>
              )}

            </div>
          </div>
          <span class="cpt-toast">{cc.id === 'analytics' ? (fr ? 'Rapport exporté' : 'Report exported') : cc.id === 'crm' ? (fr ? 'Opportunité gagnée' : 'Deal won') : cc.id === 'kanban' ? (fr ? 'Tâche terminée' : 'Task done') : (fr ? 'Facture payée' : 'Invoice paid')} ✓</span>
        </div>
        <div class="cpt-meta">
          <span class="cpt-industry">{loc(cc.industry, locale)}</span>
          <h3 class="cpt-brand">{cc.brand}</h3>
          <p class="cpt-tagline">{loc(cc.tagline, locale)}</p>
          <ul class="cpt-tags">{(fr ? cc.tags.fr : cc.tags.en).map((t) => <li>{t}</li>)}</ul>
          <span class="cpt-live"><span class="cpt-live__dot"></span>{c.live}</span>
        </div>
      </article>
    ))}
  </div>
</section>

{/* Closing CTA */}
<section class="section">
  <div class="container-pl cpt-cta reveal">
    <p class="kicker">{c.ctaTitle}</p>
    <h2 class="cpt-cta__title">{c.ctaLead}</h2>
    <a href={path('contact', locale)} class="btn btn-primary magnetic" data-magnetic="0.25">{tr.cta.primary} <span aria-hidden="true">→</span></a>
  </div>
</section>

<style>
  .cpt-note { margin: 1rem 0 0; color: var(--color-fog); font-size: 0.92rem; max-width: 62ch; font-style: italic; }

  .cpt-secthead { display: flex; align-items: flex-start; gap: 1.1rem; margin-bottom: 2.2rem; }
  .cpt-secnum { font-family: var(--font-mono); font-size: 0.85rem; color: var(--color-gold); padding-top: 0.35rem; }
  .cpt-seclead { color: var(--color-fog); font-size: 0.98rem; margin: 0.4rem 0 0; max-width: 60ch; }

  .cpt-row { display: grid; gap: clamp(1.5rem, 3vw, 2.5rem); }
  .cpt-row--phones { grid-template-columns: repeat(4, 1fr); }
  .cpt-row--desktop { grid-template-columns: repeat(2, 1fr); margin-top: 4rem; }
  /* Every desktop + SaaS box matches: shared stage height, the window fills
     it, and the inner content distributes top to bottom. */
  /* Fixed identical window height = every desktop + SaaS box matches,
     inside and out. Content flex-fills within. */
  .cpt-row--desktop .browser { display: flex; flex-direction: column; height: clamp(430px, 31vw, 470px); }
  .cpt-row--desktop .browser__screen { flex: 1; display: flex; flex-direction: column; }
  .cpt-row--desktop .site { flex: 1; display: flex; flex-direction: column; }
  .cpt-row--desktop .dash { flex: 1; display: flex; flex-direction: column; }
  .cpt-row--desktop .dash__body { flex: 1; }
  .cpt-row--desktop .board { flex: 1; }
  .cpt-row--desktop .col__cards { flex: 1; justify-content: space-between; }
  .cpt-row--desktop .chart { flex: 1; display: flex; flex-direction: column; }
  .cpt-row--desktop .chart svg { flex: 1; height: auto; min-height: 70px; }
  .cpt-row--desktop .inv { flex: 1; justify-content: space-between; }
  /* Sites: the main section grows to fill so there's no mid-page gap. */
  .cpt-row--desktop .resto__hero, .cpt-row--desktop .clinic__hero, .cpt-row--desktop .ecom__hero { flex: 1; }
  .cpt-row--desktop .immo__card { flex: 1; display: flex; flex-direction: column; }
  .cpt-row--desktop .immo__img { flex: 1; height: auto; min-height: 150px; }

  .cpt { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .cpt-stage {
    position: relative; width: 100%;
    display: flex; justify-content: center;
    padding: clamp(1.2rem, 3vw, 2.4rem) 1rem;
    border-radius: 22px;
    background: radial-gradient(80% 70% at 50% 26%, color-mix(in srgb, var(--c) 18%, transparent), transparent 70%), rgba(238, 241, 246, 0.02);
    border: 1px solid var(--line);
    transition: transform 0.35s cubic-bezier(.2,.8,.2,1), border-color 0.3s, box-shadow 0.35s;
    transform-style: preserve-3d; perspective: 1200px;
    overflow: hidden;
  }
  .cpt-stage:hover {
    border-color: color-mix(in srgb, var(--c) 50%, transparent);
    box-shadow: 0 30px 70px -40px color-mix(in srgb, var(--c) 60%, transparent);
  }
  .cpt-stage > .phone, .cpt-stage > .browser { transition: transform 0.35s cubic-bezier(.2,.8,.2,1); }
  .cpt-stage:hover > .phone, .cpt-stage:hover > .browser { transform: translateY(-6px); }

  /* Hover toast */
  .cpt-toast {
    position: absolute; left: 50%; bottom: 14px; transform: translate(-50%, 140%);
    background: var(--c); color: #0a0a0a; font-weight: 700; font-size: 0.78rem;
    padding: 0.5rem 0.95rem; border-radius: 999px; white-space: nowrap;
    box-shadow: 0 10px 24px -8px color-mix(in srgb, var(--c) 70%, transparent);
    opacity: 0; transition: transform 0.4s cubic-bezier(.2,.9,.2,1) 0.05s, opacity 0.3s; pointer-events: none;
  }
  .cpt-stage:hover .cpt-toast { transform: translate(-50%, 0); opacity: 1; }

  .cpt-meta { margin-top: 1.4rem; }
  .cpt-industry { font-family: var(--font-mono); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.16em; color: var(--c); }
  .cpt-brand { font-size: 1.5rem; margin: 0.45rem 0 0.5rem; }
  .cpt-tagline { color: var(--color-fog); font-size: 0.92rem; line-height: 1.55; margin: 0 auto; max-width: 38ch; }
  .cpt-tags { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0; margin: 0.9rem auto 0; justify-content: center; }
  .cpt-tags li { font-family: var(--font-mono); font-size: 0.66rem; color: var(--color-fog); border: 1px solid var(--line); border-radius: 999px; padding: 0.22rem 0.6rem; }
  .cpt-live { display: inline-flex; align-items: center; gap: 0.45rem; margin-top: 0.9rem; font-family: var(--font-mono); font-size: 0.7rem; color: var(--color-fog); }
  .cpt-live__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--c); animation: cptpulse 2s infinite; }
  @keyframes cptpulse { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--c) 55%, transparent); } 70% { box-shadow: 0 0 0 7px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }

  /* ---- Phone frame ---- */
  .phone { position: relative; width: 100%; max-width: 226px; aspect-ratio: 226 / 466; border-radius: 36px; background: #05080d; border: 1px solid rgba(255,255,255,0.12); padding: 8px; box-shadow: 0 40px 80px -34px rgba(0,0,0,0.85); }
  .phone__notch { position: absolute; top: 11px; left: 50%; transform: translateX(-50%); width: 80px; height: 20px; border-radius: 0 0 13px 13px; background: #05080d; z-index: 3; }
  .phone__screen { width: 100%; height: 100%; border-radius: 29px; overflow: hidden; background: var(--bg); color: var(--txt); display: flex; flex-direction: column; }

  /* ---- Browser frame ---- */
  .browser { width: 100%; border-radius: 13px; overflow: hidden; background: var(--bg); border: 1px solid rgba(255,255,255,0.10); box-shadow: 0 40px 80px -34px rgba(0,0,0,0.8); }
  .browser__bar { display: flex; align-items: center; gap: 0.8rem; padding: 0.55rem 0.85rem; background: color-mix(in srgb, var(--bg) 80%, #000); border-bottom: 1px solid rgba(0,0,0,0.08); }
  .dots { display: inline-flex; gap: 5px; }
  .dots i { width: 9px; height: 9px; border-radius: 50%; background: rgba(150,150,150,0.45); }
  .dots i:first-child { background: #ff5f57; } .dots i:nth-child(2) { background: #febc2e; } .dots i:last-child { background: #28c840; }
  .url { flex: 1; font-family: var(--font-mono); font-size: 0.7rem; color: var(--txt2); background: rgba(0,0,0,0.06); border-radius: 7px; padding: 0.25rem 0.6rem; text-align: center; }

  .statusbar { display: flex; justify-content: space-between; align-items: center; padding: 0.6rem 1rem 0.15rem; font-size: 0.66rem; font-weight: 600; color: var(--txt); }
  .statusbar__dots { display: inline-flex; gap: 3px; }
  .statusbar__dots i { width: 5px; height: 5px; border-radius: 50%; background: var(--txt); opacity: 0.55; }

  .ui { padding: 0.5rem 0.85rem 0.85rem; display: flex; flex-direction: column; gap: 0.55rem; height: 100%; }
  .ui__top { display: flex; align-items: baseline; justify-content: space-between; }
  .ui__brand { font-weight: 800; letter-spacing: 0.04em; font-size: 0.98rem; color: var(--c); }
  .ui__hi { font-size: 0.72rem; color: var(--txt2); }
  .ui__sec { font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--txt2); margin: 0.1rem 0 0; }
  .card { background: var(--surf); border: 1px solid color-mix(in srgb, var(--txt) 8%, transparent); border-radius: 13px; padding: 0.7rem 0.8rem; display: flex; flex-direction: column; gap: 0.18rem; }
  .cta { margin-top: auto; border: none; border-radius: 11px; padding: 0.68rem; font-weight: 700; font-size: 0.82rem; color: #0a0a0a; background: var(--c); cursor: pointer; transition: filter 0.2s ease, transform 0.2s ease; }
  .cpt-stage:hover .cta { filter: brightness(1.08); }

  /* In-app photos */
  .photo { position: relative; border-radius: 12px; overflow: hidden; }
  .photo img { width: 100%; display: block; object-fit: cover; }
  .photo--barber img { aspect-ratio: 16/9; }
  .photo--barber .photo__cap { position: absolute; left: 8px; bottom: 7px; font-size: 0.6rem; font-weight: 700; color: #fff; text-shadow: 0 1px 4px rgba(0,0,0,0.8); }
  .photo--cafe img { aspect-ratio: 16/10; }

  /* Barber */
  .cpt[data-id='barber'] { --bg: #14100a; --surf: #221a0e; --txt: #f3e9d6; --txt2: #9c8d70; }
  .avatars { display: flex; gap: 0.45rem; }
  .av { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; font-weight: 700; font-size: 0.78rem; background: var(--surf); color: var(--txt2); border: 1px solid color-mix(in srgb, var(--txt) 10%, transparent); }
  .av--on { color: #0a0a0a; background: var(--c); border-color: var(--c); box-shadow: 0 0 0 3px color-mix(in srgb, var(--c) 30%, transparent); }
  .slots { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.35rem; }
  .slot { font-size: 0.66rem; text-align: center; padding: 0.45rem 0; border-radius: 8px; background: var(--surf); color: var(--txt2); border: 1px solid color-mix(in srgb, var(--txt) 8%, transparent); }
  .slot--on { background: var(--c); color: #0a0a0a; font-weight: 700; border-color: var(--c); }

  /* Fitness */
  .cpt[data-id='fitness'] { --bg: #0b1007; --surf: #15200c; --txt: #eafbe0; --txt2: #8aa07a; }
  .ring { width: 120px; height: 120px; border-radius: 50%; margin: 0.2rem auto; background: radial-gradient(closest-side, var(--bg) 70%, transparent 72% 100%), conic-gradient(var(--c) 68%, color-mix(in srgb, var(--c) 16%, transparent) 0); display: grid; place-items: center; transition: transform 0.4s ease; }
  .cpt-stage:hover .ring { transform: rotate(8deg) scale(1.03); }
  .ring__center { text-align: center; line-height: 1; }
  .ring__center b { font-size: 1.5rem; font-weight: 800; } .ring__center span { font-size: 0.66rem; color: var(--txt2); }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.35rem; }
  .stat { background: var(--surf); border-radius: 10px; padding: 0.5rem 0.2rem; text-align: center; }
  .stat b { display: block; font-size: 0.8rem; } .stat span { font-size: 0.58rem; color: var(--txt2); }
  .classcard__t { font-weight: 700; font-size: 0.85rem; } .classcard__s { font-size: 0.7rem; color: var(--txt2); }

  /* Cafe */
  .cpt[data-id='cafe'] { --bg: #18120b; --surf: #271c12; --txt: #f3e6d6; --txt2: #b09372; }
  .loyalty__t { font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--c); }
  .stamps { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.35rem; margin: 0.45rem 0; }
  .stamp { aspect-ratio: 1; border-radius: 50%; display: grid; place-items: center; font-size: 0.66rem; border: 1.5px dashed color-mix(in srgb, var(--txt) 22%, transparent); color: transparent; }
  .stamp--on { background: var(--c); color: #0a0a0a; border-style: solid; border-color: var(--c); }
  .loyalty__s { font-size: 0.7rem; color: var(--txt2); }

  /* Tattoo */
  .cpt[data-id='tattoo'] { --bg: #0c0a0c; --surf: #1a1418; --txt: #f1e7ec; --txt2: #9c8a93; }
  .gallery { display: grid; grid-template-columns: 1fr 1fr; gap: 0.35rem; }
  .gallery img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 9px; transition: transform 0.4s ease, filter 0.4s ease; filter: grayscale(0.15); }
  .cpt-stage:hover .gallery img { transform: scale(1.03); filter: grayscale(0); }
  .tat-book__t { font-weight: 700; font-size: 0.82rem; } .tat-book__s { font-size: 0.68rem; color: var(--txt2); }
  .cpt[data-id='tattoo'] .cta { color: #fff; }

  /* ---- Websites (light) ---- */
  .site { display: flex; flex-direction: column; }
  .site__nav { display: flex; align-items: center; justify-content: space-between; padding: 0.7rem 1.1rem; font-size: 0.76rem; border-bottom: 1px solid rgba(0,0,0,0.06); }
  .site__nav b { font-size: 1rem; color: var(--c); }
  .site__nav span { color: var(--txt2); }
  .site .cta { color: #fff; margin-top: 0.7rem; }
  .site h4 { margin: 0.3rem 0 0.5rem; color: var(--txt); line-height: 1.12; font-size: 1.25rem; }

  /* Resto */
  .cpt[data-id='resto'] { --bg: #fbf4ec; --surf: #ffffff; --txt: #2a211c; --txt2: #8a7a6c; }
  .resto__hero { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 1.1rem; padding: 1.2rem; align-items: center; }
  .resto__plate { position: relative; aspect-ratio: 1; border-radius: 50%; box-shadow: inset 0 0 0 7px #fff, 0 14px 30px -12px rgba(0,0,0,0.35); overflow: hidden; }
  .resto__plate img { position: absolute; inset: 7px; width: calc(100% - 14px); height: calc(100% - 14px); object-fit: cover; border-radius: 50%; }
  .resto__kick { font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.13em; color: var(--c); font-weight: 700; }
  .resto__sub { font-size: 0.78rem; color: var(--txt2); margin: 0 0 0.2rem; line-height: 1.4; }
  .resto__menu { padding: 0 1.2rem 1.2rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .mrow { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.8rem; color: var(--txt); padding-bottom: 0.45rem; border-bottom: 1px dotted rgba(0,0,0,0.12); }
  .mrow b { color: var(--c); }

  /* Immobilier */
  .cpt[data-id='immobilier'] { --bg: #f5f7fb; --surf: #ffffff; --txt: #1a2230; --txt2: #6b7689; }
  .immo__search { background: rgba(0,0,0,0.05); border-radius: 7px; padding: 0.28rem 0.7rem; font-size: 0.7rem; }
  .immo__card { margin: 1.1rem; border-radius: 14px; overflow: hidden; background: var(--surf); box-shadow: 0 14px 34px -18px rgba(0,0,0,0.35); }
  .immo__img { height: 170px; position: relative; overflow: hidden; background: #b8c6dd; }
  .immo__img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .cpt-stage:hover .immo__img img { transform: scale(1.04); }
  .immo__tag { position: absolute; z-index: 2; top: 11px; left: 11px; background: var(--c); color: #fff; font-size: 0.64rem; font-weight: 700; padding: 0.22rem 0.6rem; border-radius: 6px; }
  .immo__body { padding: 0.85rem 1rem; display: flex; flex-direction: column; gap: 0.2rem; }
  .immo__price { font-size: 1.35rem; color: var(--txt); }
  .immo__addr { font-size: 0.82rem; color: var(--txt2); }
  .immo__specs { font-size: 0.74rem; color: var(--c); font-weight: 600; margin-top: 0.12rem; }
  .immo__thumbs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.6rem; padding: 0 1.1rem 1.2rem; }
  .immo__thumbs img { width: 100%; height: 56px; object-fit: cover; border-radius: 9px; }

  /* Clinique */
  .cpt[data-id='clinique'] { --bg: #f0fbfa; --surf: #ffffff; --txt: #14302c; --txt2: #5e8a83; }
  .clinic__hero { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; padding: 1.2rem; align-items: stretch; }
  .clinic__photo { border-radius: 14px; overflow: hidden; position: relative; }
  .clinic__photo img { width: 100%; height: 100%; min-height: 150px; object-fit: cover; }
  .clinic__shade { position: absolute; bottom: 8px; left: 8px; background: var(--c); color: #06302c; font-size: 0.6rem; font-weight: 700; padding: 0.2rem 0.5rem; border-radius: 6px; }
  .clinic__kick { font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.13em; color: var(--c); font-weight: 700; }
  .clinic__book { box-shadow: 0 14px 30px -18px rgba(0,0,0,0.3); gap: 0.35rem; }
  .clinic__bt { font-size: 0.84rem; font-weight: 700; color: var(--txt); margin-top: 0.1rem; }
  .clinic__days, .clinic__times { display: flex; gap: 0.3rem; margin-top: 0.4rem; flex-wrap: wrap; }
  .clinic__days span, .clinic__times span { font-size: 0.64rem; padding: 0.3rem 0.45rem; border-radius: 8px; background: color-mix(in srgb, var(--c) 12%, #fff); color: var(--txt2); }
  .clinic__days .on, .clinic__times .on { background: var(--c); color: #fff; font-weight: 700; }
  .clinic__badges { display: flex; gap: 0.5rem; flex-wrap: wrap; padding: 0 1.2rem 1.2rem; }
  .clinic__badges span { font-size: 0.68rem; color: var(--txt2); }

  /* E-commerce */
  .cpt[data-id='ecom'] { --bg: #fbf6f8; --surf: #ffffff; --txt: #2a1f25; --txt2: #8a7780; }
  .ecom__cart { background: var(--c); color: #fff; border-radius: 7px; padding: 0.25rem 0.7rem; font-size: 0.7rem; font-weight: 700; }
  .ecom__hero { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 1.1rem; padding: 1.2rem; align-items: center; }
  .ecom__photo { border-radius: 14px; overflow: hidden; box-shadow: 0 14px 30px -16px rgba(0,0,0,0.3); }
  .ecom__photo img { width: 100%; height: 100%; min-height: 170px; object-fit: cover; transition: transform 0.5s ease; }
  .cpt-stage:hover .ecom__photo img { transform: scale(1.04); }
  .ecom__kick { font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.13em; color: var(--c); font-weight: 700; }
  .ecom__price { display: flex; align-items: baseline; gap: 0.5rem; margin: 0.2rem 0 0.5rem; }
  .ecom__price b { font-size: 1.25rem; color: var(--txt); }
  .ecom__old { font-size: 0.85rem; color: var(--txt2); text-decoration: line-through; }
  .ecom__sizes { display: flex; gap: 0.35rem; margin-bottom: 0.2rem; }
  .ecom__sizes span { font-size: 0.7rem; width: 26px; height: 26px; display: grid; place-items: center; border-radius: 7px; border: 1px solid rgba(0,0,0,0.12); color: var(--txt2); }
  .ecom__sizes .on { background: var(--c); color: #fff; border-color: var(--c); font-weight: 700; }
  .ecom__strip { display: flex; justify-content: space-between; gap: 0.5rem; padding: 0.7rem 1.2rem 1.1rem; font-size: 0.68rem; color: var(--txt2); }
  .ecom__strip span:first-child { color: var(--c); font-weight: 700; }

  /* ---- SaaS dashboards (dark) ---- */
  .cpt[data-id='analytics'] { --bg: #0e1018; --surf: #181b27; --txt: #e8ebf5; --txt2: #8a90a8; }
  .cpt[data-id='crm'] { --bg: #0b1411; --surf: #13201a; --txt: #e6f5ee; --txt2: #7fa090; }
  .cpt[data-id='kanban'] { --bg: #141019; --surf: #1e1a28; --txt: #ece8f5; --txt2: #968ca8; }
  .cpt[data-id='invoicing'] { --bg: #0a1416; --surf: #122024; --txt: #e2f2f0; --txt2: #6f9a95; }
  .browser--dark .url { background: rgba(255,255,255,0.06); }

  .dash { color: var(--txt); }
  .dash__bar { display: flex; align-items: center; justify-content: space-between; padding: 0.7rem 1.1rem; border-bottom: 1px solid rgba(255,255,255,0.06); }
  .dash__bar b { color: var(--c); font-size: 1rem; }
  .dash__nav { font-size: 0.72rem; color: var(--txt2); }
  .dash__pill { font-size: 0.72rem; font-weight: 700; color: var(--c); background: color-mix(in srgb, var(--c) 16%, transparent); padding: 0.25rem 0.65rem; border-radius: 999px; }
  .dash__body { padding: 1.1rem; display: flex; flex-direction: column; gap: 0.9rem; }

  .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.6rem; }
  .kpi { background: var(--surf); border: 1px solid rgba(255,255,255,0.05); border-radius: 11px; padding: 0.65rem 0.7rem; display: flex; flex-direction: column; gap: 0.15rem; }
  .kpi__l { font-size: 0.62rem; color: var(--txt2); text-transform: uppercase; letter-spacing: 0.06em; }
  .kpi b { font-size: 1.05rem; }
  .kpi__d { font-size: 0.64rem; }
  .kpi__d.up { color: #34d399; }

  .chart { background: var(--surf); border: 1px solid rgba(255,255,255,0.05); border-radius: 11px; padding: 0.7rem; }
  .chart svg { width: 100%; height: 80px; display: block; }
  .chart__bars { display: grid; grid-template-columns: repeat(7, 1fr); gap: 0.35rem; margin-top: 0.6rem; align-items: end; height: 22px; }
  .chart__bars span { background: color-mix(in srgb, var(--c) 45%, transparent); border-radius: 3px; }
  .chart__bars span:nth-child(1){height:50%} .chart__bars span:nth-child(2){height:80%} .chart__bars span:nth-child(3){height:40%} .chart__bars span:nth-child(4){height:95%} .chart__bars span:nth-child(5){height:65%} .chart__bars span:nth-child(6){height:75%} .chart__bars span:nth-child(7){height:55%}

  .board { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.55rem; padding: 1rem; }
  .col { background: var(--surf); border-radius: 11px; padding: 0.55rem 0.5rem; display: flex; flex-direction: column; gap: 0.45rem; }
  .col__cards { display: flex; flex-direction: column; gap: 0.45rem; }
  .col__h { font-size: 0.6rem; color: var(--txt2); text-transform: uppercase; letter-spacing: 0.06em; }
  .deal { background: color-mix(in srgb, var(--txt) 6%, transparent); border-radius: 8px; padding: 0.45rem 0.5rem; display: flex; flex-direction: column; gap: 0.1rem; border-left: 2px solid var(--c); }
  .deal b { font-size: 0.7rem; } .deal span { font-size: 0.66rem; color: var(--txt2); }
  .deal--warm { border-left-color: #f5a524; } .deal--won { border-left-color: #34d399; }
  .deal--won span { color: #34d399; }

  .task { background: color-mix(in srgb, var(--txt) 6%, transparent); border-radius: 8px; padding: 0.45rem 0.5rem; font-size: 0.68rem; display: flex; align-items: center; gap: 0.4rem; }
  .task__lbl { width: 18px; height: 4px; border-radius: 2px; background: var(--t); flex-shrink: 0; }
  .task__av { margin-left: auto; width: 18px; height: 18px; border-radius: 50%; background: var(--c); color: #0a0a0a; font-size: 0.56rem; font-weight: 700; display: grid; place-items: center; font-style: normal; }
  .task--done { opacity: 0.65; text-decoration: line-through; }

  .rbars { display: grid; grid-template-columns: repeat(6, 1fr); gap: 0.4rem; align-items: end; height: 70px; }
  .rbars span { background: linear-gradient(var(--c), color-mix(in srgb, var(--c) 30%, transparent)); border-radius: 4px 4px 0 0; }
  .inv { display: flex; flex-direction: column; gap: 0.35rem; }
  .invrow { display: grid; grid-template-columns: 1fr auto auto; gap: 0.6rem; align-items: center; background: var(--surf); border-radius: 8px; padding: 0.45rem 0.6rem; font-size: 0.7rem; }
  .invrow b { font-weight: 600; } .invrow > span { color: var(--txt2); }
