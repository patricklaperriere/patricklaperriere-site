---
// Blog index as an editorial contents page: numbered rows on hairlines rather
// than a grid of cards, so the titles carry the page.
import { useTranslations, path } from '../../i18n';
import type { Locale } from '../../i18n/routes';
import { blogPostPath, type Post } from '../../lib/blog';
import Breadcrumb from '../Breadcrumb.astro';
import CtaBand from '../CtaBand.astro';

interface Props {
  locale: Locale;
  posts: Post[];
}
const { locale, posts } = Astro.props;
const tr = useTranslations(locale);
const b = tr.blog;

const crumbs = [
  { name: tr.breadcrumb.home, url: path('home', locale) },
  { name: tr.nav.blog, url: path('blog', locale) },
];
---

<Breadcrumb items={crumbs} />

<section class="page-head container-wide">
  <p class="label label-rule">{b.kicker}</p>
  <h1>{b.h1}</h1>
  <p class="lead">{b.lead}</p>
</section>

<section class="section-tight container-wide">
  {posts.length === 0 ? (
    <p class="blog-soon">{b.soon}</p>
  ) : (
    <ol class="posts">
      {posts.map((post, i) => (
        <li class="posts__item reveal" data-delay={`${i * 60}ms`}>
          <a href={blogPostPath(locale, post.data.slug)} class="posts__link">
            <span class="index-num posts__num">{String(i + 1).padStart(2, '0')}</span>

            <span class="posts__main">
              {/* Dates deliberately not shown — see PostArticle.astro. */}
              {post.data.tags[0] && <span class="posts__tag">{post.data.tags[0]}</span>}
              <h2 class="posts__title">{post.data.title}</h2>
              <span class="posts__desc">{post.data.description}</span>
            </span>

            <span class="posts__arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
  )}
</section>

<CtaBand locale={locale} />

<style>
  .blog-soon {
    color: var(--fg-dim);
    padding-block: 3rem;
    border-top: 1px solid var(--line);
  }

  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .posts__item { border-bottom: 1px solid var(--line-soft); }

  .posts__link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: start;
    gap: 0 clamp(1rem, 3vw, 2.5rem);
    padding-block: clamp(1.25rem, 3vw, 2rem);
  }
  .posts__num { padding-top: 0.4rem; }

  .posts__main {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .posts__tag {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-mute);
  }
  .posts__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.6vw, 1.9rem);
    font-weight: var(--fw-light);
    letter-spacing: -0.028em;
    line-height: 1.2;
    color: var(--fg);
    max-width: 30ch;
    transition: color var(--t-fast) var(--ease);
  }
  .posts__link:hover .posts__title { color: var(--accent-fg); }
  .posts__desc {
    color: var(--fg-dim);
    font-size: var(--fs-sm);
    line-height: 1.6;
    max-width: 62ch;
  }

  .posts__arrow {
    align-self: center;
    color: var(--accent-fg);
    font-size: 1.1rem;
    transition: transform var(--t-base) var(--ease-out);
  }
  .posts__link:hover .posts__arrow { transform: translateX(5px); }

  @media (max-width: 560px) {
    .posts__link { grid-template-columns: auto minmax(0, 1fr); }
    .posts__arrow { display: none; }
  }
</style>
