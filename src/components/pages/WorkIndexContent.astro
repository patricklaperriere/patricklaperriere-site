---
import { useTranslations, path } from '../../i18n';
import type { Locale } from '../../i18n/routes';
import { sortedProjects } from '../../data/projets';
import Breadcrumb from '../Breadcrumb.astro';
import ProjectCard from '../ProjectCard.astro';
import CtaBand from '../CtaBand.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = useTranslations(locale);
const projects = sortedProjects();

const crumbs = [
  { name: tr.breadcrumb.home, url: path('home', locale) },
  { name: tr.nav.work, url: path('work', locale) },
];
---

<Breadcrumb items={crumbs} />

<section class="page-head container-pl">
  <p class="kicker reveal">{tr.workSection.kicker}</p>
  <h1 class="reveal" data-delay="80ms"><span class="text-gold-grad">{tr.workSection.title}</span></h1>
  <p class="lead reveal" data-delay="160ms">{tr.workSection.lead}</p>
</section>

<section class="section-tight container-pl">
  <div class="grid-3">
    {projects.map((p, i) => (
      <ProjectCard project={p} locale={locale} cta={tr.cta.viewProject} index={i} />
    ))}
  </div>
</section>

<CtaBand locale={locale} />
