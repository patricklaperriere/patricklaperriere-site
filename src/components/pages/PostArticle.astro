---
import { useTranslations, path } from '../../i18n';
import type { Locale } from '../../i18n/routes';
import type { Post } from '../../lib/blog';
import Breadcrumb from '../Breadcrumb.astro';
import CtaBand from '../CtaBand.astro';

interface Props {
  locale: Locale;
  post: Post;
}
const { locale, post } = Astro.props;
const tr = useTranslations(locale);

const dateFmt = new Intl.DateTimeFormat(locale === 'fr' ? 'fr-CA' : 'en-CA', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const crumbs = [
  { name: tr.breadcrumb.home, url: path('home', locale) },
  { name: tr.nav.blog, url: path('blog', locale) },
  { name: post.data.title, url: path('blog', locale) },
];
---

<Breadcrumb items={crumbs} />

<article class="post">
  <header class="page-head container-pl post__head">
    <div class="post__meta reveal">
      <time datetime={post.data.pubDate.toISOString()}>{dateFmt.format(post.data.pubDate)}</time>
      {post.data.tags.map((t) => <span class="post__tag">{t}</span>)}
    </div>
    <h1 class="reveal" data-delay="80ms">{post.data.title}</h1>
    <p class="lead reveal" data-delay="160ms">{post.data.description}</p>
  </header>

  <div class="container-pl post__body prose reveal">
    <slot />
    <p class="post__back"><a href={path('blog', locale)}>← {tr.nav.blog}</a></p>
  </div>
</article>

<CtaBand locale={locale} />

<style>
  .post__head { padding-bottom: 1rem; }
  .post__meta {
    display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;
    font-family: var(--font-mono); font-size: 0.78rem; color: var(--color-fog);
  }
  .post__tag { padding: 0.2rem 0.6rem; border: 1px solid var(--line); border-radius: 999px; color: var(--color-gold); }
  .post__head h1 { max-width: 22ch; }

  .post__body { max-width: 720px; padding-block: clamp(1.5rem, 4vw, 2.5rem); }
  .post__body :global(h2) {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    margin: 2.4rem 0 0.9rem;
    letter-spacing: -0.02em;
  }
  .post__body :global(h3) { font-size: 1.25rem; margin: 1.8rem 0 0.6rem; }
  .post__body :global(ul),
  .post__body :global(ol) { color: var(--color-fog); line-height: 1.7; padding-left: 1.3rem; margin: 0 0 1.1rem; }
  .post__body :global(li) { margin-bottom: 0.5rem; }
  .post__body :global(li)::marker { color: var(--color-gold); }
  .post__body :global(strong) { color: var(--color-bone); font-weight: 600; }
  .post__body :global(a) {
    color: var(--color-gold-bright);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--color-gold) 50%, transparent);
  }
  .post__body :global(a):hover { text-decoration-color: var(--color-gold-bright); }
  .post__body :global(blockquote) {
    border-left: 2px solid var(--color-gold);
    padding-left: 1.2rem; margin: 1.5rem 0; color: var(--color-bone); font-style: italic;
  }
  .post__back { margin-top: 2.5rem; font-family: var(--font-mono); font-size: 0.85rem; }
  .post__back a { color: var(--color-fog); }
  .post__back a:hover { color: var(--color-gold-bright); }
</style>
