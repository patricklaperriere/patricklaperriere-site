---
// Service detail page.
//
// Same content as before — problem, solution, what's included, process, FAQ,
// cross-links — re-laid out on the editorial system. The process step becomes a
// paper chapter so a long keyword page still has rhythm instead of scrolling as
// one uninterrupted dark column.
import { useTranslations, path } from '../../i18n';
import type { Locale, RouteKey } from '../../i18n/routes';
import Breadcrumb from '../Breadcrumb.astro';
import FaqList from '../FaqList.astro';
import CtaBand from '../CtaBand.astro';
import { startingPrice, type PricedService } from '../../data/prix';

type ServiceKey = 'web' | 'seo' | 'shopify';

interface Props {
  locale: Locale;
  service: ServiceKey;
}
const { locale, service } = Astro.props;
const tr = useTranslations(locale);
const s = tr.services[service];

const price = startingPrice[s.key as PricedService] ?? null;

// The other two services, for cross-linking at the bottom of the page.
const allKeys: ServiceKey[] = ['web', 'seo', 'shopify'];
const related = allKeys.filter((k) => k !== service).map((k) => tr.services[k]);

const crumbs = [
  { name: tr.breadcrumb.home, url: path('home', locale) },
  { name: tr.nav.services, url: path('services', locale) },
  { name: s.title, url: path(s.key as RouteKey, locale) },
];
---

<Breadcrumb items={crumbs} />

<section class="page-head container-wide">
  <p class="label label-rule">{s.title}</p>
  <h1>{s.h1}</h1>
  <p class="lead">{s.lead}</p>

  {price && (
    <div class="sd__price">
      <p class="sd__price-line">
        <span class="sd__price-from">{tr.pricing.from}</span>
        <b>{`${price} ${tr.pricing.currency}`}</b>
      </p>
      <p class="sd__price-note">{tr.pricing.note}</p>
    </div>
  )}

  <a href={path('contact', locale)} class="btn btn-accent sd__cta">
    {tr.cta.primary}
    <span class="btn__arrow" aria-hidden="true">→</span>
  </a>
</section>

<!-- Problem / solution ----------------------------------------------------- -->
<section class="section-tight container-wide">
  <div class="sd__ps">
    <div class="sd__ps-col reveal">
      <h2 class="label sd__ps-label">{s.problemTitle}</h2>
      <p class="sd__ps-text">{s.problem}</p>
    </div>
    <div class="sd__ps-col sd__ps-col--solution reveal" data-delay="90ms">
      <h2 class="label label--accent sd__ps-label">{s.solutionTitle}</h2>
      <p class="sd__ps-text sd__ps-text--strong">{s.solution}</p>
    </div>
  </div>
</section>

<!-- What's included --------------------------------------------------------- -->
<section class="section-tight container-wide">
  <h2 class="label label-rule sd__sec-label">{s.includedTitle}</h2>
  <ul class="sd__inc">
    {s.included.map((item, i) => (
      <li class="reveal" data-delay={`${i * 45}ms`}>{item}</li>
    ))}
  </ul>
</section>

<!-- Process (paper chapter) ------------------------------------------------- -->
<section class="section-tight sd__process-wrap" data-surface="paper">
  <div class="container-wide">
    <h2 class="label label-rule sd__sec-label">{s.processTitle}</h2>
    <ol class="sd__process">
      {s.process.map((step, i) => (
        <li class="sd__step reveal" data-delay={`${i * 70}ms`}>
          <span class="index-num">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="sd__step-title">{step.t}</h3>
          <p class="sd__step-text">{step.d}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<FaqList title={s.faqTitle} faq={s.faq} />

<!-- Related services — internal linking ------------------------------------- -->
<section class="section-tight container-wide">
  <h2 class="label label-rule sd__sec-label">{tr.servicesSection.kicker}</h2>
  <ul class="sd__related">
    {related.map((r, i) => (
      <li class="reveal" data-delay={`${i * 80}ms`}>
        <a href={path(r.key, locale)} class="sd__related-link">
          <h3 class="sd__related-title">{r.title}</h3>
          <span class="sd__related-blurb">{r.blurb}</span>
          <span class="cta-mono">
            {tr.cta.seeServices}
            <span class="sd__arrow" aria-hidden="true">→</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>

<CtaBand locale={locale} />

<style>
  .sd__price {
    margin-top: clamp(1.5rem, 3vw, 2rem);
    padding-left: 1.25rem;
    border-left: 2px solid var(--accent);
  }
  .sd__price-line {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
  }
  .sd__price-from {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-mute);
  }
  .sd__price-line b {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: var(--fw-light);
    letter-spacing: -0.03em;
  }
  .sd__price-note {
    color: var(--fg-dim);
    font-size: var(--fs-meta);
    margin: 0.4rem 0 0;
  }
  .sd__cta { margin-top: clamp(1.5rem, 3vw, 2rem); }

  .sd__sec-label { margin-bottom: clamp(1.5rem, 3vw, 2.25rem); }

  /* ---- Problem / solution -------------------------------------------------
     Two columns split by a rule. The solution carries the accent and the
     brighter text, so the contrast is typographic rather than two boxes. */
  .sd__ps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid var(--line);
  }
  .sd__ps-col {
    padding: clamp(1.5rem, 3vw, 2.25rem) clamp(1.25rem, 3vw, 2.5rem)
             clamp(1.5rem, 3vw, 2.25rem) 0;
    border-right: 1px solid var(--line-soft);
  }
  .sd__ps-col--solution {
    border-right: 0;
    padding-left: clamp(1.25rem, 3vw, 2.5rem);
    padding-right: 0;
  }
  .sd__ps-label { margin-bottom: 1rem; }
  .sd__ps-text {
    color: var(--fg-dim);
    line-height: 1.7;
    margin: 0;
    max-width: 52ch;
  }
  .sd__ps-text--strong { color: var(--fg); }

  /* ---- Included ------------------------------------------------------------ */
  .sd__inc {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid var(--line);
  }
  .sd__inc li {
    position: relative;
    padding: 0.85rem 1.5rem 0.85rem 1.6rem;
    border-bottom: 1px solid var(--line-soft);
    color: var(--fg-dim);
    font-size: var(--fs-sm);
    line-height: 1.55;
  }
  .sd__inc li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 1.35em;
    width: 8px;
    height: 1px;
    background: var(--accent);
  }
  .sd__inc li:nth-child(odd) { border-right: 1px solid var(--line-soft); }

  /* ---- Process -------------------------------------------------------------- */
  .sd__process {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid var(--line);
  }
  .sd__step {
    padding: clamp(1.25rem, 2.5vw, 1.75rem) clamp(1rem, 2vw, 1.75rem)
             clamp(1.25rem, 2.5vw, 1.75rem) 0;
    border-right: 1px solid var(--line-soft);
  }
  .sd__step + .sd__step { padding-left: clamp(1rem, 2vw, 1.75rem); }
  .sd__step:last-child { border-right: 0; }
  .sd__step-title {
    font-size: 1.05rem;
    font-weight: var(--fw-medium);
    letter-spacing: -0.015em;
    margin: 0.9rem 0 0.45rem;
  }
  .sd__step-text {
    color: var(--fg-dim);
    font-size: var(--fs-meta);
    line-height: 1.6;
    margin: 0;
  }

  /* ---- Related -------------------------------------------------------------- */
  .sd__related {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid var(--line);
  }
  .sd__related li { border-bottom: 1px solid var(--line-soft); }
  .sd__related li:nth-child(odd) { border-right: 1px solid var(--line-soft); }
  .sd__related-link {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    height: 100%;
    padding: clamp(1.25rem, 2.5vw, 1.75rem) clamp(1.25rem, 2.5vw, 1.75rem)
             clamp(1.25rem, 2.5vw, 1.75rem) 0;
  }
  .sd__related li:nth-child(even) .sd__related-link {
    padding-left: clamp(1.25rem, 2.5vw, 1.75rem);
    padding-right: 0;
  }
  .sd__related-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    font-weight: var(--fw-light);
    letter-spacing: -0.025em;
    transition: color var(--t-fast) var(--ease);
  }
  .sd__related-link:hover .sd__related-title { color: var(--accent-fg); }
  .sd__related-blurb {
    color: var(--fg-dim);
    font-size: var(--fs-sm);
    line-height: 1.6;
    flex: 1;
  }
  .sd__arrow { transition: transform var(--t-base) var(--ease-out); }
  .sd__related-link:hover .sd__arrow { transform: translateX(4px); }

  /* ---- Responsive ----------------------------------------------------------- */
  @media (max-width: 1000px) {
    .sd__process { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .sd__step,
    .sd__step + .sd__step {
      border-right: 0;
      border-bottom: 1px solid var(--line-soft);
      padding-inline: 0 1rem;
    }
    .sd__step:nth-child(odd) { border-right: 1px solid var(--line-soft); }
    .sd__step:nth-child(even) { padding-inline: 1rem 0; }
    .sd__step:nth-last-child(-n + 2) { border-bottom: 0; }
  }
  @media (max-width: 760px) {
    .sd__ps { grid-template-columns: 1fr; }
    .sd__ps-col,
    .sd__ps-col--solution {
      border-right: 0;
      border-bottom: 1px solid var(--line-soft);
      padding-inline: 0;
    }
    .sd__ps-col--solution { border-bottom: 0; }
    .sd__inc { grid-template-columns: 1fr; }
    .sd__inc li:nth-child(odd) { border-right: 0; }
    .sd__related { grid-template-columns: 1fr; }
    .sd__related li:nth-child(odd) { border-right: 0; }
    .sd__related-link,
    .sd__related li:nth-child(even) .sd__related-link { padding-inline: 0; }
  }
  @media (max-width: 520px) {
    .sd__process { grid-template-columns: 1fr; }
    .sd__step,
    .sd__step + .sd__step,
    .sd__step:nth-child(odd),
    .sd__step:nth-child(even) {
      border-right: 0;
      padding-inline: 0;
    }
  }
</style>
