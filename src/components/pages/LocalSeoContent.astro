---
import { useTranslations, path } from '../../i18n';
import type { Locale } from '../../i18n/routes';
import { villeContent, villesHubPath, type Ville } from '../../data/villes';
import { workBase } from '../../i18n/routes';
import Breadcrumb from '../Breadcrumb.astro';
import FaqList from '../FaqList.astro';
import ServiceCard from '../ServiceCard.astro';
import CtaBand from '../CtaBand.astro';

interface Props {
  locale: Locale;
  ville: Ville;
}
const { locale, ville } = Astro.props;
const tr = useTranslations(locale);
const c = villeContent(ville, locale);

const services = [tr.services.web, tr.services.seo, tr.services.shopify];

const crumbs = [
  { name: tr.breadcrumb.home, url: path('home', locale) },
  { name: tr.regions.crumb, url: villesHubPath(locale) },
  { name: ville.name, url: '' },
];
---

<Breadcrumb items={crumbs} />

<section class="page-head container-pl">
  <p class="kicker reveal">{ville.region[locale]}</p>
  <h1 class="reveal" data-delay="80ms"><span class="text-gold-grad">{c.h1}</span></h1>
  <p class="lead reveal" data-delay="160ms">{c.lead}</p>
  <div class="reveal" data-delay="240ms" style="margin-top:2rem">
    <a href={path('contact', locale)} class="btn btn-primary magnetic" data-magnetic="0.2">
      {tr.cta.primary} <span aria-hidden="true">→</span>
    </a>
  </div>
</section>

{/* Intro + local market */}
<section class="section-tight container-pl">
  <p class="local-intro reveal">{c.intro}</p>
  <div class="card ps-card reveal" data-delay="80ms" style="margin-top:1.6rem">
    <h2>{c.localTitle}</h2>
    {c.local.map((p) => <p>{p}</p>)}
  </div>
</section>

{/* Why work with me here */}
<section class="section-tight container-pl">
  <h2 class="section-head__title reveal" style="margin-bottom:1.8rem">{c.whyTitle}</h2>
  <ul class="included">
    {c.why.map((item, i) => (
      <li class="reveal" data-delay={`${i * 50}ms`}>
        <span class="included__check" aria-hidden="true">✦</span>{item}
      </li>
    ))}
  </ul>
</section>

{/* Served areas */}
<section class="section-tight container-pl">
  <p class="served-label reveal">{c.servedLabel}</p>
  <ul class="chips reveal" data-delay="60ms">
    {ville.nearby.map((n) => <li class="chip">{n}</li>)}
  </ul>
  <p class="nearby-note reveal" data-delay="120ms">{tr.regions.nearbyNote}</p>
</section>

{/* Optional local proof */}
{c.caseStudy && (
  <section class="section-tight container-pl">
    <a href={`${workBase[locale]}/${c.caseStudy.slug}`} class="card proof reveal">
      <span class="proof__kicker">{tr.workSection.kicker}</span>
      <p class="proof__blurb">{c.caseStudy.blurb}</p>
      <span class="proof__cta">{c.caseStudy.label} <span aria-hidden="true">→</span></span>
    </a>
  </section>
)}

{/* Services cross-link */}
<section class="section-tight container-pl">
  <h2 class="section-head__title reveal" style="margin-bottom:1.8rem">{tr.regions.servicesHeading}</h2>
  <div class="grid-3">
    {services.map((r, i) => (
      <ServiceCard
        icon={r.icon}
        title={r.title}
        blurb={r.blurb}
        href={path(r.key, locale)}
        cta={tr.cta.seeServices}
        index={i}
      />
    ))}
  </div>
</section>

<FaqList title={c.faqTitle} faq={c.faq} />

<CtaBand locale={locale} />

<style>
  .local-intro {
    font-size: 1.2rem;
    line-height: 1.65;
    color: var(--color-bone);
    max-width: 720px;
    margin: 0;
  }
  .ps-card { padding: 2rem; }
  .ps-card h2 { font-size: 1.5rem; margin: 0 0 1rem; }
  .ps-card p { color: var(--color-fog); line-height: 1.65; margin: 0 0 1rem; }
  .ps-card p:last-child { margin-bottom: 0; }

  .included {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem 2rem;
    max-width: 900px;
  }
  .included li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    color: var(--color-bone);
    line-height: 1.5;
  }
  .included__check { color: var(--color-gold); flex-shrink: 0; }

  .served-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-fog);
    margin: 0 0 1rem;
  }
  .chips {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .chip {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
    font-size: 0.88rem;
    color: var(--color-bone);
    background: rgba(238, 241, 246, 0.02);
  }
  .nearby-note {
    margin: 1.2rem 0 0;
    color: var(--color-fog);
    font-size: 0.95rem;
    max-width: 60ch;
  }

  .proof {
    display: block;
    padding: 1.8rem 2rem;
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .proof:hover { border-color: color-mix(in srgb, var(--color-gold) 45%, transparent); transform: translateY(-2px); }
  .proof__kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-gold);
  }
  .proof__blurb { color: var(--color-bone); font-size: 1.05rem; margin: 0.7rem 0 0.9rem; line-height: 1.55; }
  .proof__cta { color: var(--color-gold-bright); font-size: 0.95rem; }

  .grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  @media (max-width: 900px) {
    .included { grid-template-columns: 1fr; }
    .grid-3 { grid-template-columns: 1fr; }
  }
</style>
