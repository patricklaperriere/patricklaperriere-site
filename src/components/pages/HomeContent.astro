---
// Home page composition.
//
// The rhythm is deliberate: four ink sections open the page (hero → proof →
// product → work), a paper chapter carries the commercial middle (services),
// ink returns for the technical benchmark, a second paper chapter holds the
// human proof (reviews → the person), and the page closes back on ink.
// Sections declare their world with `data-surface`; nothing else changes.
import { useTranslations, path } from '../../i18n';
import type { Locale } from '../../i18n/routes';
import { featuredProjects } from '../../data/projets';
import { startingPrice, type PricedService } from '../../data/prix';
import { ownSite } from '../../data/lighthouse';

import Hero from '../Hero.astro';
import ProofStrip from '../ProofStrip.astro';
import Marquee from '../Marquee.astro';
import HabitaSpotlight from '../HabitaSpotlight.astro';
import ProjectFeature from '../ProjectFeature.astro';
import ServiceCard from '../ServiceCard.astro';
import LighthouseScores from '../LighthouseScores.astro';
import Testimonials from '../Testimonials.astro';
import PersonalIntro from '../PersonalIntro.astro';
import FaqList from '../FaqList.astro';
import CtaBand from '../CtaBand.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = useTranslations(locale);

const services = [tr.services.web, tr.services.seo, tr.services.shopify];

// Habita owns the cinematic section directly above, so it does not also
// appear as a tile here — it would be the same link twice on one screen and
// would weaken both. The full index at /realisations still lists it first.
const clientWork = featuredProjects().filter((p) => p.slug !== 'habita');
const [leadProject, ...restProjects] = clientWork;
---

<Hero locale={locale} />

<ProofStrip locale={locale} />

<Marquee locale={locale} />

{/* Habita — the SaaS I build and operate. Positioning, not portfolio. */}
<HabitaSpotlight locale={locale} />

{/* ---- Selected work ---------------------------------------------------- */}
<section class="section work" id="work">
  <div class="container-wide">
    <header class="section-head section-head--row work__head">
      <div>
        <p class="label label-rule">{tr.workSection.kicker}</p>
        <h2 class="section-head__title">{tr.workSection.featuredTitle}</h2>
      </div>
      <a href={path('work', locale)} class="link work__all">
        {tr.cta.allWork}
        <span aria-hidden="true">→</span>
      </a>
    </header>

    {leadProject && (
      <div class="work__lead reveal">
        <ProjectFeature project={leadProject} locale={locale} index={1} variant="lead" />
      </div>
    )}

    {restProjects.length > 0 && (
      <div class="work__pair">
        {restProjects.map((p, i) => (
          <div class="reveal" data-delay={`${i * 90}ms`}>
            <ProjectFeature project={p} locale={locale} index={i + 2} variant="half" />
          </div>
        ))}
      </div>
    )}
  </div>
</section>

{/* ---- Services (paper chapter) ----------------------------------------- */}
<section class="section services" id="services" data-surface="paper">
  <div class="container-wide">
    <header class="section-head services__head">
      <p class="label label-rule">{tr.servicesSection.kicker}</p>
      <h2 class="section-head__title">{tr.servicesSection.title}</h2>
      <p class="section-head__lead">{tr.servicesSection.lead}</p>
    </header>

    <div class="services__grid">
      {services.map((s, i) => (
        <ServiceCard
          title={s.title}
          blurb={s.blurb}
          href={path(s.key, locale)}
          cta={tr.cta.seeServices}
          index={i}
          price={startingPrice[s.key as PricedService] ?? null}
          priceFrom={tr.pricing.from}
          currency={tr.pricing.currency}
        />
      ))}
    </div>

    {/* Reassurance points, folded in here rather than living as their own
        section: they answer "why him" for the services just described. */}
    <div class="services__why">
      <h3 class="label services__why-label">{tr.reassurance.title}</h3>
      <ul class="services__why-list">
        {tr.reassurance.items.map((item, i) => (
          <li class="services__why-item reveal" data-delay={`${i * 60}ms`}>
            <h4 class="services__why-title">{item.t}</h4>
            <p class="services__why-text">{item.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

{/* ---- Measured performance --------------------------------------------- */}
<section class="section-tight bench-section" id="performance">
  <div class="container-wide">
    <header class="section-head section-head--row bench-section__head">
      <div>
        <p class="label label-rule">{tr.lighthouse.kicker}</p>
        <h2 class="section-head__title">{tr.lighthouse.title}</h2>
      </div>
      <p class="section-head__lead bench-section__lead">{tr.lighthouse.lead}</p>
    </header>

    <LighthouseScores locale={locale} score={ownSite} variant="full" />
  </div>
</section>

{/* ---- Human proof (paper chapter) -------------------------------------- */}
<Testimonials locale={locale} />

<PersonalIntro locale={locale} />

{/* ---- Close ------------------------------------------------------------- */}
<FaqList title={tr.homeFaq.title} faq={tr.homeFaq.items} />

<CtaBand locale={locale} />

<style>
  /* ---- Work --------------------------------------------------------------- */
  .work__head { margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .work__all { white-space: nowrap; }

  .work__lead {
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--line);
  }
  .work__pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  /* ---- Services ----------------------------------------------------------- */
  .services__head { max-width: 54ch; }
  .services__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3.5vw, 3rem);
  }

  .services__why {
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: clamp(1.5rem, 3vw, 2.25rem);
    border-top: 1px solid var(--line);
  }
  .services__why-label {
    margin-bottom: 1.75rem;
  }
  .services__why-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }
  .services__why-title {
    font-size: 1rem;
    font-weight: var(--fw-medium);
    letter-spacing: -0.01em;
    margin: 0 0 0.4rem;
  }
  .services__why-text {
    color: var(--fg-dim);
    font-size: var(--fs-meta);
    line-height: 1.6;
    margin: 0;
  }

  /* ---- Benchmark ---------------------------------------------------------- */
  .bench-section__head {
    align-items: flex-start;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .bench-section__lead {
    max-width: 44ch;
    margin-top: 0;
  }

  /* ---- Responsive --------------------------------------------------------- */
  @media (max-width: 900px) {
    .services__grid { grid-template-columns: 1fr; }
    .services__why-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    .work__pair { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .services__why-list { grid-template-columns: 1fr; }
  }
</style>
