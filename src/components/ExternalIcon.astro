---
// The "leaves the site" mark: an arrow to the upper right, drawn in SVG so it
// follows the text colour and never falls back to a system font like the ↗
// glyph did. Decorative; the link text says where it goes.
interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---

<svg class:list={['ext-icon', cls]} viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" focusable="false">
  <path d="M3.5 2.5h6v6M9.5 2.5 2.5 9.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
</svg>

<style>
  .ext-icon {
    display: inline-block;
    width: 0.7em;
    height: 0.7em;
    margin-left: 0.3em;
    vertical-align: 0.05em;
    flex: none;
  }
</style>
