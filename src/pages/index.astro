---
import Layout from '../layouts/Layout.astro';
import HomeContent from '../components/pages/HomeContent.astro';
import { routes } from '../i18n/routes';
import { graph, personSchema, webSiteSchema, professionalServiceSchema, faqSchema } from '../lib/schema';
import { useTranslations } from '../i18n';

const locale = 'fr' as const;
const tr = useTranslations(locale);
const title = 'Patrick Laperrière · Développeur web bilingue';
const description =
  'Développeur web freelance bilingue. Je conçois des sites rapides, élégants et optimisés pour Google. Québec, Canada et États-Unis. Soumission gratuite.';

const schema = graph([
  personSchema(locale),
  webSiteSchema(locale),
  professionalServiceSchema(locale),
  faqSchema(tr.homeFaq.items),
]);
---

<Layout
  title={title}
  description={description}
  locale={locale}
  alternates={routes.home}
  schema={schema}
>
  <HomeContent locale={locale} />
</Layout>
