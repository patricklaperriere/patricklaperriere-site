---
import Layout from '../layouts/Layout.astro';
import HomeRefonte from '../components/refonte/HomeRefonte.astro';
import { routes } from '../i18n/routes';
import { graph, personSchema, webSiteSchema, professionalServiceSchema } from '../lib/schema';

const locale = 'fr' as const;
const title = 'Patrick Laperrière · Développeur web au Québec';
const description =
  'Développeur web au Québec : sites rapides et bien référencés, refontes, boutiques Shopify et outils sur mesure pour les PME, en français et en anglais.';

const schema = graph([personSchema(locale), webSiteSchema(locale), professionalServiceSchema(locale)]);
---

<Layout title={title} description={description} locale={locale} alternates={routes.home} schema={schema} theme="refonte" ogImage="/og/home-fr.png">
  <HomeRefonte locale={locale} />
</Layout>
