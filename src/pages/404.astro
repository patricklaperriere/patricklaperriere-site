---
import Layout from '../layouts/Layout.astro';
import { useTranslations, routes, path } from '../i18n';

const locale = 'fr' as const;
const tr = useTranslations(locale);
---

<Layout
  title="404 · Page introuvable | Patrick Laperrière"
  description={tr.notFound.lead}
  locale={locale}
  alternates={routes.home}
  noindex={true}
>
  <section class="nf container-pl">
    <p class="nf__code">404</p>
    <h1>{tr.notFound.title}</h1>
    <p class="nf__lead">{tr.notFound.lead}</p>
    <div class="nf__actions">
      <a href={path('home', 'fr')} class="btn btn-primary">{tr.notFound.back}</a>
      <a href={path('home', 'en')} class="btn btn-ghost">Back to home (EN)</a>
    </div>
  </section>

  <style>
    .nf {
      min-height: 56vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding-block: 5rem;
    }
    .nf__code {
      font-family: var(--font-display);
      font-size: clamp(4rem, 18vw, 11rem);
      line-height: 1;
      margin: 0;
      background: linear-gradient(135deg, var(--color-gold-bright), var(--color-gold) 60%, #c9a878);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .nf h1 { font-size: clamp(1.6rem, 4vw, 2.6rem); margin: 0.5rem 0 0.8rem; }
    .nf__lead { color: var(--color-fog); margin: 0 0 2rem; }
    .nf__actions { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; }
  </style>
</Layout>
