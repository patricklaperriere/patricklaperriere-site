---
import Layout from '../layouts/Layout.astro';
import { useTranslations, routes, path } from '../i18n';

const locale = 'fr' as const;
const tr = useTranslations(locale);
// The pages people most often look for, so a dead link is not a dead end.
const links = [
  { href: path('services', locale), label: tr.nav.services },
  { href: path('work', locale), label: tr.nav.work },
  { href: path('about', locale), label: tr.nav.about },
  { href: path('contact', locale), label: tr.nav.contact },
];
---

<Layout
  title={tr.notFound.seoTitle}
  description={tr.notFound.lead}
  locale={locale}
  alternates={routes.home}
  noindex={true}
>
  <section class="nf container-wide">
    <p class="label label-rule nf__code">404</p>
    <h1 class="nf__title">{tr.notFound.title}</h1>
    <p class="nf__lead">{tr.notFound.lead}</p>
    <ul class="nf__links">
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
    <div class="nf__actions">
      <a href={path('home', 'fr')} class="btn btn-accent">
        {tr.notFound.back}
        <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
      <a href={path('home', 'en')} class="btn btn-ghost" lang="en">{tr.notFound.other}</a>
    </div>
  </section>

  <style>
    /* Left-aligned and typographic, like every other close on the site. */
    .nf {
      min-height: 52vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-block: clamp(4rem, 12vh, 8rem);
    }
    .nf__title {
      font-size: clamp(2.2rem, 7vw, 4.5rem);
      font-weight: var(--fw-thin);
      letter-spacing: -0.035em;
      line-height: 1.02;
      margin: clamp(1.25rem, 3vw, 2rem) 0 0;
      max-width: 16ch;
    }
    .nf__lead {
      color: var(--fg-dim);
      font-size: var(--fs-lead);
      max-width: 48ch;
      margin: 1.25rem 0 0;
    }
    .nf__links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.5rem;
      margin: 1.5rem 0 0;
      padding: 0;
      list-style: none;
    }
    .nf__actions {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
      margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
    }
  </style>
</Layout>
