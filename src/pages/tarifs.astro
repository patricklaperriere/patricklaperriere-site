---
// Tarifs (FR seulement pour l'instant). Prix verrouillés par Patrick le 2026-11-13 :
// Express 495 $ (prix fixe), Démarrage dès 995 $, Croissance dès 2 495 $, Complet dès 4 495 $.
// Ne pas changer un prix sans son OK. Textes à faire approuver par Patrick.
// Page en noindex et hors du menu tant que Patrick ne l'a pas validée.
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { path } from '../i18n';

const locale = 'fr' as const;
const contact = path('contact', locale);

type Forfait = {
  nom: string;
  prix: string;
  apartir: boolean;
  pour: string;
  inclus: string[];
  bouton: string;
  vedette?: string;
};

const forfaits: Forfait[] = [
  {
    nom: 'Express',
    prix: '495',
    apartir: false,
    pour: 'Une page pour être trouvé et joint, prête demain.',
    inclus: [
      'Une page vitrine sur un modèle éprouvé, à votre nom, avec votre logo, vos couleurs et vos photos',
      'Livrée en 24 heures',
      'Formulaire de contact',
      'Une ronde de retouches incluse',
      'Une seule page : pas de pages de services ni de reprise d’un ancien site',
    ],
    bouton: 'Acheter maintenant',
    vedette: 'Prêt en 24 heures',
  },
  {
    nom: 'Démarrage',
    prix: '995',
    apartir: true,
    pour: 'Un vrai site, fait pour vous, pour bien commencer.',
    inclus: [
      'De 5 à 8 pages',
      'Design fait sur mesure, pensé d’abord pour le téléphone',
      'Formulaire de contact',
      'Les bases pour être trouvé sur Google',
      'Mise en ligne incluse',
    ],
    bouton: 'Demander une soumission',
  },
  {
    nom: 'Croissance',
    prix: '2 495',
    apartir: true,
    pour: 'Pour les entreprises qui veulent sortir dans les recherches de leur région.',
    inclus: [
      'De 15 à 25 pages',
      'Pages pour chaque service et chaque ville que vous desservez',
      'Votre site inscrit et suivi dans les outils de Google',
      'Reprise de votre ancien site sans perdre votre place dans Google',
      'En français et en anglais, si vous en avez besoin',
    ],
    bouton: 'Demander une soumission',
    vedette: 'Le plus populaire',
  },
  {
    nom: 'Complet',
    prix: '4 495',
    apartir: true,
    pour: 'Je m’occupe de tout, textes compris.',
    inclus: [
      'Tout ce qui est dans Croissance',
      'J’écris les textes de votre site',
      'Votre fiche d’entreprise Google créée ou remise à jour',
      'Suivi des résultats : appels, demandes, visites',
      'Pages et fonctions faites sur mesure pour votre métier',
    ],
    bouton: 'Demander une soumission',
  },
];

const crumbs = [
  { name: 'Accueil', url: path('home', locale) },
  { name: 'Tarifs', url: '/tarifs' },
];
---

<Layout
  title="Tarifs | Patrick Laperrière, création de sites web"
  description="Quatre forfaits pour un site web : Express à 495 $, Démarrage dès 995 $, Croissance dès 2 495 $, Complet dès 4 495 $."
  locale={locale}
  alternates={{ fr: '/tarifs', en: '/en' }}
  noindex={true}
>
  <Breadcrumb items={crumbs} />

  <section class="page-head container-wide">
    <h1>Tarifs</h1>
    <p class="lead">Quatre façons de travailler ensemble. Les prix sont avant taxes, en dollars canadiens.</p>
  </section>

  <section class="section-tight container-wide" aria-label="Forfaits">
    <ul class="tarifs">
      {forfaits.map((f) => (
        <li class:list={['tarif', { 'tarif--vedette': f.vedette }]}>
          {f.vedette && <p class="tarif__vedette">{f.vedette}</p>}
          <h2 class="tarif__nom">{f.nom}</h2>
          <p class="tarif__prix">
            {f.apartir && <span class="tarif__apartir">à partir de</span>}
            <span class="tarif__montant">{f.prix} $</span>
            {!f.apartir && <span class="tarif__apartir">prix fixe</span>}
          </p>
          <p class="tarif__pour">{f.pour}</p>
          <ul class="tarif__inclus">
            {f.inclus.map((i) => <li>{i}</li>)}
          </ul>
          <a href={contact} class:list={['btn', f.vedette ? 'btn-accent' : 'btn-ghost', 'tarif__btn']}>{f.bouton}</a>
        </li>
      ))}
    </ul>
    <p class="tarifs__note">
      Chaque site est fait sur mesure, ces prix sont des points de départ. Le prix précis vient après une conversation de 15 minutes, sans engagement.
    </p>
  </section>
</Layout>

<style>
  .tarifs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15.5rem), 1fr));
    gap: 1rem;
    align-items: start;
  }
  .tarif {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    border: 1px solid var(--line);
    border-radius: 2px;
    background: var(--ink-raised, transparent);
    min-width: 0;
  }
  /* Express et Croissance : même traitement, la carte monte et prend le mauve. */
  .tarif--vedette {
    border: 2px solid var(--mauve, var(--accent));
    background: var(--ink-high, var(--bg-raised));
  }
  @media (min-width: 62em) {
    .tarif--vedette {
      transform: translateY(-0.75rem);
    }
  }
  .tarif__vedette {
    align-self: flex-start;
    margin: 0;
    padding: 0.3rem 0.6rem;
    border-radius: 2px;
    background: var(--mauve, var(--accent));
    color: #fff;
    font-size: var(--fs-sm);
    font-weight: 700;
  }
  .tarif__nom {
    margin: 0;
    font-size: var(--fs-md);
  }
  .tarif__prix {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.5rem;
  }
  .tarif__montant {
    font-size: var(--fs-lg);
    font-weight: 800;
    line-height: 1;
  }
  .tarif__apartir {
    color: var(--fg-dim);
    font-size: var(--fs-sm);
  }
  .tarif__pour {
    margin: 0;
    color: var(--fg-dim);
  }
  .tarif__inclus {
    list-style: none;
    margin: 0;
    padding: 1rem 0 0;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 0.6rem;
    flex: 1;
  }
  .tarif__inclus li {
    position: relative;
    padding-left: 1.5rem;
    font-size: var(--fs-sm);
    line-height: 1.45;
  }
  .tarif__inclus li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 0.3em;
    width: 0.45rem;
    height: 0.8rem;
    border: solid var(--mauve-clair, var(--accent-fg));
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  .tarif__btn {
    margin-top: 0.5rem;
    width: 100%;
    justify-content: center;
    text-align: center;
  }
  .tarifs__note {
    margin: clamp(1.75rem, 4vw, 2.75rem) 0 0;
    max-width: 44rem;
    color: var(--fg-dim);
    font-size: var(--fs-lead);
  }
</style>
