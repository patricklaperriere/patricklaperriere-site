---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import BlogContent from '../components/pages/BlogContent.astro';
import { useTranslations, routes, path } from '../i18n';
import { postsFor, blogPostPath } from '../lib/blog';
import { graph, breadcrumbSchema, webSiteSchema, blogListSchema } from '../lib/schema';

const locale = 'fr' as const;
const tr = useTranslations(locale);
const b = tr.blog;

const all = await getCollection('blog');
const posts = postsFor(all, locale);

const schema = graph([
  webSiteSchema(locale),
  breadcrumbSchema([
    { name: tr.breadcrumb.home, url: path('home', locale) },
    { name: tr.nav.blog, url: path('blog', locale) },
  ]),
  blogListSchema(
    locale,
    posts.map((p) => ({
      title: p.data.title,
      description: p.data.description,
      url: blogPostPath(locale, p.data.slug),
      datePublished: p.data.pubDate.toISOString().slice(0, 10),
    })),
  ),
]);
---

<Layout pageType="CollectionPage" title={b.seoTitle} description={b.seoDesc} locale={locale} alternates={routes.blog} ogImage="/og/blog.png" schema={schema}>
  <BlogContent locale={locale} posts={posts} />
</Layout>
