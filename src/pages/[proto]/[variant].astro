---
// Home-page prototype, served at /_proto/scan under `astro dev` only. A
// production build generates no path here, and the component is imported only
// in dev, so not a byte of it (markup, CSS or its GSAP bundle) reaches dist/.
// (A folder named `_proto` would be ignored by Astro's router, hence the
// dynamic segments.) Prototype phase only: delete once a direction ships.
export function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  return [{ params: { proto: '_proto', variant: 'scan' } }];
}

const Scan = import.meta.env.DEV ? (await import('../../prototypes/scan/Scan.astro')).default : null;
---

{Scan && <Scan />}
