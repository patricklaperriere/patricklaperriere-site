---
import Layout from '../../layouts/Layout.astro';
import ServiceDetailContent from '../../components/pages/ServiceDetailContent.astro';
import { useTranslations, routes, path } from '../../i18n';
import { graph, breadcrumbSchema, faqSchema, professionalServiceSchema } from '../../lib/schema';

const locale = 'fr' as const;
const tr = useTranslations(locale);
const s = tr.services.web;

const schema = graph([
  breadcrumbSchema([
    { name: tr.breadcrumb.home, url: path('home', locale) },
    { name: tr.nav.services, url: path('services', locale) },
    { name: s.title, url: path('svcWeb', locale) },
  ]),
  faqSchema(s.faq),
  professionalServiceSchema(locale),
]);
---

<Layout title={s.seoTitle} description={s.seoDesc} locale={locale} alternates={routes.svcWeb} schema={schema}>
  <ServiceDetailContent locale={locale} service="web" />
</Layout>
