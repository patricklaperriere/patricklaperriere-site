---
import Layout from '../../layouts/Layout.astro';
import ServiceIndexContent from '../../components/pages/ServiceIndexContent.astro';
import { useTranslations, routes, path } from '../../i18n';
import { graph, breadcrumbSchema, professionalServiceSchema } from '../../lib/schema';

const locale = 'fr' as const;
const tr = useTranslations(locale);
const title = 'Services · sites web, SEO et Shopify | Patrick Laperrière';
const description =
  'Création de site web sur mesure, refonte et SEO, boutiques Shopify. Des services pensés pour la performance et la conversion. Québec, Canada et États-Unis.';

const schema = graph([
  breadcrumbSchema([
    { name: tr.breadcrumb.home, url: path('home', locale) },
    { name: tr.nav.services, url: path('services', locale) },
  ]),
  professionalServiceSchema(locale),
]);
---

<Layout title={title} description={description} locale={locale} alternates={routes.services} schema={schema}>
  <ServiceIndexContent locale={locale} />
</Layout>
