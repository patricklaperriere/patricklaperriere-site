---
import Layout from '../../layouts/Layout.astro';
import HomePage from '../../components/home/HomePage.astro';
import { routes } from '../../i18n/routes';
import { graph, personSchema, webSiteSchema, professionalServiceSchema } from '../../lib/schema';

const locale = 'en' as const;
const title = 'Patrick Laperrière · Web developer in Quebec, sites and tools';
const description =
  'Web developer in Quebec: fast websites that rank, redesigns, Shopify stores and custom tools for small businesses, and Habita, my inspection software.';

const schema = graph([personSchema(locale), webSiteSchema(locale), professionalServiceSchema(locale)]);
---

<Layout title={title} description={description} locale={locale} alternates={routes.home} schema={schema} theme="report">
  <HomePage locale={locale} />
</Layout>
