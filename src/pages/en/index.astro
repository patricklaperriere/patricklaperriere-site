---
import Layout from '../../layouts/Layout.astro';
import HomeContent from '../../components/pages/HomeContent.astro';
import { routes } from '../../i18n/routes';
import { graph, personSchema, webSiteSchema, professionalServiceSchema, faqSchema } from '../../lib/schema';
import { useTranslations } from '../../i18n';

const locale = 'en' as const;
const tr = useTranslations(locale);
const title = 'Patrick Laperrière · Bilingual Web Developer, Quebec & Canada';
const description =
  'Bilingual freelance web developer. I build fast, beautiful, SEO-optimized websites. Quebec, Canada and the United States. Free quote.';

const schema = graph([
  personSchema(locale),
  webSiteSchema(locale),
  professionalServiceSchema(locale),
  faqSchema(tr.homeFaq.items),
]);
---

<Layout
  title={title}
  description={description}
  locale={locale}
  alternates={routes.home}
  schema={schema}
>
  <HomeContent locale={locale} />
</Layout>
