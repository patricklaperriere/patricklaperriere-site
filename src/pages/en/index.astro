---
import Layout from '../../layouts/Layout.astro';
import HomePage from '../../components/home/HomePage.astro';
import { routes } from '../../i18n/routes';
import { graph, personSchema, webSiteSchema, professionalServiceSchema } from '../../lib/schema';

const locale = 'en' as const;
const title = 'Patrick Laperrière · Web developer in Quebec';
const description =
  'Fast, well-ranked websites, redesigns, Shopify stores and custom tools for small businesses in Quebec and beyond, in English and French.';

const schema = graph([personSchema(locale), webSiteSchema(locale), professionalServiceSchema(locale)]);
---

<Layout title={title} description={description} locale={locale} alternates={routes.home} schema={schema} ogImage="/og/home-en.png">
  <HomePage locale={locale} />
</Layout>
