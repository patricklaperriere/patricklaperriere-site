---
import Layout from '../../../layouts/Layout.astro';
import WorkIndexContent from '../../../components/pages/WorkIndexContent.astro';
import { useTranslations, routes, path } from '../../../i18n';
import { workBase } from '../../../i18n/routes';
import { sortedProjects, loc } from '../../../data/projets';
import { graph, breadcrumbSchema, itemListSchema } from '../../../lib/schema';

const locale = 'en' as const;
const tr = useTranslations(locale);
const title = 'Work and case studies | Patrick Laperrière';
const description =
  'Case studies: Habita, inspection software by Technologies Habita inc., custom Astro sites and Shopify stores, each with results you can check.';

const schema = graph([
  breadcrumbSchema([
    { name: tr.breadcrumb.home, url: path('home', locale) },
    { name: tr.nav.work, url: path('work', locale) },
  ]),
  itemListSchema(
    (await sortedProjects()).map((p) => ({
      name: loc(p.title, locale),
      url: `${workBase[locale]}/${p.slug}`,
    })),
  ),
]);
---

<Layout pageType="CollectionPage" title={title} description={description} locale={locale} alternates={routes.work} ogImage="/og/work.png" schema={schema}>
  <WorkIndexContent locale={locale} />
</Layout>
