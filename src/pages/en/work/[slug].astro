---
import Layout from '../../../layouts/Layout.astro';
import CaseStudyContent from '../../../components/pages/CaseStudyContent.astro';
import { useTranslations, path } from '../../../i18n';
import { workBase } from '../../../i18n/routes';
import { sortedProjects, loc } from '../../../data/projets';
import { graph, breadcrumbSchema, creativeWorkSchema, habitaAppSchema } from '../../../lib/schema';

// One page per project in src/content/projets. Drafts only exist under
// `astro dev` (see data/projets.ts) and are always noindex.
export async function getStaticPaths() {
  return (await sortedProjects()).map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const locale = 'en' as const;
const { project } = Astro.props;
const tr = useTranslations(locale);

const frPath = `${workBase.fr}/${project.slug}`;
const enPath = `${workBase.en}/${project.slug}`;
const alternates = { fr: frPath, en: enPath };
const ogImage = `/og/project-${project.slug}.png`;
const isHabita = project.slug === 'habita';

const title = `${loc(project.seoTitle, locale)} | Patrick Laperrière`;
const description = loc(project.description, locale);

const schema = graph([
  breadcrumbSchema([
    { name: tr.breadcrumb.home, url: path('home', locale) },
    { name: tr.nav.work, url: path('work', locale) },
    { name: loc(project.title, locale), url: enPath },
  ]),
  creativeWorkSchema({
    name: loc(project.title, locale),
    description,
    url: enPath,
    workUrl: project.url,
    image: ogImage,
    locale,
    client: project.client,
    year: project.year,
    keywords: project.stack,
    product: isHabita,
  }),
  ...(isHabita ? [habitaAppSchema({ url: project.url, description: loc(project.tagline, locale), locale })] : []),
]);
---

<Layout
  title={title}
  description={description}
  locale={locale}
  alternates={alternates}
  ogImage={ogImage}
  schema={schema}
  ogType="article"
  noindex={project.draft}
>
  <CaseStudyContent locale={locale} project={project} />
</Layout>
